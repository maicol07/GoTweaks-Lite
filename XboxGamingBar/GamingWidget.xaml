                                                <ColumnDefinition Width="100"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:Uid="S_Axis" Text="Axis" VerticalAlignment="Center" Foreground="#B9C0CC" FontSize="14" />

                                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                    <TextBlock x:Uid="S_CPUTemp" Text="CPU Temp:" FontSize="13" FontWeight="SemiBold" Foreground="#B9C0CC" VerticalAlignment="Center" Margin="0,0,4,0" />

<Page
    x:Class="XboxGamingBar.GamingWidget"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:XboxGamingBar"
    xmlns:converter="using:XboxGamingBar.Converter"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:ctk="using:CommunityToolkit.WinUI.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    d:DesignHeight="670" d:DesignWidth="600">

    <Page.Resources>
        <!-- Existing Converters -->
        <converter:WattStringConverter x:Key="WattStringConverter"/>
        <converter:MegahertzStringConverter x:Key="MegahertzStringConverter"/>
        <converter:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <converter:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter"/>
        <converter:SharpnessPercentStringConverter x:Key="SharpnessPercentStringConverter"/>
        <converter:RadeonBoostResolutionStringConverter x:Key="RadeonBoostResolutionStringConverter"/>

        <!-- System Accent Color Brush (Light2 variant for dark theme text) -->
        <SolidColorBrush x:Key="SystemAccentBrush" Color="{ThemeResource SystemAccentColorLight2}"/>

        <!-- Win11 Theme Colors (promoted app-wide 2026-07-11 from the Performance-tab
             pilot checkpoint; matches the already-shipped Quick Settings tile palette) -->
        <SolidColorBrush x:Key="PageBackgroundBrush" Color="#25282C"/>
        <SolidColorBrush x:Key="CardBackgroundBrush" Color="#35393F"/>
        <SolidColorBrush x:Key="CardBorderBrush" Color="#22FFFFFF"/>
        <SolidColorBrush x:Key="ButtonBackground" Color="#3E434B"/>
        <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#484E58"/>
        <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#3A3F47"/>
        <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="#2C3035"/>
        <SolidColorBrush x:Key="ButtonBorderBrush" Color="#22FFFFFF"/>
        <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#33FFFFFF"/>
        <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="#22FFFFFF"/>
        <SolidColorBrush x:Key="ButtonBorderBrushDisabled" Color="#14FFFFFF"/>
        <CornerRadius x:Key="ControlCornerRadius">8,8,8,8</CornerRadius>
        <Thickness x:Key="ButtonPadding">15,10,15,11</Thickness>

        <!-- Card Style - Win11 -->
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}"/>
        </Style>

        <!-- Card Focus Border Brush -->
        <SolidColorBrush x:Key="CardFocusBorderBrush" Color="White"/>

        <!-- Navigation RadioButton Style - Optimized for Handheld XY Navigation -->
        <!-- Uses RadioButtons group which treats tabs as single navigable unit -->
        <Style x:Key="NavRadioButtonStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#B9C0CC"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="MinWidth" Value="44"/>
            <Setter Property="MinHeight" Value="40"/>
            <Setter Property="Padding" Value="12,0,12,0"/>
            <Setter Property="Margin" Value="1,0,1,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="UseSystemFocusVisuals" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <!-- Segmented-style pill: Content is the tab icon, the label comes from
                         AutomationProperties.Name and is shown only on the checked tab. -->
                    <ControlTemplate TargetType="RadioButton">
                        <Grid x:Name="RootGrid" Background="Transparent">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal"/>
                                    <VisualState x:Name="PointerOver">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverOverlay" Storyboard.TargetProperty="Visibility">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="Visible"/>
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="RootGrid" Storyboard.TargetProperty="Opacity" To="0.7" Duration="0"/>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="RootGrid" Storyboard.TargetProperty="Opacity" To="0.4" Duration="0"/>
                                        </Storyboard>
                                    </VisualState>
                                </VisualStateGroup>
                                <VisualStateGroup x:Name="CheckStates">
                                    <VisualState x:Name="Checked">
                                        <!-- The accent pill itself is a sliding sibling (PillTabIndicator). -->
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Icon" Storyboard.TargetProperty="Foreground">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="#10161C"/>
                                            </ObjectAnimationUsingKeyFrames>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Label" Storyboard.TargetProperty="Visibility">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="Visible"/>
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Unchecked"/>
                                    <VisualState x:Name="Indeterminate"/>
                                </VisualStateGroup>
                                <VisualStateGroup x:Name="FocusStates">
                                    <VisualState x:Name="Focused">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="FocusBorder" Storyboard.TargetProperty="Visibility">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="Visible"/>
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Unfocused"/>
                                    <VisualState x:Name="PointerFocused"/>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <Border x:Name="Pill" Background="{TemplateBinding Background}" CornerRadius="20"/>
                            <Border x:Name="HoverOverlay" Background="#14FFFFFF" CornerRadius="20" Visibility="Collapsed"/>
                            <StackPanel Orientation="Horizontal" Spacing="6"
                                        Padding="{TemplateBinding Padding}"
                                        HorizontalAlignment="Center" VerticalAlignment="Center">
                                <ContentPresenter x:Name="Icon"
                                                  Content="{TemplateBinding Content}"
                                                  Foreground="{TemplateBinding Foreground}"
                                                  VerticalAlignment="Center"
                                                  AutomationProperties.AccessibilityView="Raw"/>
                                <TextBlock x:Name="Label"
                                           Text="{Binding Path=(AutomationProperties.Name), RelativeSource={RelativeSource Mode=TemplatedParent}}"
                                           Foreground="#10161C"
                                           VerticalAlignment="Center"
                                           Visibility="Collapsed"
                                           AutomationProperties.AccessibilityView="Raw"/>
                            </StackPanel>
                            <Border x:Name="FocusBorder" BorderBrush="White" BorderThickness="2" CornerRadius="20" Visibility="Collapsed"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Card Title Style - Win11 -->
        <Style x:Key="CardTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <!-- Card Title Style - Compact Mode -->
        <Style x:Key="CardTitleStyleCompact" TargetType="TextBlock" BasedOn="{StaticResource CardTitleStyle}">
            <Setter Property="FontSize" Value="20"/>
        </Style>

        <!-- Card Caption Style - Win11 -->
        <Style x:Key="CardCaptionStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#B9C0CC"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
        </Style>

        <!-- Card Caption Style - Compact Mode -->
        <Style x:Key="CardCaptionStyleCompact" TargetType="TextBlock" BasedOn="{StaticResource CardCaptionStyle}">
            <Setter Property="FontSize" Value="16"/>
        </Style>

        <!-- Card Value Style -->
        <Style x:Key="CardValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource SystemAccentBrush}"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Card Value Style - Compact Mode -->
        <Style x:Key="CardValueStyleCompact" TargetType="TextBlock" BasedOn="{StaticResource CardValueStyle}">
            <Setter Property="FontSize" Value="20"/>
        </Style>

        <!-- Modern Toggle Style - Uses system style, focus highlight on parent card -->
        <Style x:Key="ModernToggleStyle" TargetType="ToggleSwitch" BasedOn="{StaticResource DefaultToggleSwitchStyle}">
            <Setter Property="MinWidth" Value="40"/>
            <Setter Property="MaxWidth" Value="40"/>
            <Setter Property="MinHeight" Value="20"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="OffContent" Value=""/>
            <Setter Property="OnContent" Value=""/>
            <Setter Property="UseSystemFocusVisuals" Value="True"/>
            <Setter Property="FocusVisualPrimaryBrush" Value="White"/>
            <Setter Property="FocusVisualSecondaryBrush" Value="Transparent"/>
            <Setter Property="FocusVisualPrimaryThickness" Value="2"/>
            <Setter Property="FocusVisualMargin" Value="-3,-3,-3,-3"/>
        </Style>

        <!-- Modern Slider Style - Fluent with System Accent Color, focus on parent card -->
        <Style x:Key="ModernSliderStyle" TargetType="Slider" BasedOn="{StaticResource DefaultSliderStyle}">
            <Setter Property="Margin" Value="0,4,0,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="ManipulationMode" Value="None"/>
            <Setter Property="IsFocusEngagementEnabled" Value="True"/>
            <!-- High-visibility white focus ring for gamepad navigation (matches ModernToggleStyle) -->
            <Setter Property="UseSystemFocusVisuals" Value="True"/>
            <Setter Property="FocusVisualPrimaryBrush" Value="White"/>
            <Setter Property="FocusVisualSecondaryBrush" Value="Transparent"/>
            <Setter Property="FocusVisualPrimaryThickness" Value="2"/>
            <Setter Property="FocusVisualMargin" Value="-3,-3,-3,-3"/>
        </Style>

        <!-- Modern ComboBox Style - System style with minor customizations -->
        <Style x:Key="ModernComboBoxStyle" TargetType="ComboBox" BasedOn="{StaticResource DefaultComboBoxStyle}">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <!-- High-visibility white focus ring for gamepad navigation -->
            <Setter Property="UseSystemFocusVisuals" Value="True"/>
            <Setter Property="FocusVisualPrimaryBrush" Value="White"/>
            <Setter Property="FocusVisualSecondaryBrush" Value="Transparent"/>
            <Setter Property="FocusVisualPrimaryThickness" Value="2"/>
            <Setter Property="FocusVisualMargin" Value="-3,-3,-3,-3"/>
        </Style>

        <!-- Override ComboBox border colors to prevent highlight on focus/hover -->
        <SolidColorBrush x:Key="ComboBoxBorderBrushPointerOver" Color="#33FFFFFF"/>
        <SolidColorBrush x:Key="ComboBoxBorderBrushPressed" Color="#33FFFFFF"/>
        <SolidColorBrush x:Key="ComboBoxBorderBrushFocused" Color="#33FFFFFF"/>
        <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="#35393F"/>
        <SolidColorBrush x:Key="ComboBoxBackgroundPressed" Color="#35393F"/>
        <SolidColorBrush x:Key="ComboBoxBackgroundFocused" Color="#35393F"/>


        <!-- Reusable high-visibility white focus-ring setters for gamepad navigation.
             Merged into the interactive-control styles below so every button/toggle/checkbox
             shows the same clear white ring when focused with the pad. -->

        <!-- Modern Button Style - System style -->
        <Style x:Key="ModernButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="UseSystemFocusVisuals" Value="True"/>
            <Setter Property="FocusVisualPrimaryBrush" Value="White"/>
            <Setter Property="FocusVisualSecondaryBrush" Value="Transparent"/>
            <Setter Property="FocusVisualPrimaryThickness" Value="2"/>
            <Setter Property="FocusVisualMargin" Value="-3,-3,-3,-3"/>
        </Style>

        <!-- Standalone Button Style - System style -->
        <Style x:Key="StandaloneButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="UseSystemFocusVisuals" Value="True"/>
            <Setter Property="FocusVisualPrimaryBrush" Value="White"/>
            <Setter Property="FocusVisualSecondaryBrush" Value="Transparent"/>
            <Setter Property="FocusVisualPrimaryThickness" Value="2"/>
            <Setter Property="FocusVisualMargin" Value="-3,-3,-3,-3"/>
        </Style>

        <!-- Standalone ToggleButton Style - System style -->
        <Style x:Key="StandaloneToggleButtonStyle" TargetType="ToggleButton" BasedOn="{StaticResource DefaultToggleButtonStyle}">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="UseSystemFocusVisuals" Value="True"/>
            <Setter Property="FocusVisualPrimaryBrush" Value="White"/>
            <Setter Property="FocusVisualSecondaryBrush" Value="Transparent"/>
            <Setter Property="FocusVisualPrimaryThickness" Value="2"/>
            <Setter Property="FocusVisualMargin" Value="-3,-3,-3,-3"/>
        </Style>

        <!-- Scale button (Scaling tab): accent-colored fill with dark text for contrast, in
             every state (idle and checked alike - no more accent-vs-gray distinction between
             them). Full custom template (not just resource overrides) so this stays scoped to
             this one control instead of affecting every other ToggleButton in the app (the
             many small expand/collapse chevron toggles). Disabled while there are unsaved
             Scale-tab setting changes pending Apply-and-Restart - see
             GamingWidget.LosslessScaling.cs's dirty-tracking. -->
        <Style x:Key="ScaleToggleButtonStyle" TargetType="ToggleButton">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="{StaticResource ButtonPadding}"/>
            <Setter Property="Background" Value="{StaticResource SystemAccentBrush}"/>
            <Setter Property="Foreground" Value="#1A1A1A"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="UseSystemFocusVisuals" Value="True"/>
            <Setter Property="FocusVisualPrimaryBrush" Value="White"/>
            <Setter Property="FocusVisualSecondaryBrush" Value="Transparent"/>
            <Setter Property="FocusVisualPrimaryThickness" Value="2"/>
            <Setter Property="FocusVisualMargin" Value="-3,-3,-3,-3"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="RootBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="{StaticResource ControlCornerRadius}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                BorderBrush="{TemplateBinding BorderBrush}">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal"/>
                                    <VisualState x:Name="PointerOver">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="RootBorder" Storyboard.TargetProperty="Opacity" To="0.85" Duration="0"/>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="RootBorder" Storyboard.TargetProperty="Opacity" To="0.7" Duration="0"/>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RootBorder" Storyboard.TargetProperty="Background">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource ButtonBackgroundDisabled}"/>
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Checked"/>
                                    <VisualState x:Name="CheckedPointerOver">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="RootBorder" Storyboard.TargetProperty="Opacity" To="0.85" Duration="0"/>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="CheckedPressed">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="RootBorder" Storyboard.TargetProperty="Opacity" To="0.7" Duration="0"/>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="CheckedDisabled">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RootBorder" Storyboard.TargetProperty="Background">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource ButtonBackgroundDisabled}"/>
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <ContentPresenter x:Name="ContentPresenter"
                                              Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              Foreground="{TemplateBinding Foreground}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              Padding="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Apply and Restart button (Scaling tab): default StandaloneButtonStyle look while
             disabled (no pending changes), but a custom template so that while it's enabled
             (green - see GamingWidget.LosslessScaling.cs's dirty-tracking) hovering/pressing
             darkens via opacity like the Scale button, instead of the system default template's
             PointerOver/Pressed VisualStates swapping to their own gray ButtonBackgroundPointerOver/
             Pressed resources (which would flash the green back to gray on hover, overriding
             whatever code-behind just set .Background to). Background/Foreground are driven
             entirely from code-behind (UpdateLosslessScalingDirtyState) - the Disabled VisualState
             here restores the normal disabled look regardless of what code-behind last set. -->
        <Style x:Key="LosslessScalingApplyButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="UseSystemFocusVisuals" Value="True"/>
            <Setter Property="FocusVisualPrimaryBrush" Value="White"/>
            <Setter Property="FocusVisualSecondaryBrush" Value="Transparent"/>
            <Setter Property="FocusVisualPrimaryThickness" Value="2"/>
            <Setter Property="FocusVisualMargin" Value="-3,-3,-3,-3"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="RootBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="{StaticResource ControlCornerRadius}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                BorderBrush="{TemplateBinding BorderBrush}">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal"/>
                                    <VisualState x:Name="PointerOver">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="RootBorder" Storyboard.TargetProperty="Opacity" To="0.85" Duration="0"/>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="RootBorder" Storyboard.TargetProperty="Opacity" To="0.7" Duration="0"/>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RootBorder" Storyboard.TargetProperty="Background">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource ButtonBackgroundDisabled}"/>
                                            </ObjectAnimationUsingKeyFrames>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPresenter" Storyboard.TargetProperty="Foreground">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource ButtonForegroundDisabled}"/>
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <ContentPresenter x:Name="ContentPresenter"
                                              Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              Foreground="{TemplateBinding Foreground}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              Padding="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Checkbox with system style -->
        <Style x:Key="FocusableCheckBoxStyle" TargetType="CheckBox" BasedOn="{StaticResource DefaultCheckBoxStyle}">
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="UseSystemFocusVisuals" Value="True"/>
            <Setter Property="FocusVisualPrimaryBrush" Value="White"/>
            <Setter Property="FocusVisualSecondaryBrush" Value="Transparent"/>
            <Setter Property="FocusVisualPrimaryThickness" Value="2"/>
            <Setter Property="FocusVisualMargin" Value="-3,-3,-3,-3"/>
        </Style>

        <!-- Default Button Style Override - uses system style -->
        <Style TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="UseSystemFocusVisuals" Value="True"/>
            <Setter Property="FocusVisualPrimaryBrush" Value="White"/>
            <Setter Property="FocusVisualSecondaryBrush" Value="Transparent"/>
            <Setter Property="FocusVisualPrimaryThickness" Value="2"/>
            <Setter Property="FocusVisualMargin" Value="-3,-3,-3,-3"/>
        </Style>

        <!-- Default ToggleButton Style Override - uses system style -->
        <Style TargetType="ToggleButton" BasedOn="{StaticResource DefaultToggleButtonStyle}">
            <Setter Property="UseSystemFocusVisuals" Value="True"/>
            <Setter Property="FocusVisualPrimaryBrush" Value="White"/>
            <Setter Property="FocusVisualSecondaryBrush" Value="Transparent"/>
            <Setter Property="FocusVisualPrimaryThickness" Value="2"/>
            <Setter Property="FocusVisualMargin" Value="-3,-3,-3,-3"/>
        </Style>

        <!-- Default CheckBox Style Override - uses system style -->
        <Style TargetType="CheckBox" BasedOn="{StaticResource DefaultCheckBoxStyle}">
            <Setter Property="UseSystemFocusVisuals" Value="True"/>
            <Setter Property="FocusVisualPrimaryBrush" Value="White"/>
            <Setter Property="FocusVisualSecondaryBrush" Value="Transparent"/>
            <Setter Property="FocusVisualPrimaryThickness" Value="2"/>
            <Setter Property="FocusVisualMargin" Value="-3,-3,-3,-3"/>
        </Style>

        <!-- Implicit Slider style: sliders without an explicit style still require A
             to engage before the D-pad changes their value. -->
        <Style TargetType="Slider" BasedOn="{StaticResource DefaultSliderStyle}">
            <Setter Property="IsFocusEngagementEnabled" Value="True"/>
            <Setter Property="UseSystemFocusVisuals" Value="True"/>
            <Setter Property="FocusVisualPrimaryBrush" Value="White"/>
            <Setter Property="FocusVisualSecondaryBrush" Value="Transparent"/>
            <Setter Property="FocusVisualPrimaryThickness" Value="2"/>
            <Setter Property="FocusVisualMargin" Value="-3,-3,-3,-3"/>
        </Style>

        <!-- Gamepad key chips (nav bar LT/RT and the bottom command bar) -->
        <Style x:Key="GamepadKeyHintStyle" TargetType="Border">
            <Setter Property="Background" Value="#45494F"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="MinWidth" Value="24"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="Padding" Value="6,0,6,0"/>
        </Style>
        <Style x:Key="GamepadKeyHintTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="CommandHintLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#B9C0CC"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="5,0,0,0"/>
        </Style>

        <!-- Settings look (Windows Settings style). Page-level overrides of the toolkit/WinUI
             theme brushes so SettingsCard/SettingsExpander/Expander match the widget palette. -->
        <SolidColorBrush x:Key="SettingsCardBackground" Color="#35393F"/>
        <SolidColorBrush x:Key="SettingsCardBackgroundPointerOver" Color="#3C4047"/>
        <SolidColorBrush x:Key="SettingsCardBackgroundPressed" Color="#32363C"/>
        <SolidColorBrush x:Key="SettingsCardBackgroundDisabled" Color="#2C3035"/>
        <SolidColorBrush x:Key="SettingsCardBorderBrush" Color="#14FFFFFF"/>
        <SolidColorBrush x:Key="SettingsCardBorderBrushPointerOver" Color="#22FFFFFF"/>
        <SolidColorBrush x:Key="ExpanderHeaderBackground" Color="#35393F"/>
        <SolidColorBrush x:Key="ExpanderContentBackground" Color="#2F3338"/>
        <SolidColorBrush x:Key="ExpanderHeaderBorderBrush" Color="#14FFFFFF"/>
        <SolidColorBrush x:Key="ExpanderContentBorderBrush" Color="#14FFFFFF"/>

        <!-- Collapsible group (header row + content). -->
        <Style x:Key="GroupExpanderStyle" TargetType="ctk:SettingsExpander">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <!-- Standalone settings row (own card background), as in Windows Settings. -->
        <Style x:Key="RowCardStyle" TargetType="ctk:SettingsCard">
            <Setter Property="Background" Value="#35393F"/>
            <Setter Property="BorderBrush" Value="#14FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="MinHeight" Value="64"/>
            <Setter Property="Padding" Value="16,10,16,10"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
        </Style>

        <!-- Group of rows in one card (no padding; rows and dividers span the card). -->
        <Style x:Key="GroupCardStyle" TargetType="Border">
            <Setter Property="Background" Value="#35393F"/>
            <Setter Property="BorderBrush" Value="#14FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style x:Key="GroupDividerStyle" TargetType="Border">
            <Setter Property="Height" Value="1"/>
            <Setter Property="Background" Value="#14FFFFFF"/>
        </Style>
        <!-- Row inside a group card: transparent, full-row touch target with icon. -->
        <Style x:Key="GroupRowStyle" TargetType="ctk:SettingsCard">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="MinHeight" Value="60"/>
            <Setter Property="Padding" Value="16,10,16,10"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
        </Style>

        <!-- Header row of a collapsible card (inside CardStyle padding). -->
        <Style x:Key="HeaderRowStyle" TargetType="ctk:SettingsCard">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="MinHeight" Value="52"/>
            <Setter Property="Padding" Value="4,2,0,2"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
        </Style>

        <!-- Section title above a group of rows (14 px SemiBold, like Windows Settings). -->
        <Style x:Key="SettingsSectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Margin" Value="2,18,0,6"/>
        </Style>

        <!-- Settings rows inside existing cards: transparent, at least 56 px tall so the whole
             row is a comfortable touch target. -->
        <Style TargetType="ctk:SettingsCard">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="4,6,4,6"/>
            <Setter Property="MinHeight" Value="56"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
        </Style>

        <!-- Segmented items at touch size -->
        <Style TargetType="ctk:SegmentedItem">
            <Setter Property="MinHeight" Value="40"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <!-- Section Header Style - Win11 -->
        <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Margin" Value="2,18,0,6"/>
        </Style>

        <!-- Quick Settings Tile Colors - Dark mode with sharp contrast -->
        <SolidColorBrush x:Key="TileOffBackground" Color="#1A1C1E"/>
        <SolidColorBrush x:Key="TileOnBackground" Color="#1A2E1F"/>
        <SolidColorBrush x:Key="TileActiveBackground" Color="#1A2530"/>
        <SolidColorBrush x:Key="TileTriggerBackground" Color="#252030"/>
        <SolidColorBrush x:Key="TileBorderBrush" Color="Transparent"/>
        <SolidColorBrush x:Key="TileFocusBorderBrush" Color="White"/>
        <!-- Inactive state: even darker -->
        <SolidColorBrush x:Key="TileInactiveBackground" Color="#0D0E0F"/>
        <SolidColorBrush x:Key="TileInactiveForeground" Color="#606060"/>

        <!-- Quick Settings Tile Style - Xbox Game Bar Widget UI Guidelines -->
        <!-- Rest: normal background, Focus: rest + white stroke, Press: 10% darker, Focus+Press: press + stroke, Inactive: 50% darker -->
        <Style x:Key="QuickSettingsTileStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource TileOffBackground}"/>
            <Setter Property="BorderBrush" Value="#22FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="MinWidth" Value="60"/>
            <Setter Property="MinHeight" Value="72"/>
            <Setter Property="UseSystemFocusVisuals" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal"/>
                                    <VisualState x:Name="PointerOver"/>
                                    <VisualState x:Name="Pressed">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="PressedOverlay" Storyboard.TargetProperty="Visibility">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="Visible"/>
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="InactiveOverlay" Storyboard.TargetProperty="Visibility">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="Visible"/>
                                            </ObjectAnimationUsingKeyFrames>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPresenter" Storyboard.TargetProperty="Foreground">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource TileInactiveForeground}"/>
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                </VisualStateGroup>
                                <VisualStateGroup x:Name="FocusStates">
                                    <VisualState x:Name="Focused">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="FocusBorder" Storyboard.TargetProperty="Visibility">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="Visible"/>
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Unfocused"/>
                                    <VisualState x:Name="PointerFocused"/>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>

                            <!-- Background with a faint, constant Win11-style hairline
                                 border (same on every tile, doesn't change with state) -->
                            <Border x:Name="BackgroundBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="12"/>

                            <!-- Pressed overlay (10% darker) -->
                            <Border x:Name="PressedOverlay"
                                    Background="#1A000000"
                                    CornerRadius="12"
                                    Visibility="Collapsed"/>

                            <!-- Inactive overlay (50% darker) -->
                            <Border x:Name="InactiveOverlay"
                                    Background="#80000000"
                                    CornerRadius="12"
                                    Visibility="Collapsed"/>

                            <!-- Focus stroke border -->
                            <Border x:Name="FocusBorder"
                                    BorderBrush="White"
                                    BorderThickness="2"
                                    CornerRadius="12"
                                    Visibility="Collapsed"/>

                            <!-- Content -->
                            <ContentPresenter x:Name="ContentPresenter"
                                              Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              Padding="{TemplateBinding Padding}"
                                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Quick Settings Edit Mode Checkbox Style -->
        <Style x:Key="TileVisibilityCheckBoxStyle" TargetType="CheckBox" BasedOn="{StaticResource DefaultCheckBoxStyle}">
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

    </Page.Resources>

    <Grid Background="{StaticResource PageBackgroundBrush}">
        <ProgressRing x:Name="LoadingProgressRing"
                      IsActive="True"
                      Visibility="Collapsed"
                      Width="60"
                      Height="60"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"/>

        <!-- Navigation Bar using RadioButtons for proper XY focus navigation -->
        <Grid x:Name="MainNavContainer">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Nav Bar Row -->
            <Grid Grid.Row="0" Background="Transparent" Margin="8,6,8,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- LT indicator -->
                <Border Grid.Column="0" Style="{StaticResource GamepadKeyHintStyle}" Margin="0,0,6,0" VerticalAlignment="Center">
                    <TextBlock Text="LT" Style="{StaticResource GamepadKeyHintTextStyle}"/>
                </Border>

                <!-- Navigation Tabs - StackPanel for proper horizontal XY navigation -->
                <!-- XYFocusKeyboardNavigation="Disabled" prevents vertical nav within, allows left/right -->
                <Grid Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border x:Name="MainNavPill" Background="{StaticResource SystemAccentBrush}" CornerRadius="20"
                        Height="40" Width="0" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <Border.RenderTransform><TranslateTransform x:Name="MainNavPillTransform"/></Border.RenderTransform>
                </Border>
                <StackPanel x:Name="MainNavPanel"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            XYFocusKeyboardNavigation="Disabled">
                    <RadioButton x:Name="QuickNavItem" x:Uid="QuickNavItem" AutomationProperties.Name="Quick" Tag="Quick" Style="{StaticResource NavRadioButtonStyle}" GroupName="MainNav" Checked="NavRadioButton_Checked"><FontIcon Glyph="&#xE80A;" FontSize="18"/></RadioButton>
                    <RadioButton x:Name="PerformanceNavItem" x:Uid="PerformanceNavItem" AutomationProperties.Name="Performance" Tag="Performance" Style="{StaticResource NavRadioButtonStyle}" GroupName="MainNav" Checked="NavRadioButton_Checked"><FontIcon Glyph="&#xEC4A;" FontSize="18"/></RadioButton>
                    <RadioButton x:Name="ProfilesNavItem" x:Uid="ProfilesNavItem" AutomationProperties.Name="Profiles" Tag="Game" Style="{StaticResource NavRadioButtonStyle}" GroupName="MainNav" Checked="NavRadioButton_Checked"><FontIcon Glyph="&#xE7FC;" FontSize="18"/></RadioButton>
                    <RadioButton x:Name="LegionNavItem" x:Uid="LegionNavItem" AutomationProperties.Name="Legion" Tag="Legion" Style="{StaticResource NavRadioButtonStyle}" GroupName="MainNav" Visibility="Collapsed" Checked="NavRadioButton_Checked"><FontIcon Glyph="&#xE772;" FontSize="18"/></RadioButton>
                    <RadioButton x:Name="GPDNavItem" x:Uid="GPDNavItem" AutomationProperties.Name="GPD" Tag="GPD" Style="{StaticResource NavRadioButtonStyle}" GroupName="MainNav" Visibility="Collapsed" Checked="NavRadioButton_Checked"><FontIcon Glyph="&#xE7F8;" FontSize="18"/></RadioButton>
                    <RadioButton x:Name="SystemNavItem" x:Uid="SystemNavItem" AutomationProperties.Name="System" Tag="System" Style="{StaticResource NavRadioButtonStyle}" GroupName="MainNav" Checked="NavRadioButton_Checked"><FontIcon Glyph="&#xE713;" FontSize="18"/></RadioButton>
                </StackPanel>
                </Grid>

                <!-- RT indicator and status dot -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Spacing="4">
                    <Border Style="{StaticResource GamepadKeyHintStyle}" Margin="6,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="RT" Style="{StaticResource GamepadKeyHintTextStyle}"/>
                    </Border>
                    <!-- Helper Connection Status Indicator (40 px touch target) -->
                    <Border x:Name="HelperStatusIndicator"
                            x:Uid="HelperStatusIndicator"
                            Background="Transparent"
                            CornerRadius="20"
                            MinWidth="40"
                            MinHeight="40"
                            Padding="15,0,15,0"
                            Margin="0,0,0,0"
                            VerticalAlignment="Center"
                            ToolTipService.ToolTip="Helper Status"
                            Tapped="HelperStatusIndicator_Tapped">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <Ellipse x:Name="HelperStatusDot"
                                     Width="10" Height="10"
                                     Fill="#FF5555"
                                     VerticalAlignment="Center"/>
                            <TextBlock x:Uid="HelperStatusText" x:Name="HelperStatusText"
                                       Text="Disconnected"
                                       Foreground="#B9C0CC"
                                       FontSize="13"
                                       VerticalAlignment="Center"
                                       Visibility="Collapsed" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- Content Area -->
            <Grid Grid.Row="1">
            <!-- QUICK SETTINGS TAB -->
            <Grid>
                <ScrollViewer x:Name="QuickSettingsScrollViewer" VerticalScrollBarVisibility="Auto" Visibility="Visible"
                              BringIntoViewOnFocusChange="True">
                    <StackPanel Padding="16,8,16,16">

                        <!-- Driver updates (Legion only, visible when count > 0): View jumps to the
                             Legion tab's Device section. -->
                        <muxc:InfoBar x:Name="QuickDriverUpdatesTile"
                                      Visibility="Collapsed"
                                      IsOpen="True"
                                      IsClosable="False"
                                      Severity="Warning"
                                      Margin="0,0,0,8">
                            <muxc:InfoBar.Content>
                                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,12">
                                    <Border Background="#FFB060" CornerRadius="11" MinWidth="22" Height="22" Padding="6,0" VerticalAlignment="Center">
                                        <TextBlock x:Name="QuickDriverUpdatesCountText" Text="0" FontSize="12" FontWeight="Bold" Foreground="#1A1A1A"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock x:Uid="QuickDriverUpdatesTitleText" x:Name="QuickDriverUpdatesTitleText" Text="Driver updates available"
                                               FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                </StackPanel>
                            </muxc:InfoBar.Content>
                            <muxc:InfoBar.ActionButton>
                                <Button x:Uid="S_QuickDriverUpdatesView" Content="View" Click="QuickDriverUpdatesTile_Click"/>
                            </muxc:InfoBar.ActionButton>
                        </muxc:InfoBar>

                        <!-- GoTweaks self-update: Install asks the helper to download and install the
                             signed bundle. Hidden when there is no update or the banner is turned off. -->
                        <muxc:InfoBar x:Name="QuickGoTweaksUpdateTile"
                                      Visibility="Collapsed"
                                      IsOpen="True"
                                      IsClosable="False"
                                      Severity="Informational"
                                      Margin="0,0,0,8">
                            <muxc:InfoBar.Content>
                                <StackPanel Margin="0,0,0,12">
                                    <TextBlock x:Uid="QuickGoTweaksTitleText" x:Name="QuickGoTweaksTitleText" Text="GoTweaks Lite update available"
                                               FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                    <TextBlock x:Uid="QuickGoTweaksSubtitleText" x:Name="QuickGoTweaksSubtitleText" Text="Tap to install"
                                               FontSize="12" Foreground="#B9C0CC" TextWrapping="Wrap"/>
                                </StackPanel>
                            </muxc:InfoBar.Content>
                            <muxc:InfoBar.ActionButton>
                                <Button x:Uid="S_QuickGoTweaksInstall" Content="Install" Click="QuickGoTweaksUpdateTile_Click"/>
                            </muxc:InfoBar.ActionButton>
                        </muxc:InfoBar>

                        <!-- Quick Metrics Row (compact stats display - dynamically populated) -->
                        <Border x:Name="QuickMetricsRow"
                                Background="#35393F"
                                CornerRadius="12"
                                Padding="4,9"
                                Margin="0,0,0,8"
                                BorderBrush="#22FFFFFF"
                                BorderThickness="1"
                                Visibility="Collapsed">
                            <!-- Dynamic metrics grid - populated in code-behind -->
                            <Grid x:Name="QuickMetricsGrid"/>
                        </Border>

                        <!-- Optional Built-in Display Brightness slider (hidden by default; -->
                        <!-- revealed under Customize. Sits under the metrics row, or in its -->
                        <!-- place when metrics are hidden. Background matches the metrics row; -->
                        <!-- the slider itself uses the active system accent color by default. -->
                        <Border x:Name="PanelBrightnessRow"
                                Background="#35393F"
                                CornerRadius="12"
                                Padding="12,8"
                                Margin="0,0,0,8"
                                BorderBrush="#22FFFFFF"
                                BorderThickness="1"
                                Visibility="Collapsed">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <FontIcon Grid.Column="0"
                                          Glyph="&#xE706;"
                                          FontSize="16"
                                          Foreground="#FFFFFF"
                                          Margin="0,0,10,0"
                                          VerticalAlignment="Center"/>
                                <Slider x:Name="PanelBrightnessSlider"
                                        Grid.Column="1"
                                        Style="{StaticResource ModernSliderStyle}"
                                        Minimum="0"
                                        Maximum="100"
                                        StepFrequency="1"
                                        VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- Dynamic Tiles Container - tiles generated in code-behind -->
                        <StackPanel x:Name="QuickSettingsTilesContainer"/>

                        <ctk:SettingsExpander Margin="0,12,0,0" Style="{StaticResource GroupExpanderStyle}">
                            <ctk:SettingsExpander.HeaderIcon><FontIcon Glyph="&#xEA5F;"/></ctk:SettingsExpander.HeaderIcon>
                            <ctk:SettingsExpander.Header>
                                <TextBlock x:Uid="S_LosslessScaling" Text="Lossless Scaling"/>
                            </ctk:SettingsExpander.Header>
                            <ctk:SettingsExpander.Description>
                                <TextBlock x:Uid="LosslessProfilesStatus" x:Name="LosslessProfilesStatus" Text="Load profiles to edit scaling settings." TextWrapping="Wrap"/>
                            </ctk:SettingsExpander.Description>
                            <Button x:Uid="S_ToggleScaling" Content="Toggle scaling" Click="ToggleLosslessScaling_Click" />
                            <ctk:SettingsExpander.ItemsHeader>
                                <StackPanel Spacing="8" Padding="16,12,16,12">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button x:Uid="S_OpenApp" Content="Open app" Click="OpenLosslessApp_Click" />
                                        <Button x:Uid="LoadLosslessProfilesButton" x:Name="LoadLosslessProfilesButton" Content="Load profiles" Click="LoadLosslessProfiles_Click" />
                                    </StackPanel>
                                    <ComboBox x:Uid="LosslessProfileSelector" x:Name="LosslessProfileSelector" Header="Profile" HorizontalAlignment="Stretch"
                                              Visibility="Collapsed" SelectionChanged="LosslessProfileSelector_SelectionChanged" />
                                    <StackPanel x:Name="LosslessProfileFields" Spacing="8"/>
                                    <Button x:Uid="SaveLosslessProfileButton" x:Name="SaveLosslessProfileButton" Content="Save profile" Visibility="Collapsed"
                                            Click="SaveLosslessProfile_Click" />
                                </StackPanel>
                            </ctk:SettingsExpander.ItemsHeader>
                        </ctk:SettingsExpander>

                        <!-- Customize Button -->
                        <Button x:Uid="QuickSettingsCustomizeButton" x:Name="QuickSettingsCustomizeButton"
                                Content="Customize"
                                HorizontalAlignment="Stretch"
                                Margin="0,16,0,0"
                                Style="{StaticResource StandaloneButtonStyle}"
                                Click="QuickSettingsCustomize_Click" />

                        <!-- Customization Panel (hidden by default) -->
                        <Border x:Name="QuickSettingsCustomizePanel"
                                Style="{StaticResource CardStyle}"
                                Visibility="Collapsed"
                                Margin="0,8,0,0">
                            <StackPanel>
                                <TextBlock x:Uid="S_CustomizeTiles" Text="Customize Tiles" Style="{StaticResource CardTitleStyle}" />
                                <TextBlock x:Uid="S_TapTileToSelectTap" Text="Tap tile to select, tap another to swap. Tap same tile to toggle visibility."
                                           Style="{StaticResource CardCaptionStyle}"
                                           Margin="0,0,0,8"
                                           TextWrapping="Wrap" />

                                <!-- Column Count Toggle -->
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Uid="S_Columns" Text="Columns:"
                                               VerticalAlignment="Center"
                                               Foreground="#B9C0CC"
                                               FontSize="14" />
                                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                                        <Button x:Name="Column3Button"
                                                Content="3"
                                                MinWidth="40"
                                                Margin="0,0,4,0"
                                                Click="ColumnCount3_Click"/>
                                        <Button x:Name="Column4Button"
                                                Content="4"
                                                MinWidth="40"
                                                Margin="0,0,4,0"
                                                Click="ColumnCount4_Click"/>
                                        <Button x:Name="Column5Button"
                                                Content="5"
                                                MinWidth="40"
                                                Click="ColumnCount5_Click"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Show Metrics Row Toggle -->
                                <ctk:SettingsCard x:Uid="S_ShowMetricsRow" Margin="0,0,0,8" Header="Show Metrics Row" Description="Select up to 6 metrics below" Tapped="ToggleRow_Tapped">
                                    <ctk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE9D2;"/></ctk:SettingsCard.HeaderIcon>
                                    <ToggleSwitch x:Name="QuickMetricsToggle"
                                    OffContent=""
                                    OnContent=""
                                    Toggled="QuickMetricsToggle_Toggled"/>
                                </ctk:SettingsCard>

                                <!-- Show Brightness Slider Toggle -->
                                <ctk:SettingsCard x:Uid="S_ShowBrightnessSlider" Margin="0,0,0,8" Header="Show Brightness Slider" Description="Built-in screen brightness" Tapped="ToggleRow_Tapped">
                                    <ctk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE706;"/></ctk:SettingsCard.HeaderIcon>
                                    <ToggleSwitch x:Name="PanelBrightnessToggle"
                                    OffContent=""
                                    OnContent=""
                                    Toggled="PanelBrightnessToggle_Toggled"/>
                                </ctk:SettingsCard>

                                <!-- Metrics Selection (visible when toggle is on) -->
                                <Border x:Name="MetricsSelectionPanel"
                                        Background="#1A1A2E"
                                        CornerRadius="4"
                                        Padding="10"
                                        Margin="0,0,0,12"
                                        Visibility="Collapsed">
                                    <StackPanel>
                                        <TextBlock x:Uid="S_SelectMetricsGroupedIntoBattery" Text="Select Metrics (grouped into Battery, CPU, GPU and Memory cells)"
                                                   TextWrapping="Wrap"
                                                   Foreground="#B9C0CC"
                                                   FontSize="12"
                                                   Margin="0,0,0,8" />
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <!-- Row 0 -->
                                            <CheckBox x:Uid="MetricCheck_BatteryDrain" x:Name="MetricCheck_BatteryDrain" Content="Battery Drain" Grid.Row="0" Grid.Column="0" Foreground="White" FontSize="13" Margin="0,2" Checked="MetricCheckBox_Changed" Unchecked="MetricCheckBox_Changed" />
                                            <CheckBox x:Uid="MetricCheck_BatteryLevel" x:Name="MetricCheck_BatteryLevel" Content="Battery Level" Grid.Row="0" Grid.Column="1" Foreground="White" FontSize="13" Margin="0,2" Checked="MetricCheckBox_Changed" Unchecked="MetricCheckBox_Changed" />
                                            <!-- Row 1 -->
                                            <CheckBox x:Uid="MetricCheck_CPUUsage" x:Name="MetricCheck_CPUUsage" Content="CPU Usage" Grid.Row="1" Grid.Column="0" Foreground="White" FontSize="13" Margin="0,2" Checked="MetricCheckBox_Changed" Unchecked="MetricCheckBox_Changed" />
                                            <CheckBox x:Uid="MetricCheck_CPUTemp" x:Name="MetricCheck_CPUTemp" Content="CPU Temp" Grid.Row="1" Grid.Column="1" Foreground="White" FontSize="13" Margin="0,2" Checked="MetricCheckBox_Changed" Unchecked="MetricCheckBox_Changed" />
                                            <!-- Row 2 -->
                                            <CheckBox x:Uid="MetricCheck_CPUWattage" x:Name="MetricCheck_CPUWattage" Content="CPU Wattage" Grid.Row="2" Grid.Column="0" Foreground="White" FontSize="13" Margin="0,2" Checked="MetricCheckBox_Changed" Unchecked="MetricCheckBox_Changed" />
                                            <CheckBox x:Uid="MetricCheck_GPUUsage" x:Name="MetricCheck_GPUUsage" Content="GPU Usage" Grid.Row="2" Grid.Column="1" Foreground="White" FontSize="13" Margin="0,2" Checked="MetricCheckBox_Changed" Unchecked="MetricCheckBox_Changed" />
                                            <!-- Row 3 -->
                                            <CheckBox x:Uid="MetricCheck_GPUTemp" x:Name="MetricCheck_GPUTemp" Content="GPU Temp" Grid.Row="3" Grid.Column="0" Foreground="White" FontSize="13" Margin="0,2" Checked="MetricCheckBox_Changed" Unchecked="MetricCheckBox_Changed" />
                                            <CheckBox x:Uid="MetricCheck_GPUWattage" x:Name="MetricCheck_GPUWattage" Content="GPU Wattage" Grid.Row="3" Grid.Column="1" Foreground="White" FontSize="13" Margin="0,2" Checked="MetricCheckBox_Changed" Unchecked="MetricCheckBox_Changed" />
                                            <!-- Row 4 -->
                                            <CheckBox x:Uid="MetricCheck_MemoryUsage" x:Name="MetricCheck_MemoryUsage" Content="Memory Usage" Grid.Row="4" Grid.Column="0" Foreground="White" FontSize="13" Margin="0,2" Checked="MetricCheckBox_Changed" Unchecked="MetricCheckBox_Changed" />
                                            <CheckBox x:Uid="MetricCheck_TimeRemaining" x:Name="MetricCheck_TimeRemaining" Content="Time Remaining" Grid.Row="4" Grid.Column="1" Foreground="White" FontSize="13" Margin="0,2" Checked="MetricCheckBox_Changed" Unchecked="MetricCheckBox_Changed" />
                                            <!-- Row 5 -->
                                            <CheckBox x:Uid="MetricCheck_VRAMUsage" x:Name="MetricCheck_VRAMUsage" Content="VRAM Used" Grid.Row="5" Grid.Column="0" Foreground="White" FontSize="13" Margin="0,2" Checked="MetricCheckBox_Changed" Unchecked="MetricCheckBox_Changed" />
                                        </Grid>
                                        <TextBlock x:Uid="MetricsSelectionCount" x:Name="MetricsSelectionCount" Text="0 selected" Foreground="#B9C0CC" FontSize="12" Margin="0,6,0,0" HorizontalAlignment="Right" />

                                        <!-- Reorder Section -->
                                        <Border x:Name="MetricsReorderSection"
                                                Background="#1A1A2E"
                                                CornerRadius="6"
                                                Padding="8"
                                                Margin="0,10,0,0"
                                                Visibility="Collapsed">
                                            <StackPanel>
                                                <TextBlock x:Uid="S_ReorderDragOrUseArrows" Text="Reorder (drag or use arrows)"
                                                           Foreground="#B9C0CC"
                                                           FontSize="12"
                                                           Margin="0,0,0,6" />
                                                <StackPanel x:Name="MetricsReorderList" Spacing="4"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <!-- Sortable Tile Grid - generated in code-behind -->
                                <StackPanel x:Name="TileSortableGrid"/>

                                <!-- Selected tile indicator -->
                                <Border x:Name="SelectedTileIndicator"
                                        Visibility="Collapsed"
                                        Background="#1A2530"
                                        CornerRadius="4"
                                        Padding="8"
                                        Margin="0,8,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="SelectedTileText"
                                                   Foreground="#00C8FF"
                                                   FontSize="13"
                                                   TextWrapping="Wrap"
                                                   VerticalAlignment="Center"/>
                                        <Button x:Name="DeleteSelectedTileButton"
                                                Grid.Column="1"
                                                Visibility="Collapsed"
                                                Background="#662020"
                                                Foreground="White"
                                                Margin="8,0,0,0"
                                                Padding="12,6"
                                                Click="DeleteSelectedTile_Click">
                                            <StackPanel Orientation="Horizontal">
                                                <FontIcon Glyph="&#xE74D;" FontSize="14" Margin="0,0,6,0"/>
                                                <TextBlock x:Uid="S_Delete" Text="Delete" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </Border>

                                <!-- Add Custom Shortcut Section -->
                                <TextBlock x:Uid="S_AddCustomShortcut" Text="Add Custom Shortcut"
                                           Style="{StaticResource CardTitleStyle}"
                                           Margin="0,16,0,8" />
                                <TextBox x:Uid="CustomShortcutNameBox" x:Name="CustomShortcutNameBox"
                                         PlaceholderText="Tile Name"
                                         Margin="0,0,0,8" />
                                <StackPanel Orientation="Horizontal">
                                    <ItemsControl x:Name="CustomShortcutKeyTags">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                    <ComboBox x:Name="CustomShortcutKeyComboBox" Width="90" Style="{StaticResource ModernComboBoxStyle}"
                                              SelectedIndex="0" SelectionChanged="CustomShortcutKey_SelectionChanged">
                                        <x:String>+ Key</x:String><x:String>A</x:String><x:String>B</x:String><x:String>C</x:String><x:String>D</x:String><x:String>E</x:String><x:String>F</x:String><x:String>G</x:String><x:String>H</x:String><x:String>I</x:String><x:String>J</x:String><x:String>K</x:String><x:String>L</x:String><x:String>M</x:String><x:String>N</x:String><x:String>O</x:String><x:String>P</x:String><x:String>Q</x:String><x:String>R</x:String><x:String>S</x:String><x:String>T</x:String><x:String>U</x:String><x:String>V</x:String><x:String>W</x:String><x:String>X</x:String><x:String>Y</x:String><x:String>Z</x:String><x:String>0</x:String><x:String>1</x:String><x:String>2</x:String><x:String>3</x:String><x:String>4</x:String><x:String>5</x:String><x:String>6</x:String><x:String>7</x:String><x:String>8</x:String><x:String>9</x:String><x:String>F1</x:String><x:String>F2</x:String><x:String>F3</x:String><x:String>F4</x:String><x:String>F5</x:String><x:String>F6</x:String><x:String>F7</x:String><x:String>F8</x:String><x:String>F9</x:String><x:String>F10</x:String><x:String>F11</x:String><x:String>F12</x:String><x:String>Enter</x:String><x:String>Esc</x:String><x:String>Space</x:String><x:String>Tab</x:String><x:String>Backspace</x:String><x:String>Up</x:String><x:String>Down</x:String><x:String>Left</x:String><x:String>Right</x:String><x:String>LCtrl</x:String><x:String>LShift</x:String><x:String>LAlt</x:String><x:String>LWin</x:String><x:String>RCtrl</x:String><x:String>RShift</x:String><x:String>RAlt</x:String><x:String>RWin</x:String><x:String>Home</x:String><x:String>End</x:String><x:String>PgUp</x:String><x:String>PgDn</x:String><x:String>Insert</x:String><x:String>Delete</x:String><x:String>PrintScr</x:String><x:String>Pause</x:String><x:String>VolUp</x:String><x:String>VolDown</x:String><x:String>VolMute</x:String><x:String>[</x:String><x:String>]</x:String>
                                    </ComboBox>
                                </StackPanel>
                                <Button x:Uid="AddCustomShortcutButton" x:Name="AddCustomShortcutButton"
                                        Content="Add Shortcut Tile"
                                        HorizontalAlignment="Stretch"
                                        Margin="0,8,0,0"
                                        Style="{StaticResource StandaloneButtonStyle}"
                                        Click="AddCustomShortcut_Click" />

                                <!-- Done Button -->
                                <Button x:Uid="S_Done" Content="Done"
                                        HorizontalAlignment="Stretch"
                                        Margin="0,16,0,0"
                                        Style="{StaticResource StandaloneButtonStyle}"
                                        Click="QuickSettingsCustomizeDone_Click" />
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>

                <!-- PERFORMANCE TAB -->
                <ScrollViewer x:Name="PerformanceScrollViewer" VerticalScrollBarVisibility="Auto" Visibility="Collapsed"
                              BringIntoViewOnFocusChange="True">
                    <StackPanel Padding="16,0,16,16">

                        <!-- PROFILE -->
                        <TextBlock x:Uid="S_SectionProfile" Text="Profile" Style="{StaticResource SettingsSectionTitleStyle}"/>
                        <Border x:Name="ActiveProfileCard" Style="{StaticResource GroupCardStyle}">
                            <StackPanel>
                                <Grid Padding="16,12,16,12" ColumnSpacing="14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE77B;" FontSize="20" Foreground="#B9C0CC" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock x:Uid="S_CurrentProfile" Text="Current Profile" FontSize="12" Foreground="#B9C0CC"/>
                                        <!-- Long names marquee-scroll (UpdateMarqueeScrollAnimation). -->
                                        <Canvas x:Name="ActiveProfileTextCanvas" Height="22" HorizontalAlignment="Stretch">
                                            <Canvas.Clip>
                                                <RectangleGeometry Rect="0,0,0,22"/>
                                            </Canvas.Clip>
                                            <TextBlock x:Uid="ActiveProfileText" x:Name="ActiveProfileText"
                                                       Text="Global Settings"
                                                       FontSize="16"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource SystemAccentBrush}">
                                                <TextBlock.RenderTransform>
                                                    <TranslateTransform x:Name="ActiveProfileTextTransform"/>
                                                </TextBlock.RenderTransform>
                                            </TextBlock>
                                        </Canvas>
                                    </StackPanel>
                                </Grid>
                                <Border Style="{StaticResource GroupDividerStyle}"/>
                                <ctk:SettingsCard Style="{StaticResource GroupRowStyle}" Tapped="ToggleRow_Tapped">
                                    <ctk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE7FC;"/></ctk:SettingsCard.HeaderIcon>
                                    <ctk:SettingsCard.Header>
                                        <TextBlock x:Uid="S_UsePerGameProfile" Text="Use per-game profile"/>
                                    </ctk:SettingsCard.Header>
                                    <ctk:SettingsCard.Description>
                                        <!-- Detected game name; long window titles marquee-scroll. -->
                                        <Canvas x:Name="DetectedGameTextCanvas" Height="16" MaxWidth="200" HorizontalAlignment="Left">
                                            <Canvas.Clip>
                                                <RectangleGeometry Rect="0,0,200,16"/>
                                            </Canvas.Clip>
                                            <TextBlock x:Uid="DetectedGameText" x:Name="DetectedGameText"
                                                       Text="No game detected"
                                                       FontSize="12"
                                                       Foreground="#B9C0CC">
                                                <TextBlock.RenderTransform>
                                                    <TranslateTransform x:Name="DetectedGameTextTransform"/>
                                                </TextBlock.RenderTransform>
                                            </TextBlock>
                                        </Canvas>
                                    </ctk:SettingsCard.Description>
                                    <ToggleSwitch x:Name="PerGameProfileToggle"
                                                  Style="{StaticResource ModernToggleStyle}"
                                                  IsEnabled="False"/>
                                </ctk:SettingsCard>
                                <Border Style="{StaticResource GroupDividerStyle}"/>
                                <ctk:SettingsCard x:Uid="S_PowerSourceProfile" Style="{StaticResource GroupRowStyle}" Header="Power Source Profile" Description="Separate profiles for AC (plugged in) and DC (battery)" Tapped="ToggleRow_Tapped">
                                    <ctk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE83F;"/></ctk:SettingsCard.HeaderIcon>
                                    <ToggleSwitch x:Name="PowerSourceProfileToggle"
                                                  Style="{StaticResource ModernToggleStyle}" Width="47"/>
                                </ctk:SettingsCard>
                                <TextBlock x:Uid="PowerSourceProfileScopeText" x:Name="PowerSourceProfileScopeText"
                                           Margin="52,0,16,12"
                                           FontSize="12"
                                           Foreground="#B9C0CC"
                                           TextWrapping="Wrap"
                                           Text="Scope: Global profiles. AC/DC split: Off. Enable Per-Game Profile to set this per game." />
                            </StackPanel>
                        </Border>

                        <!-- OVERLAY -->
                        <TextBlock x:Uid="S_SectionOverlay" Text="Overlay" Style="{StaticResource SettingsSectionTitleStyle}"/>
                        <Border Style="{StaticResource GroupCardStyle}">
                            <StackPanel>
                                <ctk:SettingsCard x:Uid="S_PerformanceOverlay" Style="{StaticResource GroupRowStyle}" Header="Performance Overlay" Description="FPS, CPU/GPU, RAM/VRAM, Battery, Time" Tapped="ToggleRow_Tapped">
                                    <ctk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE9D9;"/></ctk:SettingsCard.HeaderIcon>
                                    <ToggleSwitch x:Name="PerformanceOverlayToggle"
                                                  Style="{StaticResource ModernToggleStyle}"
                                                  Width="52"
                                                  Toggled="PerformanceOverlayToggle_Toggled"
                                                  XYFocusLeft="{x:Bind PerformanceNavItem}"/>
                                </ctk:SettingsCard>
                                <!-- Hidden slider for property system compatibility (OSDProperty binds to a Slider) -->
                                <Slider x:Name="PerformanceOverlaySlider"
                                        Visibility="Collapsed"
                                        Minimum="0" Maximum="1"
                                        Value="0"
                                        ValueChanged="PerformanceOverlaySlider_ValueChanged"/>
                                <Border Style="{StaticResource GroupDividerStyle}"/>
                                <ctk:SettingsCard x:Uid="PerformanceOverlayPresetComboBox" Style="{StaticResource GroupRowStyle}" Header="Overlay preset (RTSS)">
                                    <ctk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE8FD;"/></ctk:SettingsCard.HeaderIcon>
                                    <ComboBox x:Name="PerformanceOverlayPresetComboBox"
                                              Style="{StaticResource ModernComboBoxStyle}" MinWidth="130"
                                              SelectedIndex="0" SelectionChanged="OSDPreset_Changed">
                                        <ComboBoxItem x:Uid="S_Custom" Content="Custom" Tag="Custom" />
                                        <ComboBoxItem x:Uid="S_Basic" Content="Basic" Tag="Basic" />
                                        <ComboBoxItem x:Uid="S_Detailed" Content="Detailed" Tag="Detailed" />
                                        <ComboBoxItem x:Uid="S_Full" Content="Full" Tag="Full" />
                                        <ComboBoxItem x:Uid="S_Original" Content="Original" Tag="Original" />
                                    </ComboBox>
                                </ctk:SettingsCard>
                                <Border Style="{StaticResource GroupDividerStyle}"/>
                                <ctk:SettingsCard Style="{StaticResource GroupRowStyle}">
                                    <ctk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE916;"/></ctk:SettingsCard.HeaderIcon>
                                    <ctk:SettingsCard.Header>
                                        <TextBlock x:Uid="S_FPSLimit" Text="FPS Limit"/>
                                    </ctk:SettingsCard.Header>
                                    <ctk:SettingsCard.Description>
                                        <TextBlock x:Name="FPSLimitCaption" Text="" Visibility="Collapsed"/>
                                    </ctk:SettingsCard.Description>
                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <TextBlock x:Name="FPSLimitValue"
                                                   Text=""
                                                   FontSize="14"
                                                   Foreground="#4CAF50"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center"
                                                   Visibility="{x:Bind FPSLimitToggle.IsOn, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}"/>
                                        <ToggleSwitch x:Name="FPSLimitToggle"
                                                      Style="{StaticResource ModernToggleStyle}"
                                                      IsEnabled="False" Width="52"/>
                                    </StackPanel>
                                </ctk:SettingsCard>
                                <Slider x:Name="FPSLimitSlider"
                                        Style="{StaticResource ModernSliderStyle}"
                                        Margin="52,0,16,12"
                                        Minimum="15" Maximum="144"
                                        StepFrequency="1"
                                        TickFrequency="15"
                                        TickPlacement="Outside"
                                        SnapsTo="StepValues"
                                        Visibility="{x:Bind FPSLimitToggle.IsOn, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}"/>
                            </StackPanel>
                        </Border>

                        <!-- POWER -->
                        <TextBlock x:Uid="S_SectionPower" Text="Power" Style="{StaticResource SettingsSectionTitleStyle}"/>
                        <!-- TDP Mode (all devices). Named *ComboBox for code-behind compatibility;
                             Segmented is a Selector too. Focus moves with the D-pad, A applies. -->
                        <Border x:Name="TDPModeCard" Style="{StaticResource GroupCardStyle}">
                            <StackPanel>
                                <ctk:SettingsCard Style="{StaticResource GroupRowStyle}">
                                    <ctk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE945;"/></ctk:SettingsCard.HeaderIcon>
                                    <ctk:SettingsCard.Header>
                                        <TextBlock x:Uid="S_TDPMode" Text="TDP Mode"/>
                                    </ctk:SettingsCard.Header>
                                    <ctk:SettingsCard.Description>
                                        <TextBlock x:Uid="S_ControlsPowerAndThermalProfile" Text="Controls power and thermal profile" TextWrapping="Wrap"/>
                                    </ctk:SettingsCard.Description>
                                </ctk:SettingsCard>
                                <ctk:Segmented x:Name="TDPModeComboBox"
                                               Margin="16,0,16,14"
                                               HorizontalAlignment="Stretch"
                                               SingleSelectionFollowsFocus="False"
                                               SelectionChanged="TDPModeComboBox_SelectionChanged">
                                    <ctk:SegmentedItem x:Uid="S_Quiet" Content="Quiet" Tag="1" />
                                    <ctk:SegmentedItem x:Uid="S_Balanced" Content="Balanced" Tag="2" IsSelected="True" />
                                    <ctk:SegmentedItem x:Uid="S_Performance" Content="Performance" Tag="3" />
                                    <ctk:SegmentedItem x:Uid="S_Custom" Content="Custom" Tag="255" />
                                </ctk:Segmented>
                            </StackPanel>
                        </Border>

                        <!-- Custom Power Limits (Legion only, Custom mode): TDP (SPL), SPPT and FPPT
                             boosts through Lenovo WMI, with the live hardware readout at the bottom. -->
                        <Border x:Name="CustomTDPCard" Style="{StaticResource GroupCardStyle}" Visibility="Collapsed">
                            <StackPanel>
                                <ctk:SettingsCard Style="{StaticResource GroupRowStyle}">
                                    <ctk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE9E9;"/></ctk:SettingsCard.HeaderIcon>
                                    <ctk:SettingsCard.Header>
                                        <TextBlock x:Uid="S_CustomPowerLimits" Text="Custom Power Limits"/>
                                    </ctk:SettingsCard.Header>
                                </ctk:SettingsCard>
                                <StackPanel Spacing="6" Padding="52,0,16,14">
                                    <Grid>
                                        <TextBlock x:Uid="S_TDP" Text="TDP" FontSize="14" Foreground="#FFFFFF" VerticalAlignment="Center" />
                                        <TextBlock x:Name="CustomTDPSlowValue" Text="-- W" FontSize="14" FontWeight="SemiBold" Foreground="#FFFFFF" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <Slider x:Name="CustomTDPSlowSlider"
                                            Style="{StaticResource ModernSliderStyle}"
                                            Minimum="5" Maximum="50"
                                            TickFrequency="1"
                                            SnapsTo="Ticks"
                                            Value="15"
                                            ValueChanged="CustomTDPSlowSlider_ValueChanged"/>
                                    <Grid Margin="0,6,0,0">
                                        <TextBlock x:Uid="S_SPPTBoost" Text="SPPT Boost" FontSize="14" Foreground="#FFFFFF" VerticalAlignment="Center" />
                                        <TextBlock x:Name="CustomTDPFastValue" Text="-- W" FontSize="14" FontWeight="SemiBold" Foreground="#FFFFFF" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <Slider x:Name="CustomTDPFastSlider"
                                            Style="{StaticResource ModernSliderStyle}"
                                            Minimum="0" Maximum="10"
                                            TickFrequency="1"
                                            SnapsTo="Ticks"
                                            Value="2"
                                            ValueChanged="CustomTDPFastSlider_ValueChanged"/>
                                    <Grid Margin="0,6,0,0">
                                        <TextBlock x:Uid="S_FPPTBoost" Text="FPPT Boost" FontSize="14" Foreground="#FFFFFF" VerticalAlignment="Center" />
                                        <TextBlock x:Name="CustomTDPPeakValue" Text="-- W" FontSize="14" FontWeight="SemiBold" Foreground="#FFFFFF" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <Slider x:Name="CustomTDPPeakSlider"
                                            Style="{StaticResource ModernSliderStyle}"
                                            Minimum="0" Maximum="15"
                                            TickFrequency="1"
                                            SnapsTo="Ticks"
                                            Value="5"
                                            ValueChanged="CustomTDPPeakSlider_ValueChanged"/>
                                    <Grid Margin="0,6,0,0">
                                        <TextBlock x:Uid="CurrentTDPText" x:Name="CurrentTDPText" Text="Limits:" FontSize="13" Foreground="#B9C0CC" />
                                        <TextBlock x:Name="CurrentTDPValueText" Text="-- W" FontSize="13" Foreground="#B9C0CC" HorizontalAlignment="Right"/>
                                    </Grid>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- AutoTDP (Legion only): adjusts TDP to hit a target FPS. Enabling it forces
                             TDP Mode to Custom and locks the mode selector until disabled. -->
                        <Border x:Name="AutoTDPCard" Style="{StaticResource GroupCardStyle}" Visibility="Collapsed">
                            <StackPanel>
                                <ctk:SettingsCard x:Uid="S_AutoTDP" Style="{StaticResource GroupRowStyle}" Header="AutoTDP" Description="Adjusts TDP live to hit a target FPS" Tapped="ToggleRow_Tapped">
                                    <ctk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE9F5;"/></ctk:SettingsCard.HeaderIcon>
                                    <ToggleSwitch x:Name="AutoTDPToggle"
                                                  Style="{StaticResource ModernToggleStyle}"
                                                  Width="52"
                                                  Toggled="AutoTDPToggle_Toggled"/>
                                </ctk:SettingsCard>
                                <StackPanel x:Name="AutoTDPSettingsPanel"
                                            Visibility="{Binding ElementName=AutoTDPToggle, Path=IsOn, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <StackPanel Spacing="6" Padding="52,0,16,8">
                                        <Grid>
                                            <TextBlock x:Uid="S_TargetFPS" Text="Target FPS" FontSize="14" Foreground="#FFFFFF" VerticalAlignment="Center" />
                                            <TextBlock x:Uid="AutoTDPTargetFPSValue" x:Name="AutoTDPTargetFPSValue" Text="60 FPS" FontSize="14" FontWeight="SemiBold" Foreground="#FFFFFF" HorizontalAlignment="Right" />
                                        </Grid>
                                        <Slider x:Name="AutoTDPTargetFPSSlider"
                                                Style="{StaticResource ModernSliderStyle}"
                                                Minimum="30" Maximum="144"
                                                StepFrequency="5" TickFrequency="15" TickPlacement="Outside" SnapsTo="StepValues"
                                                Value="60"
                                                ValueChanged="AutoTDPTargetFPSSlider_ValueChanged"/>
                                        <Grid>
                                            <TextBlock x:Uid="S_CurrentFPS" Text="Current FPS" FontSize="13" Foreground="#B9C0CC" VerticalAlignment="Center" />
                                            <TextBlock x:Uid="AutoTDPCurrentFPSValue" x:Name="AutoTDPCurrentFPSValue" Text="-- FPS" FontSize="13" Foreground="#B9C0CC" HorizontalAlignment="Right" />
                                        </Grid>
                                        <Grid Margin="0,6,0,0">
                                            <TextBlock x:Uid="S_MinTDP" Text="Min TDP" FontSize="14" Foreground="#FFFFFF" VerticalAlignment="Center" />
                                            <TextBlock x:Name="AutoTDPMinValue" Text="8W" FontSize="14" FontWeight="SemiBold" Foreground="#FFFFFF" HorizontalAlignment="Right"/>
                                        </Grid>
                                        <Slider x:Name="AutoTDPMinSlider"
                                                Style="{StaticResource ModernSliderStyle}"
                                                Minimum="4" Maximum="35" StepFrequency="1"
                                                Value="8"
                                                ValueChanged="AutoTDPMinSlider_ValueChanged"/>
                                        <Grid Margin="0,6,0,0">
                                            <TextBlock x:Uid="S_MaxTDP" Text="Max TDP" FontSize="14" Foreground="#FFFFFF" VerticalAlignment="Center" />
                                            <TextBlock x:Name="AutoTDPMaxValue" Text="30W" FontSize="14" FontWeight="SemiBold" Foreground="#FFFFFF" HorizontalAlignment="Right"/>
                                        </Grid>
                                        <Slider x:Name="AutoTDPMaxSlider"
                                                Style="{StaticResource ModernSliderStyle}"
                                                Minimum="4" Maximum="35" StepFrequency="1"
                                                Value="30"
                                                ValueChanged="AutoTDPMaxSlider_ValueChanged"/>
                                    </StackPanel>
                                    <Border Style="{StaticResource GroupDividerStyle}"/>
                                    <ctk:SettingsCard Style="{StaticResource GroupRowStyle}" Tapped="ToggleRow_Tapped">
                                        <ctk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE769;"/></ctk:SettingsCard.HeaderIcon>
                                        <ctk:SettingsCard.Header>
                                            <TextBlock x:Uid="S_PauseWhenGameNotFocused" Text="Pause when game not focused" TextWrapping="Wrap"/>
                                        </ctk:SettingsCard.Header>
                                        <ToggleSwitch x:Name="AutoTDPPauseWhenUnfocusedToggle"
                                                      Style="{StaticResource ModernToggleStyle}"
                                                      Width="52"
                                                      IsOn="True"
                                                      Toggled="AutoTDPPauseWhenUnfocusedToggle_Toggled"/>
                                    </ctk:SettingsCard>
                                    <Border Style="{StaticResource GroupDividerStyle}"/>
                                    <ctk:SettingsCard Style="{StaticResource GroupRowStyle}" Tapped="ToggleRow_Tapped">
                                        <ctk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE945;"/></ctk:SettingsCard.HeaderIcon>
                                        <ctk:SettingsCard.Header>
                                            <TextBlock x:Uid="S_FastResponse" Text="Fast response" TextWrapping="Wrap"/>
                                        </ctk:SettingsCard.Header>
                                        <ctk:SettingsCard.Description>
                                            <TextBlock x:Uid="S_JumpToTheEstimatedWattage" Text="Jump to the estimated wattage when FPS is far off target, then fine-tune" TextWrapping="Wrap"/>
                                        </ctk:SettingsCard.Description>
                                        <ToggleSwitch x:Name="AutoTDPFastResponseToggle"
                                                      Style="{StaticResource ModernToggleStyle}"
                                                      Width="52"
                                                      IsOn="True"/>
                                    </ctk:SettingsCard>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- OS Power Mode -->
                        <Border Style="{StaticResource GroupCardStyle}">
                            <StackPanel>
                                <ctk:SettingsCard Style="{StaticResource GroupRowStyle}">
                                    <ctk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xEC4A;"/></ctk:SettingsCard.HeaderIcon>
                                    <ctk:SettingsCard.Header>
                                        <TextBlock x:Uid="S_OSPowerMode" Text="OS Power Mode"/>
                                    </ctk:SettingsCard.Header>
                                    <ctk:SettingsCard.Description>
                                        <TextBlock x:Uid="S_WindowsPowerSliderSetting" Text="Windows power slider setting" TextWrapping="Wrap"/>
                                    </ctk:SettingsCard.Description>
                                    <TextBlock x:Uid="OSPowerModeValue" x:Name="OSPowerModeValue"
                                               Text="Balanced"
                                               FontSize="14"
                                               Foreground="#4CAF50"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center"
                                               Visibility="Collapsed" />
                                </ctk:SettingsCard>
                                <ctk:Segmented x:Name="OSPowerModeComboBox"
                                               Margin="16,0,16,14"
                                               HorizontalAlignment="Stretch"
                                               SingleSelectionFollowsFocus="False"
                                               SelectionChanged="OSPowerModeComboBox_SelectionChanged">
                                    <ctk:SegmentedItem x:Uid="S_Efficiency" Content="Efficiency" />
                                    <ctk:SegmentedItem x:Uid="S_Balanced" Content="Balanced" IsSelected="True" />
                                    <ctk:SegmentedItem x:Uid="S_Performance" Content="Performance" />
                                </ctk:Segmented>
                            </StackPanel>
                        </Border>

                        <!-- PROCESSOR (collapsible) -->
                        <TextBlock x:Uid="S_SectionProcessor" Text="Processor" Style="{StaticResource SettingsSectionTitleStyle}"/>
                        <Border Style="{StaticResource GroupCardStyle}">
                            <StackPanel>
                                <Grid Background="Transparent" Tapped="ExpandHeader_Tapped">
                                    <ctk:SettingsCard Style="{StaticResource GroupRowStyle}">
                                        <ctk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xEEA1;"/></ctk:SettingsCard.HeaderIcon>
                                        <ctk:SettingsCard.Header>
                                            <TextBlock x:Uid="S_CPUExtras" Text="CPU Extras"/>
                                        </ctk:SettingsCard.Header>
                                        <ctk:SettingsCard.Description>
                                            <TextBlock x:Uid="S_CPUBoostEPPAndState" Text="CPU Boost, EPP, and State limits" TextWrapping="Wrap"/>
                                        </ctk:SettingsCard.Description>
                                        <ToggleButton x:Name="CPUExtrasExpandToggle" MinWidth="44" MinHeight="40"
                                                      IsChecked="False"
                                                      Background="Transparent"
                                                      BorderThickness="0"
                                                      Padding="8,4"
                                                      Click="CPUExtrasExpandToggle_Click"
                                                      UseSystemFocusVisuals="True">
                                            <FontIcon x:Name="CPUExtrasExpandIcon" Glyph="&#xE70D;" FontSize="13"/>
                                        </ToggleButton>
                                    </ctk:SettingsCard>
                                </Grid>
                                <StackPanel x:Name="CPUExtrasContent" Visibility="Collapsed" Background="#2F3338">
                                    <Border Style="{StaticResource GroupDividerStyle}"/>
                                    <ctk:SettingsCard x:Uid="S_CPUBoost" Style="{StaticResource GroupRowStyle}" Header="CPU Boost" Description="Higher boost clocks" Tapped="ToggleRow_Tapped">
                                        <ToggleSwitch x:Name="CPUBoostToggle"
                                                      Style="{StaticResource ModernToggleStyle}"
                                                      IsEnabled="False"/>
                                    </ctk:SettingsCard>
                                    <Border Style="{StaticResource GroupDividerStyle}"/>
                                    <StackPanel Padding="52,12,16,12" Spacing="4">
                                        <Grid>
                                            <TextBlock x:Uid="S_CPUEPP" Text="CPU EPP" FontSize="14" Foreground="#FFFFFF" />
                                            <TextBlock x:Name="CPUEPPValueText"
                                                       Text="{Binding ElementName=CPUEPPSlider, Path=Value}"
                                                       FontSize="14" FontWeight="SemiBold" Foreground="#FFFFFF" HorizontalAlignment="Right"/>
                                        </Grid>
                                        <Slider x:Name="CPUEPPSlider"
                                                Style="{StaticResource ModernSliderStyle}"
                                                Minimum="0" Maximum="100"
                                                TickFrequency="10"
                                                SnapsTo="Ticks"
                                                TickPlacement="BottomRight"
                                                IsEnabled="False"/>
                                        <Grid>
                                            <TextBlock x:Uid="S_0PrioritizeCPU" Text="0 = Prioritize CPU" FontSize="12" Foreground="#B9C0CC" />
                                            <TextBlock x:Uid="S_100PrioritizeGPU" Text="100 = Prioritize GPU" FontSize="12" Foreground="#B9C0CC" HorizontalAlignment="Right" />
                                        </Grid>
                                    </StackPanel>
                                    <Border Style="{StaticResource GroupDividerStyle}"/>
                                    <StackPanel Padding="52,12,16,14">
                                        <TextBlock x:Uid="S_CPUState" Text="CPU State" FontSize="14" Foreground="#FFFFFF" />
                                        <TextBlock x:Uid="S_ProcessorPerformanceLimits" Text="Processor performance limits" FontSize="12" Foreground="#B9C0CC" />
                                        <Grid Margin="0,8,0,0" ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock x:Uid="S_Min" Text="Min %" FontSize="12" Foreground="#B9C0CC" Margin="0,0,0,4" />
                                                <ComboBox x:Name="MinCPUStateComboBox"
                                                          Style="{StaticResource ModernComboBoxStyle}"
                                                          SelectionChanged="MinCPUStateComboBox_SelectionChanged"
                                                          IsEnabled="False"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock x:Uid="S_Max" Text="Max %" FontSize="12" Foreground="#B9C0CC" Margin="0,0,0,4" />
                                                <ComboBox x:Name="MaxCPUStateComboBox"
                                                          Style="{StaticResource ModernComboBoxStyle}"
                                                          SelectionChanged="MaxCPUStateComboBox_SelectionChanged"
                                                          IsEnabled="False"/>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>

                <!-- GAME TAB -->
                <ScrollViewer x:Name="GameScrollViewer" VerticalScrollBarVisibility="Auto" Visibility="Collapsed"
                              BringIntoViewOnFocusChange="True">
                    <StackPanel Padding="16,0,16,16">

                        <!-- Current Game Card -->
                        <TextBlock x:Uid="S_CurrentGame" Text="Current Game" Style="{StaticResource SettingsSectionTitleStyle}" />
                        <Border Style="{StaticResource GroupCardStyle}" Padding="16,14,16,14">
                            <Grid ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <!-- Game icon (from the executable) over a placeholder tile -->
                                <Grid Width="48" Height="48">
                                    <Border x:Name="CurrentGameIconPlaceholder" Background="#45494F" CornerRadius="8">
                                        <FontIcon Glyph="&#xE7FC;" FontSize="24" Foreground="#B9C0CC"/>
                                    </Border>
                                    <Image x:Name="CurrentGameIcon"
                                           Width="48" Height="48"
                                           Stretch="UniformToFill"
                                           Visibility="Collapsed"/>
                                </Grid>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock x:Uid="RunningGameText" x:Name="RunningGameText"
                                               Text="No game detected"
                                               FontSize="16"
                                               FontWeight="SemiBold"
                                               Foreground="White"
                                               TextWrapping="Wrap" />
                                    <TextBlock x:Name="CurrentGameProfileStatus"
                                               Text=""
                                               FontSize="12"
                                               Foreground="#B9C0CC"
                                               TextWrapping="Wrap"
                                               Visibility="Collapsed"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Game Detection Card -->
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <Grid Background="Transparent" Tapped="ExpandHeader_Tapped">
                                    <ctk:SettingsCard Style="{StaticResource HeaderRowStyle}">
                                        <ctk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE721;"/></ctk:SettingsCard.HeaderIcon>
                                        <ctk:SettingsCard.Header>
                                            <TextBlock x:Uid="S_GameDetection" Text="Game Detection" />
                                        </ctk:SettingsCard.Header>
                                        <ctk:SettingsCard.Description>
                                            <TextBlock x:Uid="S_GamesWithProfilesAlwaysDetect" Text="Games with profiles always detect regardless of settings" />
                                        </ctk:SettingsCard.Description>
                                        <ToggleButton x:Name="ProfileDetectionExpandToggle" MinWidth="44" MinHeight="40"
                                                  IsChecked="False"
                                                  Background="Transparent"
                                                  BorderThickness="0"
                                                  Padding="8,4"
                                                  Click="ProfileDetectionExpandToggle_Click">
                                        <FontIcon x:Name="ProfileDetectionExpandIcon" Glyph="&#xE70D;" FontSize="13"/>
                                    </ToggleButton>
                                    </ctk:SettingsCard>
                                </Grid>

                                <StackPanel x:Name="ProfileDetectionContent" Visibility="Collapsed" Margin="0,12,0,0" Spacing="12">

                                    <!-- Match Exe Toggle -->
                                    <ctk:SettingsCard x:Uid="S_PreferExecutable" Header="Prefer executable" Description="Use .exe name, fall back to window title if unavailable" Tapped="ToggleRow_Tapped">
                                        <ctk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE721;"/></ctk:SettingsCard.HeaderIcon>
                                        <ToggleSwitch x:Name="ProfileMatchByExeToggle"
                                        Style="{StaticResource ModernToggleStyle}"/>
                                    </ctk:SettingsCard>

                                    <!-- Games Only Toggle -->
                                    <ctk:SettingsCard x:Uid="S_GamesOnly" Header="Games only" Description="Detect apps with FPS (RTSS) or added to Xbox Game Bar" Tapped="ToggleRow_Tapped">
                                        <ctk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE721;"/></ctk:SettingsCard.HeaderIcon>
                                        <ToggleSwitch x:Name="ProfileGamesOnlyToggle"
                                        Style="{StaticResource ModernToggleStyle}"
                                        IsOn="True"/>
                                    </ctk:SettingsCard>

                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Profile Settings Card (Collapsible) -->
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <!-- Header with Expand/Collapse -->
                                <Grid Background="Transparent" Tapped="ExpandHeader_Tapped">
                                    <ctk:SettingsCard Style="{StaticResource HeaderRowStyle}">
                                        <ctk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE713;"/></ctk:SettingsCard.HeaderIcon>
                                        <ctk:SettingsCard.Header>
                                            <TextBlock x:Uid="S_ProfileSettings" Text="Profile Settings" />
                                        </ctk:SettingsCard.Header>
                                        <ctk:SettingsCard.Description>
                                            <TextBlock x:Uid="S_ChooseWhichSettingsAreSaved" Text="Choose which settings are saved in profiles" TextWrapping="Wrap" />
                                        </ctk:SettingsCard.Description>
                                        <ToggleButton x:Name="ProfileSettingsExpandToggle" MinWidth="44" MinHeight="40"
                                                  IsChecked="False"
                                                  Background="Transparent"
                                                  BorderThickness="0"
                                                  Padding="8,4"
                                                  Click="ProfileSettingsExpandToggle_Click">
                                        <FontIcon x:Name="ProfileSettingsExpandIcon" Glyph="&#xE70D;" FontSize="13"/>
                                    </ToggleButton>
                                    </ctk:SettingsCard>
                                </Grid>

                                <!-- Collapsible Content -->
                                <StackPanel x:Name="ProfileSettingsContent" Visibility="Collapsed" Margin="0,12,0,0">
                                    <CheckBox x:Uid="ProfileSaveTDPCheckBox" x:Name="ProfileSaveTDPCheckBox"
                                              Content="TDP Power Limit"
                                              IsChecked="True"
                                              Foreground="#FFFFFF"
                                              Margin="0,4,0,0"
                                              Style="{StaticResource FocusableCheckBoxStyle}"
                                              Checked="ProfileSettingsCheckBox_Changed"
                                              Unchecked="ProfileSettingsCheckBox_Changed" />
                                    <TextBlock x:Uid="S_IncludesTDPBoostOnOff" Text="Includes TDP Boost (on/off, Fast +W, Peak +W)"
                                               FontSize="12"
                                               Foreground="#B9C0CC"
                                               Margin="28,2,0,0"
                                               TextWrapping="Wrap" />
                                    <CheckBox x:Uid="ProfileSaveCPUBoostCheckBox" x:Name="ProfileSaveCPUBoostCheckBox"
                                              Content="CPU Boost"
                                              IsChecked="True"
                                              Foreground="#FFFFFF"
                                              Margin="0,4,0,0"
                                              Style="{StaticResource FocusableCheckBoxStyle}"
                                              Checked="ProfileSettingsCheckBox_Changed"
                                              Unchecked="ProfileSettingsCheckBox_Changed" />
                                    <CheckBox x:Uid="ProfileSaveCPUEPPCheckBox" x:Name="ProfileSaveCPUEPPCheckBox"
                                              Content="CPU EPP"
                                              IsChecked="True"
                                              Foreground="#FFFFFF"
                                              Margin="0,4,0,0"
                                              Style="{StaticResource FocusableCheckBoxStyle}"
                                              Checked="ProfileSettingsCheckBox_Changed"
                                              Unchecked="ProfileSettingsCheckBox_Changed" />
                                    <CheckBox x:Uid="ProfileSaveCPUStateCheckBox" x:Name="ProfileSaveCPUStateCheckBox"
                                              Content="CPU State"
                                              IsChecked="True"
                                              Foreground="#FFFFFF"
                                              Margin="0,4,0,0"
                                              Style="{StaticResource FocusableCheckBoxStyle}"
                                              Checked="ProfileSettingsCheckBox_Changed"
                                              Unchecked="ProfileSettingsCheckBox_Changed" />
                                    <CheckBox x:Uid="ProfileSaveFPSLimitCheckBox" x:Name="ProfileSaveFPSLimitCheckBox"
                                              Content="FPS Limit"
                                              IsChecked="True"
                                              Foreground="#FFFFFF"
                                              Margin="0,4,0,0"
                                              Style="{StaticResource FocusableCheckBoxStyle}"
                                              Checked="ProfileSettingsCheckBox_Changed"
                                              Unchecked="ProfileSettingsCheckBox_Changed" />
                                    <CheckBox x:Uid="ProfileSaveOSPowerModeCheckBox" x:Name="ProfileSaveOSPowerModeCheckBox"
                                              Content="OS Power Mode"
                                              IsChecked="True"
                                              Foreground="#FFFFFF"
                                              Margin="0,4,0,0"
                                              Style="{StaticResource FocusableCheckBoxStyle}"
                                              Checked="ProfileSettingsCheckBox_Changed"
                                              Unchecked="ProfileSettingsCheckBox_Changed" />
                                    <CheckBox x:Uid="ProfileSaveOverlayLevelCheckBox" x:Name="ProfileSaveOverlayLevelCheckBox"
                                              Content="Overlay Level"
                                              IsChecked="False"
                                              Foreground="#FFFFFF"
                                              Margin="0,4,0,0"
                                              Style="{StaticResource FocusableCheckBoxStyle}"
                                              Checked="ProfileSettingsCheckBox_Changed"
                                              Unchecked="ProfileSettingsCheckBox_Changed" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Global Profile Section -->
                        <TextBlock x:Uid="S_GlobalProfile" Text="Global Profile" Style="{StaticResource SettingsSectionTitleStyle}" />

                        <!-- Global Profile Card -->
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <!-- Settings table — Win11-style info table, matching the Legion tab's
                                     Controller Information table (boxed on PageBackgroundBrush, thin
                                     separators between rows, Auto+* columns, SemiBold right-aligned values).
                                     No redundant title here — the "Global Profile" section header above
                                     this card already identifies it. -->

                                <!-- Simple Mode (Power Source Toggle OFF). Padding bottom=8 compensates
                                     for the last visible row's separator being hidden dynamically by
                                     UpdateLastVisibleSeparator (see GamingWidget.ProfileDisplay.cs) so a
                                     partially-filled profile (only some categories saved) doesn't show a
                                     stray separator flush against the box's bottom edge. -->
                                <Border x:Name="GlobalProfileSimple" Background="#2F3338" CornerRadius="6" Padding="12,2,12,8">
                                    <StackPanel>
                                        <StackPanel x:Name="GlobalProfileTDPModeRow" Visibility="Collapsed">
                                            <Grid Margin="0,8,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock x:Uid="S_TDPMode" Grid.Column="0" Text="TDP Mode" FontSize="13" Foreground="#B9C0CC" />
                                                <TextBlock x:Uid="GlobalProfileTDPModeText" Grid.Column="1" x:Name="GlobalProfileTDPModeText" Text="Balanced" FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFF" HorizontalAlignment="Right" />
                                            </Grid>
                                            <Border x:Name="GlobalProfileTDPModeSeparator" Height="1" Background="#22FFFFFF" Margin="0,8,0,0"/>
                                        </StackPanel>

                                        <StackPanel x:Name="GlobalProfileTDPRow" Visibility="Collapsed">
                                            <Grid Margin="0,8,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock x:Uid="S_TDP" Grid.Column="0" Text="TDP" FontSize="13" Foreground="#B9C0CC" />
                                                <TextBlock Grid.Column="1" x:Name="GlobalProfileTDPText" Text="15W" FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFF" HorizontalAlignment="Right"/>
                                            </Grid>
                                            <Border x:Name="GlobalProfileTDPSeparator" Height="1" Background="#22FFFFFF" Margin="0,8,0,0"/>
                                        </StackPanel>

                                        <StackPanel x:Name="GlobalProfileCPUBoostRow" Visibility="Collapsed">
                                            <Grid Margin="0,8,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock x:Uid="S_CPUBoost_2" Grid.Column="0" Text="CPU Boost" FontSize="13" Foreground="#B9C0CC" />
                                                <TextBlock x:Uid="GlobalProfileCPUBoostText" Grid.Column="1" x:Name="GlobalProfileCPUBoostText" Text="Off" FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFF" HorizontalAlignment="Right" />
                                            </Grid>
                                            <Border x:Name="GlobalProfileCPUBoostSeparator" Height="1" Background="#22FFFFFF" Margin="0,8,0,0"/>
                                        </StackPanel>

                                        <StackPanel x:Name="GlobalProfileCPUEPPRow" Visibility="Collapsed">
                                            <Grid Margin="0,8,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock x:Uid="S_CPUEPP" Grid.Column="0" Text="CPU EPP" FontSize="13" Foreground="#B9C0CC" />
                                                <TextBlock Grid.Column="1" x:Name="GlobalProfileCPUEPPText" Text="0" FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFF" HorizontalAlignment="Right"/>
                                            </Grid>
                                            <Border x:Name="GlobalProfileCPUEPPSeparator" Height="1" Background="#22FFFFFF" Margin="0,8,0,0"/>
                                        </StackPanel>

                                        <StackPanel x:Name="GlobalProfileCPUStateRow" Visibility="Collapsed">
                                            <Grid Margin="0,8,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock x:Uid="S_CPUState" Grid.Column="0" Text="CPU State" FontSize="13" Foreground="#B9C0CC" />
                                                <TextBlock Grid.Column="1" x:Name="GlobalProfileCPUStateText" Text="5-100%" FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFF" HorizontalAlignment="Right"/>
                                            </Grid>
                                            <Border x:Name="GlobalProfileCPUStateSeparator" Height="1" Background="#22FFFFFF" Margin="0,8,0,0"/>
                                        </StackPanel>

                                        <StackPanel x:Name="GlobalProfileFPSLimitRow" Visibility="Collapsed">
                                            <Grid Margin="0,8,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock x:Uid="S_FPSLimit" Grid.Column="0" Text="FPS Limit" FontSize="13" Foreground="#B9C0CC" />
                                                <TextBlock x:Uid="GlobalProfileFPSLimitText" Grid.Column="1" x:Name="GlobalProfileFPSLimitText" Text="Off" FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFF" HorizontalAlignment="Right" />
                                            </Grid>
                                            <Border x:Name="GlobalProfileFPSLimitSeparator" Height="1" Background="#22FFFFFF" Margin="0,8,0,0"/>
                                        </StackPanel>

                                        <StackPanel x:Name="GlobalProfilePowerModeRow" Visibility="Collapsed">
                                            <Grid Margin="0,8,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock x:Uid="S_PowerMode" Grid.Column="0" Text="Power Mode" FontSize="13" Foreground="#B9C0CC" />
                                                <TextBlock x:Uid="GlobalProfilePowerModeText" Grid.Column="1" x:Name="GlobalProfilePowerModeText" Text="Balanced" FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFF" HorizontalAlignment="Right" />
                                            </Grid>
                                            <Border x:Name="GlobalProfilePowerModeSeparator" Height="1" Background="#22FFFFFF" Margin="0,8,0,0"/>
                                        </StackPanel>

                                        <StackPanel x:Name="GlobalProfileOverlayLevelRow" Visibility="Collapsed">
                                            <Grid Margin="0,8,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock x:Uid="S_OverlayLevel" Grid.Column="0" Text="Overlay Level" FontSize="13" Foreground="#B9C0CC" />
                                                <TextBlock x:Uid="GlobalProfileOverlayLevelText" Grid.Column="1" x:Name="GlobalProfileOverlayLevelText" Text="Off" FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFF" HorizontalAlignment="Right" />
                                            </Grid>
                                            <Border x:Name="GlobalProfileOverlayLevelSeparator" Height="1" Background="#22FFFFFF" Margin="0,8,0,0"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- AC/DC Mode (Power Source Toggle ON) -->
                                <Border x:Name="GlobalProfileACDC" Background="#2F3338" CornerRadius="6" Padding="12,2,12,8" Margin="0,8,0,0" Visibility="Collapsed">
                                    <StackPanel>
                                        <!-- Header. Label column (col0) is a fixed pixel width, not Auto —
                                             an Auto column can be squeezed by the Grid's star-sizing pass
                                             once the AC+DC columns need more room than the panel has, which
                                             is what clipped the label text; a fixed width guarantees it. -->
                                        <Grid Margin="0,8,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="84"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="" FontSize="13" Foreground="#B9C0CC"/>
                                            <TextBlock x:Uid="S_AC" Grid.Column="1" Text="AC" FontSize="13" FontWeight="SemiBold" Foreground="#FFD700" HorizontalAlignment="Center" />
                                            <TextBlock x:Uid="S_DC" Grid.Column="2" Text="DC" FontSize="13" FontWeight="SemiBold" Foreground="#FF6B6B" HorizontalAlignment="Center" />
                                        </Grid>
                                        <Border Height="1" Background="#22FFFFFF" Margin="0,8,0,0"/>

                                        <!-- TDP Mode Row (Legion only) -->
                                        <StackPanel x:Name="ACDCProfileTDPModeRow" Visibility="Collapsed">
                                            <Grid Margin="0,8,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="84"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock x:Uid="S_TDPMode" Grid.Column="0" Text="TDP Mode" FontSize="13" Foreground="#B9C0CC" />
                                                <TextBlock x:Uid="ACProfileTDPModeText" Grid.Column="1" x:Name="ACProfileTDPModeText" Text="Balanced" FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFF" HorizontalAlignment="Center" />
                                                <TextBlock x:Uid="DCProfileTDPModeText" Grid.Column="2" x:Name="DCProfileTDPModeText" Text="Balanced" FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFF" HorizontalAlignment="Center" />
                                            </Grid>
                                            <Border x:Name="ACDCProfileTDPModeSeparator" Height="1" Background="#22FFFFFF" Margin="0,8,0,0"/>
                                        </StackPanel>

                                        <!-- TDP Row -->
                                        <StackPanel x:Name="ACDCProfileTDPRow" Visibility="Collapsed">
                                            <Grid Margin="0,8,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="84"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock x:Uid="S_TDP" Grid.Column="0" Text="TDP" FontSize="13" Foreground="#B9C0CC" />
                                                <TextBlock Grid.Column="1" x:Name="ACProfileTDPText" Text="15W" FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFF" HorizontalAlignment="Center"/>
                                                <TextBlock Grid.Column="2" x:Name="DCProfileTDPText" Text="15W" FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFF" HorizontalAlignment="Center"/>
                                            </Grid>
                                            <Border x:Name="ACDCProfileTDPSeparator" Height="1" Background="#22FFFFFF" Margin="0,8,0,0"/>
                                        </StackPanel>

                                        <!-- CPU Boost Row -->
                                        <StackPanel x:Name="ACDCProfileCPUBoostRow" Visibility="Collapsed">
                                            <Grid Margin="0,8,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="84"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock x:Uid="S_CPUBoost_2" Grid.Column="0" Text="CPU Boost" FontSize="13" Foreground="#B9C0CC" />
                                                <TextBlock x:Uid="ACProfileCPUBoostText" Grid.Column="1" x:Name="ACProfileCPUBoostText" Text="Off" FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFF" HorizontalAlignment="Center" />
                                                <TextBlock x:Uid="DCProfileCPUBoostText" Grid.Column="2" x:Name="DCProfileCPUBoostText" Text="Off" FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFF" HorizontalAlignment="Center" />
                                            </Grid>
                                            <Border x:Name="ACDCProfileCPUBoostSeparator" Height="1" Background="#22FFFFFF" Margin="0,8,0,0"/>
                                        </StackPanel>

                                        <!-- CPU EPP Row -->
                                        <StackPanel x:Name="ACDCProfileCPUEPPRow" Visibility="Collapsed">
                                            <Grid Margin="0,8,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="84"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock x:Uid="S_CPUEPP" Grid.Column="0" Text="CPU EPP" FontSize="13" Foreground="#B9C0CC" />
                                                <TextBlock Grid.Column="1" x:Name="ACProfileCPUEPPText" Text="0" FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFF" HorizontalAlignment="Center"/>
                                                <TextBlock Grid.Column="2" x:Name="DCProfileCPUEPPText" Text="0" FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFF" HorizontalAlignment="Center"/>
                                            </Grid>
                                            <Border x:Name="ACDCProfileCPUEPPSeparator" Height="1" Background="#22FFFFFF" Margin="0,8,0,0"/>
                                        </StackPanel>

                                        <!-- CPU Clock Row -->
                                        <StackPanel x:Name="ACDCProfileCPUStateRow" Visibility="Collapsed">
                                            <Grid Margin="0,8,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="84"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock x:Uid="S_CPUState" Grid.Column="0" Text="CPU State" FontSize="13" Foreground="#B9C0CC" />
                                                <TextBlock Grid.Column="1" x:Name="ACProfileCPUStateText" Text="5-100%" FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFF" HorizontalAlignment="Center"/>
                                                <TextBlock Grid.Column="2" x:Name="DCProfileCPUStateText" Text="5-100%" FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFF" HorizontalAlignment="Center"/>
                                            </Grid>
                                            <Border x:Name="ACDCProfileCPUStateSeparator" Height="1" Background="#22FFFFFF" Margin="0,8,0,0"/>
                                        </StackPanel>

                                        <!-- FPS Limit Row -->
                                        <StackPanel x:Name="ACDCProfileFPSLimitRow" Visibility="Collapsed">
                                            <Grid Margin="0,8,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="84"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock x:Uid="S_FPSLimit" Grid.Column="0" Text="FPS Limit" FontSize="13" Foreground="#B9C0CC" />
                                                <TextBlock x:Uid="ACProfileFPSLimitText" Grid.Column="1" x:Name="ACProfileFPSLimitText" Text="Off" FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFF" HorizontalAlignment="Center" />
                                                <TextBlock x:Uid="DCProfileFPSLimitText" Grid.Column="2" x:Name="DCProfileFPSLimitText" Text="Off" FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFF" HorizontalAlignment="Center" />
                                            </Grid>
                                            <Border x:Name="ACDCProfileFPSLimitSeparator" Height="1" Background="#22FFFFFF" Margin="0,8,0,0"/>
                                        </StackPanel>

                                        <!-- Power Mode Row -->
                                        <StackPanel x:Name="ACDCProfilePowerModeRow" Visibility="Collapsed">
                                            <Grid Margin="0,8,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="84"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock x:Uid="S_PowerMode" Grid.Column="0" Text="Power Mode" FontSize="13" Foreground="#B9C0CC" />
                                                <TextBlock x:Uid="ACProfilePowerModeText" Grid.Column="1" x:Name="ACProfilePowerModeText" Text="Balanced" FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFF" HorizontalAlignment="Center" />
                                                <TextBlock x:Uid="DCProfilePowerModeText" Grid.Column="2" x:Name="DCProfilePowerModeText" Text="Balanced" FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFF" HorizontalAlignment="Center" />
                                            </Grid>
                                            <Border x:Name="ACDCProfilePowerModeSeparator" Height="1" Background="#22FFFFFF" Margin="0,8,0,0"/>
                                        </StackPanel>

                                        <!-- Overlay Level Row -->
                                        <StackPanel x:Name="ACDCProfileOverlayLevelRow" Visibility="Collapsed">
                                            <Grid Margin="0,8,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="84"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock x:Uid="S_Overlay" Grid.Column="0" Text="Overlay" FontSize="13" Foreground="#B9C0CC" />
                                                <TextBlock x:Uid="ACProfileOverlayLevelText" Grid.Column="1" x:Name="ACProfileOverlayLevelText" Text="Off" FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFF" HorizontalAlignment="Center" />
                                                <TextBlock x:Uid="DCProfileOverlayLevelText" Grid.Column="2" x:Name="DCProfileOverlayLevelText" Text="Off" FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFF" HorizontalAlignment="Center" />
                                            </Grid>
                                            <Border x:Name="ACDCProfileOverlayLevelSeparator" Height="1" Background="#22FFFFFF" Margin="0,8,0,0"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Game Profile Card (shown when game is detected) -->

                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <!-- Game Profile without Power Source -->
                                <StackPanel x:Name="GameProfileWithoutPowerSource" Visibility="Collapsed">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0"
                                                    Orientation="Horizontal"
                                                    Spacing="8"
                                                    VerticalAlignment="Center">
                                            <Border Background="#005C2E"
                                                    CornerRadius="10"
                                                    Padding="6,1,6,1"
                                                    VerticalAlignment="Center">
                                                <TextBlock x:Uid="S_NowPlaying" Text="Now Playing"
                                                           FontSize="12"
                                                           FontWeight="SemiBold"
                                                           Foreground="#A8FFC9" />
                                            </Border>
                                            <TextBlock x:Uid="GameProfileTitleNoPower" x:Name="GameProfileTitleNoPower"
                                                       Text="Game"
                                                       Style="{StaticResource CardTitleStyle}"
                                                       Foreground="#FFA500"
                                                       FontSize="14"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <Button x:Name="DeleteActiveProfileButtonNoPower"
                                                Grid.Column="1"
                                                Content="&#xE74D;"
                                                FontFamily="Segoe Fluent Icons"
                                                AutomationProperties.Name="Delete profile"
                                                FontSize="16"
                                                Width="40"
                                                Height="40"
                                                Padding="0"
                                                Background="#64FF0000"
                                                Foreground="White"
                                                BorderBrush="Transparent"
                                                BorderThickness="2"
                                                VerticalAlignment="Center"
                                                Click="DeleteActiveProfileButton_Click"/>
                                    </Grid>

                                    <!-- Settings table — Win11-style info table, matching the Legion tab's
                                         Controller Information table (boxed on PageBackgroundBrush, thin
                                         separators between rows, Auto+* columns, SemiBold right-aligned values).
                                         Padding bottom=8 compensates for the last visible row's separator
                                         being hidden dynamically by UpdateLastVisibleSeparator (see
                                         GamingWidget.ProfileDisplay.cs), since not every category is
                                         necessarily saved for a given game. -->
                                    <Border Background="#2F3338" CornerRadius="6" Padding="12,2,12,8" Margin="0,10,0,0">
                                        <StackPanel>
                                            <StackPanel x:Name="GameProfileTDPModeRow" Visibility="Collapsed">
                                                <Grid Margin="0,8,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock x:Uid="S_TDPMode" Grid.Column="0" Text="TDP Mode" FontSize="13" Foreground="#B9C0CC" />
                                                    <TextBlock x:Uid="GameProfileTDPModeText" Grid.Column="1" x:Name="GameProfileTDPModeText" Text="Balanced" FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFF" HorizontalAlignment="Right" />
                                                </Grid>
                                                <Border x:Name="GameProfileTDPModeSeparator" Height="1" Background="#22FFFFFF" Margin="0,8,0,0"/>
                                            </StackPanel>

                                            <StackPanel x:Name="GameProfileTDPRow" Visibility="Collapsed">
                                                <Grid Margin="0,8,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock x:Uid="S_TDP" Grid.Column="0" Text="TDP" FontSize="13" Foreground="#B9C0CC" />
                                                    <TextBlock Grid.Column="1" x:Name="GameProfileTDPText" Text="15W" FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFF" HorizontalAlignment="Right"/>
                                                </Grid>
                                                <Border x:Name="GameProfileTDPSeparator" Height="1" Background="#22FFFFFF" Margin="0,8,0,0"/>
                                            </StackPanel>

                                            <StackPanel x:Name="GameProfileCPUBoostRow" Visibility="Collapsed">
                                                <Grid Margin="0,8,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock x:Uid="S_CPUBoost_2" Grid.Column="0" Text="CPU Boost" FontSize="13" Foreground="#B9C0CC" />
                                                    <TextBlock x:Uid="GameProfileCPUBoostText" Grid.Column="1" x:Name="GameProfileCPUBoostText" Text="Off" FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFF" HorizontalAlignment="Right" />
                                                </Grid>
                                                <Border x:Name="GameProfileCPUBoostSeparator" Height="1" Background="#22FFFFFF" Margin="0,8,0,0"/>
                                            </StackPanel>

                                            <StackPanel x:Name="GameProfileCPUEPPRow" Visibility="Collapsed">
                                                <Grid Margin="0,8,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock x:Uid="S_CPUEPP" Grid.Column="0" Text="CPU EPP" FontSize="13" Foreground="#B9C0CC" />
                                                    <TextBlock Grid.Column="1" x:Name="GameProfileCPUEPPText" Text="0" FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFF" HorizontalAlignment="Right"/>
                                                </Grid>
                                                <Border x:Name="GameProfileCPUEPPSeparator" Height="1" Background="#22FFFFFF" Margin="0,8,0,0"/>
                                            </StackPanel>

                                            <StackPanel x:Name="GameProfileCPUStateRow" Visibility="Collapsed">
                                                <Grid Margin="0,8,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock x:Uid="S_CPUState" Grid.Column="0" Text="CPU State" FontSize="13" Foreground="#B9C0CC" />
                                                    <TextBlock Grid.Column="1" x:Name="GameProfileCPUStateText" Text="5-100%" FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFF" HorizontalAlignment="Right"/>
                                                </Grid>
                                                <Border x:Name="GameProfileCPUStateSeparator" Height="1" Background="#22FFFFFF" Margin="0,8,0,0"/>
                                            </StackPanel>

                                            <StackPanel x:Name="GameProfileFPSLimitRow" Visibility="Collapsed">
                                                <Grid Margin="0,8,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock x:Uid="S_FPSLimit" Grid.Column="0" Text="FPS Limit" FontSize="13" Foreground="#B9C0CC" />
                                                    <TextBlock x:Uid="GameProfileFPSLimitText" Grid.Column="1" x:Name="GameProfileFPSLimitText" Text="Off" FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFF" HorizontalAlignment="Right" />
                                                </Grid>
                                                <Border x:Name="GameProfileFPSLimitSeparator" Height="1" Background="#22FFFFFF" Margin="0,8,0,0"/>
                                            </StackPanel>

                                            <StackPanel x:Name="GameProfilePowerModeRow" Visibility="Collapsed">
                                                <Grid Margin="0,8,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock x:Uid="S_PowerMode" Grid.Column="0" Text="Power Mode" FontSize="13" Foreground="#B9C0CC" />
                                                    <TextBlock x:Uid="GameProfilePowerModeText" Grid.Column="1" x:Name="GameProfilePowerModeText" Text="Balanced" FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFF" HorizontalAlignment="Right" />
                                                </Grid>
                                                <Border x:Name="GameProfilePowerModeSeparator" Height="1" Background="#22FFFFFF" Margin="0,8,0,0"/>
                                            </StackPanel>

                                            <StackPanel x:Name="GameProfileOverlayLevelRow" Visibility="Collapsed">
                                                <Grid Margin="0,8,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock x:Uid="S_OverlayLevel" Grid.Column="0" Text="Overlay Level" FontSize="13" Foreground="#B9C0CC" />
                                                    <TextBlock x:Uid="GameProfileOverlayLevelText" Grid.Column="1" x:Name="GameProfileOverlayLevelText" Text="Off" FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFF" HorizontalAlignment="Right" />
                                                </Grid>
                                                <Border x:Name="GameProfileOverlayLevelSeparator" Height="1" Background="#22FFFFFF" Margin="0,8,0,0"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Saved Profiles Section -->
                        <Grid Margin="0,24,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Uid="S_SavedProfiles" Text="Saved Profiles"
                                       FontSize="14"
                                       Foreground="White"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                            <!--
                                Sort dropdown for the saved-profiles list. Selection is
                                persisted to LocalSettings["ProfileSortMode"] so it
                                survives across widget re-opens. Tags are read by the
                                C# code-behind in UpdateAllGameProfilesDisplay to drive
                                ordering.
                            -->
                            <ComboBox x:Name="ProfileSortComboBox"
                                      Grid.Column="1"
                                      Width="150"
                                      SelectionChanged="ProfileSortComboBox_SelectionChanged"
                                      Style="{StaticResource ModernComboBoxStyle}">
                                <ComboBoxItem x:Uid="S_NameAZ" Tag="name" Content="Name (A→Z)" IsSelected="True" />
                                <ComboBoxItem x:Uid="S_LastModified" Tag="modified" Content="Last Modified" />
                                <ComboBoxItem x:Uid="S_TDPHighLow" Tag="tdp" Content="TDP (high → low)" />
                            </ComboBox>
                        </Grid>

                        <!-- Container for dynamically created game profile cards -->
                        <StackPanel x:Name="AllGameProfilesContainer"/>

                    </StackPanel>
                </ScrollViewer>

                <!-- SYSTEM TAB -->
                <ScrollViewer x:Name="SystemScrollViewer" VerticalScrollBarVisibility="Auto" Visibility="Collapsed"
                              BringIntoViewOnFocusChange="True">
                    <StackPanel Padding="16,8,16,16">

                        <!-- OSD Customization Card (Collapsible) -->
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <!-- Header with Expand/Collapse -->
                                <Grid Background="Transparent" Tapped="ExpandHeader_Tapped">
                                    <ctk:SettingsCard Style="{StaticResource HeaderRowStyle}">
                                        <ctk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE9D9;"/></ctk:SettingsCard.HeaderIcon>
                                        <ctk:SettingsCard.Header>
                                            <TextBlock x:Uid="S_OSDCustomization" Text="OSD Customization" />
                                        </ctk:SettingsCard.Header>
                                        <ctk:SettingsCard.Description>
                                            <TextBlock x:Uid="S_CustomizeOverlayAppearanceAndContent" Text="Customize overlay appearance and content" TextWrapping="Wrap" />
                                        </ctk:SettingsCard.Description>
                                        <ToggleButton x:Name="OSDCustomizeExpandButton" MinWidth="44" MinHeight="40"
                                                  IsChecked="False"
                                                  Background="Transparent"
                                                  BorderThickness="0"
                                                  Padding="8,4"
                                                  Click="OSDCustomizeExpandButton_Click"
                                                  XYFocusUp="{x:Bind SystemNavItem}"
                                                  UseSystemFocusVisuals="True">
                                        <FontIcon x:Name="OSDCustomizeExpandIcon" Glyph="&#xE70D;" FontSize="13"/>
                                    </ToggleButton>
                                    </ctk:SettingsCard>
                                </Grid>

                                <!-- Collapsible Content -->
                                <StackPanel x:Name="OSDCustomizeContent" Visibility="Collapsed" Margin="0,12,0,0">

                                    <!-- OSD Provider Selection -->
                                    <ctk:SettingsCard x:Uid="S_OSDProvider" Margin="0,0,0,12" Header="OSD Provider" Description="Select overlay source">
                                        <ctk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE9D9;"/></ctk:SettingsCard.HeaderIcon>
                                        <ComboBox x:Name="OSDProviderComboBox"
                                        Style="{StaticResource ModernComboBoxStyle}"
                                        Width="120"
                                        SelectionChanged="OSDProviderComboBox_SelectionChanged"
                                        UseSystemFocusVisuals="True"
                                        FocusVisualPrimaryBrush="White"
                                        FocusVisualSecondaryBrush="Transparent">
                                        <ComboBoxItem Content="RTSS" Tag="0" IsSelected="True"/>
                                        <ComboBoxItem Content="AMD" Tag="1"/>
                                        </ComboBox>
                                    </ctk:SettingsCard>

                                    <!-- RTSS-specific options (hidden when AMD provider is selected) -->
                                    <StackPanel x:Name="RTSSOptionsPanel">
                                        <!-- Layout Settings Section -->
                                    <Border Height="1" Background="#33FFFFFF" Margin="0,4,0,12"/>
                                    <TextBlock x:Uid="S_Layout" Text="Layout"
                                               FontSize="14" FontWeight="SemiBold" Foreground="#B9C0CC"
                                               Margin="0,0,0,8" />
                                    <ComboBox x:Uid="OSDPresetComboBox" x:Name="OSDPresetComboBox" Header="Preset"
                                              Style="{StaticResource ModernComboBoxStyle}" HorizontalAlignment="Stretch"
                                              Margin="0,0,0,8" SelectedIndex="0" SelectionChanged="OSDPreset_Changed">
                                        <ComboBoxItem x:Uid="S_Custom" Content="Custom" Tag="Custom" />
                                        <ComboBoxItem x:Uid="S_Basic" Content="Basic" Tag="Basic" />
                                        <ComboBoxItem x:Uid="S_Detailed" Content="Detailed" Tag="Detailed" />
                                        <ComboBoxItem x:Uid="S_Full" Content="Full" Tag="Full" />
                                        <ComboBoxItem x:Uid="S_Original" Content="Original" Tag="Original" />
                                    </ComboBox>
                                    <TextBlock x:Uid="S_ColumnsItemSelectionAndOrder" Text="Columns, item selection and order are used by Custom."
                                               Style="{StaticResource CardCaptionStyle}" TextWrapping="Wrap" Margin="0,0,0,8" />

                                    <!-- Style: Modern (calmer type, soft colors, fixed-width numbers) or Classic -->
                                    <ctk:SettingsCard x:Uid="S_ModernStyle" Margin="0,0,0,8" Header="Modern style" Description="Small labels and units, soft colors, steady numbers. Off = classic look." Tapped="ToggleRow_Tapped">
                                        <ctk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE9D9;"/></ctk:SettingsCard.HeaderIcon>
                                        <ToggleSwitch x:Name="OSDModernStyleToggle"
                                        Style="{StaticResource ModernToggleStyle}"
                                        IsOn="True"
                                        Toggled="OSDModernStyleToggle_Toggled"/>
                                    </ctk:SettingsCard>

                                    <!-- Columns -->
                                    <ctk:SettingsCard x:Uid="S_Columns_2" Margin="0,0,0,8" Header="Columns" Description="Items per row (1 = vertical list)">
                                        <ctk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE713;"/></ctk:SettingsCard.HeaderIcon>
                                        <ComboBox x:Name="OSDColumnsComboBox"
                                        Style="{StaticResource ModernComboBoxStyle}"
                                        Width="80"
                                        SelectionChanged="OSDLayoutOption_Changed"
                                        UseSystemFocusVisuals="True"
                                        FocusVisualPrimaryBrush="White">
                                        <ComboBoxItem Content="1" Tag="1"/>
                                        <ComboBoxItem Content="2" Tag="2"/>
                                        <ComboBoxItem Content="3" Tag="3" IsSelected="True"/>
                                        <ComboBoxItem Content="4" Tag="4"/>
                                        <ComboBoxItem Content="5" Tag="5"/>
                                        <ComboBoxItem Content="6" Tag="6"/>
                                        <ComboBoxItem Content="7" Tag="7"/>
                                        <ComboBoxItem Content="8" Tag="8"/>
                                        <ComboBoxItem Content="9" Tag="9"/>
                                        <ComboBoxItem Content="10" Tag="10"/>
                                        </ComboBox>
                                    </ctk:SettingsCard>

                                    <!-- Text Size -->
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Uid="S_TextSize" Text="Text Size"
                                                   Foreground="#B9C0CC"
                                                   VerticalAlignment="Center"
                                                   FontSize="14" />
                                        <ComboBox x:Name="OSDTextSizeComboBox"
                                                  Style="{StaticResource ModernComboBoxStyle}"
                                                  Width="100"
                                                  Grid.Column="1"
                                                  SelectionChanged="OSDLayoutOption_Changed"
                                                  UseSystemFocusVisuals="True"
                                                  FocusVisualPrimaryBrush="White">
                                            <ComboBoxItem x:Uid="S_Small" Content="Small" Tag="50" />
                                            <ComboBoxItem x:Uid="S_Medium" Content="Medium" Tag="100" IsSelected="True" />
                                            <ComboBoxItem x:Uid="S_Large" Content="Large" Tag="150" />
                                            <ComboBoxItem x:Uid="S_XLarge" Content="X-Large" Tag="200" />
                                            <ComboBoxItem x:Uid="S_XXLarge" Content="XX-Large" Tag="250" />
                                            <ComboBoxItem x:Uid="S_XXXLarge" Content="XXX-Large" Tag="300" />
                                        </ComboBox>
                                    </Grid>

                                    <!-- Colors Section -->
                                    <Border Height="1" Background="#33FFFFFF" Margin="0,8,0,12"/>
                                    <TextBlock x:Uid="S_Colors" Text="Colors"
                                               FontSize="14" FontWeight="SemiBold" Foreground="#B9C0CC"
                                               Margin="0,0,0,8" />

                                    <!-- Text Color -->
                                    <StackPanel x:Name="OSDTextColorCard" Margin="0,0,0,8">
                                        <Grid Background="Transparent" MinHeight="48" Tapped="ExpandHeader_Tapped">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:Uid="S_TextColor" Text="Text Color" Grid.Column="0" VerticalAlignment="Center" Foreground="#B9C0CC" FontSize="14" />
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                <CheckBox x:Uid="OSDTextColorDynamicCheckBox" x:Name="OSDTextColorDynamicCheckBox"
                                                          Content="Dynamic"
                                                          IsChecked="True"
                                                          Foreground="#B9C0CC"
                                                          FontSize="12"
                                                          Margin="0,0,8,0"
                                                          Checked="OSDTextColorDynamic_Changed"
                                                          Unchecked="OSDTextColorDynamic_Changed" />
                                                <Border x:Name="OSDTextColorPreview"
                                                        Width="24" Height="24"
                                                        CornerRadius="4"
                                                        Background="White"
                                                        BorderBrush="#50555C"
                                                        BorderThickness="1"
                                                        Margin="0,0,8,0"/>
                                                <Button x:Name="OSDTextColorExpandButton" MinWidth="44" MinHeight="40"
                                                        Content="&#xE70D;"
                                                        FontFamily="Segoe MDL2 Assets"
                                                        FontSize="13"
                                                        Padding="8,4"
                                                        Background="Transparent"
                                                        Click="OSDTextColorExpandButton_Click"
                                                        UseSystemFocusVisuals="True"
                                                        FocusVisualPrimaryBrush="White"/>
                                            </StackPanel>
                                        </Grid>
                                        <muxc:ColorPicker x:Name="OSDTextColorPicker"
                                                     Visibility="Collapsed"
                                                     Margin="0,12,0,0"
                                                     Color="White"
                                                     ColorSpectrumShape="Box"
                                                     IsMoreButtonVisible="False"
                                                     IsColorSliderVisible="False"
                                                     IsColorChannelTextInputVisible="False"
                                                     IsHexInputVisible="False"
                                                     IsAlphaEnabled="False"
                                                     IsAlphaSliderVisible="False"
                                                     IsAlphaTextInputVisible="False"
                                                     ColorChanged="OSDTextColorPicker_ColorChanged"/>
                                    </StackPanel>

                                    <!-- Label Color (Global) -->
                                    <StackPanel x:Name="OSDLabelColorCard" Margin="0,0,0,8">
                                        <Grid Background="Transparent" MinHeight="48" Tapped="ExpandHeader_Tapped">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:Uid="S_LabelColor" Text="Label Color" Grid.Column="0" VerticalAlignment="Center" Foreground="#B9C0CC" FontSize="14" />
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                <CheckBox x:Uid="OSDLabelColorDefaultCheckBox" x:Name="OSDLabelColorDefaultCheckBox"
                                                          Content="Default"
                                                          IsChecked="True"
                                                          Foreground="#B9C0CC"
                                                          FontSize="12"
                                                          Margin="0,0,8,0"
                                                          Checked="OSDLabelColorDefault_Changed"
                                                          Unchecked="OSDLabelColorDefault_Changed" />
                                                <Border x:Name="OSDLabelColorPreview"
                                                        Width="24" Height="24"
                                                        CornerRadius="4"
                                                        Background="#00FFFF"
                                                        BorderBrush="#50555C"
                                                        BorderThickness="1"
                                                        Margin="0,0,8,0"/>
                                                <Button x:Name="OSDLabelColorExpandButton" MinWidth="44" MinHeight="40"
                                                        Content="&#xE70D;"
                                                        FontFamily="Segoe MDL2 Assets"
                                                        FontSize="13"
                                                        Padding="8,4"
                                                        Background="Transparent"
                                                        Click="OSDLabelColorExpandButton_Click"
                                                        UseSystemFocusVisuals="True"
                                                        FocusVisualPrimaryBrush="White"/>
                                            </StackPanel>
                                        </Grid>
                                        <muxc:ColorPicker x:Name="OSDLabelColorPicker"
                                                     Visibility="Collapsed"
                                                     Margin="0,12,0,0"
                                                     Color="#00FFFF"
                                                     ColorSpectrumShape="Box"
                                                     IsMoreButtonVisible="False"
                                                     IsColorSliderVisible="False"
                                                     IsColorChannelTextInputVisible="False"
                                                     IsHexInputVisible="False"
                                                     IsAlphaEnabled="False"
                                                     IsAlphaSliderVisible="False"
                                                     IsAlphaTextInputVisible="False"
                                                     ColorChanged="OSDLabelColorPicker_ColorChanged"/>
                                    </StackPanel>

                                    <!-- OSD Opacity Slider (for OLED protection) -->
                                    <StackPanel Margin="0,8,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:Uid="S_OSDOpacity" Grid.Column="0" Text="OSD Opacity" VerticalAlignment="Center" Foreground="#B9C0CC" FontSize="14" />
                                            <TextBlock x:Name="OSDOpacityValue"
                                                       Grid.Column="1"
                                                       Text="50%" FontSize="14" Foreground="{StaticResource SystemAccentBrush}"
                                                       FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        </Grid>
                                        <TextBlock x:Uid="S_ReduceOSDBrightnessToProtect" Text="Reduce OSD brightness to protect OLED pixels" Foreground="#B9C0CC" FontSize="12" Margin="0,2,0,4" />
                                        <Slider x:Name="OSDOpacitySlider"
                                                Style="{StaticResource ModernSliderStyle}"
                                                Minimum="10" Maximum="100"
                                                TickFrequency="5"
                                                SnapsTo="Ticks"
                                                Value="50"
                                                ValueChanged="OSDOpacitySlider_ValueChanged"/>
                                    </StackPanel>

                                    <!-- Position Shift Toggle (OLED burn-in protection) -->
                                    <ctk:SettingsCard x:Uid="S_PositionShift" Margin="0,4,0,8" Header="Position Shift" Description="Shifts OSD every minute to prevent burn-in" Tapped="ToggleRow_Tapped">
                                        <ctk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE9D9;"/></ctk:SettingsCard.HeaderIcon>
                                        <ToggleSwitch x:Name="OSDPositionShiftToggle"
                                        Style="{StaticResource ModernToggleStyle}"
                                        Toggled="OSDPositionShiftToggle_Toggled"/>
                                    </ctk:SettingsCard>

                                    <!-- Frametime Graph Pinned Toggle -->
                                    <ctk:SettingsCard x:Uid="S_PinFrametimeGraph" Margin="0,4,0,8" Header="Pin Frametime Graph" Description="Always display graph on its own row at bottom" Tapped="ToggleRow_Tapped">
                                        <ctk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE9D9;"/></ctk:SettingsCard.HeaderIcon>
                                        <ToggleSwitch x:Name="FrametimeGraphPinnedToggle"
                                        Style="{StaticResource ModernToggleStyle}"
                                        Toggled="FrametimeGraphPinnedToggle_Toggled"/>
                                    </ctk:SettingsCard>

                                        <!-- Items Section -->
                                        <Border Height="1" Background="#33FFFFFF" Margin="0,8,0,12"/>
                                        <TextBlock x:Uid="S_ItemsToDisplay" Text="Items to Display"
                                                   FontSize="14" FontWeight="SemiBold" Foreground="#B9C0CC"
                                                   Margin="0,0,0,8" />

                                        <!-- OSD Items with reordering -->
                                        <ItemsControl x:Name="OSDItemsControl">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,2">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>

                                                        <CheckBox Grid.Column="0"
                                                                  Content="{Binding DisplayName}"
                                                                  IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                                                  Foreground="#B9C0CC"
                                                                  Tag="{Binding Id}"
                                                                  UseSystemFocusVisuals="True"
                                                                  FocusVisualPrimaryBrush="White"
                                                                  FocusVisualSecondaryBrush="Transparent"
                                                                  Checked="OSDItemCheckBox_Changed"
                                                                  Unchecked="OSDItemCheckBox_Changed"/>

                                                        <Button Grid.Column="1"
                                                                Content="&#xE70E;"
                                                                FontFamily="Segoe MDL2 Assets"
                                                                FontSize="12"
                                                                Width="40" Height="40"
                                                                Padding="0"
                                                                Margin="4,0,0,0"
                                                                Background="Transparent"
                                                                Tag="{Binding Id}"
                                                                IsEnabled="{Binding CanMoveUp}"
                                                                Click="OSDItemMoveUp_Click"/>

                                                        <Button Grid.Column="2"
                                                                Content="&#xE70D;"
                                                                FontFamily="Segoe MDL2 Assets"
                                                                FontSize="12"
                                                                Width="40" Height="40"
                                                                Padding="0"
                                                                Margin="4,0,0,0"
                                                                Background="Transparent"
                                                                Tag="{Binding Id}"
                                                                IsEnabled="{Binding CanMoveDown}"
                                                                Click="OSDItemMoveDown_Click"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <!-- Custom RTSS Tags Section -->
                                        <Border Height="1" Background="#33FFFFFF" Margin="0,12,0,12"/>
                                        <TextBlock x:Uid="S_CustomRTSSTags" Text="Custom RTSS Tags"
                                                   FontSize="14" FontWeight="SemiBold" Foreground="#B9C0CC"
                                                   Margin="0,0,0,4" />
                                        <TextBlock x:Uid="S_AddCustomRTSSTagsE" Text="Add custom RTSS tags (e.g. &lt;FR&gt; for FPS)"
                                                   Style="{StaticResource CardCaptionStyle}"
                                                   Margin="0,0,0,8" />
                                        <TextBox x:Uid="OSDCustomTagsTextBox" x:Name="OSDCustomTagsTextBox"
                                                 PlaceholderText="Enter custom RTSS tags..."
                                                 TextWrapping="Wrap"
                                                 AcceptsReturn="True"
                                                 Height="60"
                                                 TextChanged="OSDCustomTagsTextBox_TextChanged" />
                                    </StackPanel>

                                    <!-- AMD-specific info (shown when AMD provider is selected) -->
                                    <StackPanel x:Name="AMDOptionsPanel" Visibility="Collapsed">
                                        <TextBlock x:Uid="S_AMDAdrenalineOverlay" Text="AMD Adrenaline Overlay"
                                                   FontSize="14" FontWeight="SemiBold" Foreground="#B9C0CC"
                                                   Margin="0,0,0,8" />
                                        <TextBlock x:Uid="S_TheAMDOverlayIsControlled" Text="The AMD overlay is controlled through Adrenaline software. Use Ctrl+Shift+O to toggle and Ctrl+Shift+X to cycle overlay levels."
                                                   Foreground="#B9C0CC"
                                                   FontSize="13"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Hotkeys Card (Collapsible) - Xbox Controller Button Combos -->
                        <Border x:Name="HotkeysCard" Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <!-- Header with Expand/Collapse -->
                                <Grid Background="Transparent" Tapped="ExpandHeader_Tapped">
                                    <ctk:SettingsCard Style="{StaticResource HeaderRowStyle}">
                                        <ctk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE765;"/></ctk:SettingsCard.HeaderIcon>
                                        <ctk:SettingsCard.Header>
                                            <TextBlock x:Uid="S_Hotkeys" Text="Hotkeys" />
                                        </ctk:SettingsCard.Header>
                                        <ctk:SettingsCard.Description>
                                            <TextBlock x:Uid="HotkeysSummary" x:Name="HotkeysSummary" Text="Map controller combos to keyboard shortcuts" TextWrapping="Wrap" />
                                        </ctk:SettingsCard.Description>
                                        <ToggleButton x:Name="HotkeysExpandButton" MinWidth="44" MinHeight="40"
                                                  IsChecked="False"
                                                  Background="Transparent"
                                                  BorderThickness="0"
                                                  Padding="8,4"
                                                  Click="HotkeysExpandButton_Click"
                                                  UseSystemFocusVisuals="True">
                                        <FontIcon x:Name="HotkeysExpandIcon" Glyph="&#xE70D;" FontSize="13"/>
                                    </ToggleButton>
                                    </ctk:SettingsCard>
                                </Grid>

                                <!-- Collapsible Content -->
                                <StackPanel x:Name="HotkeysContent" Visibility="Collapsed" Margin="0,12,0,0">
                                    <!-- Menu+A Row -->
                                    <StackPanel Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="80"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:Uid="S_ViewA" Text="View + A" VerticalAlignment="Center" Foreground="#B9C0CC" FontSize="14" />
                                            <ComboBox x:Name="HotkeyMenuAComboBox" Grid.Column="1"
                                                      Style="{StaticResource ModernComboBoxStyle}"
                                                      SelectionChanged="HotkeyMenuA_SelectionChanged"
                                                      UseSystemFocusVisuals="True"
                                                      FocusVisualPrimaryBrush="White">
                                                <ComboBoxItem x:Uid="S_Disabled" Content="Disabled" Tag="0" />
                                                <ComboBoxItem x:Uid="S_KeyboardShortcut" Content="Keyboard Shortcut" Tag="1" />
                                                <ComboBoxItem x:Uid="S_ToggleOSD" Content="Toggle OSD" Tag="3" />
                                                <ComboBoxItem x:Uid="S_Screenshot" Content="Screenshot" Tag="4" />
                                                <ComboBoxItem x:Uid="S_AltTab" Content="Alt+Tab" Tag="5" />
                                                <ComboBoxItem x:Uid="S_AltF4" Content="Alt+F4" Tag="6" />
                                                <ComboBoxItem x:Uid="S_OpenKeyboard" Content="Open Keyboard" Tag="7" />
                                                <ComboBoxItem x:Uid="S_TaskManager" Content="Task Manager" Tag="9" />
                                                <ComboBoxItem x:Uid="S_FocusGoTweaksLite" Content="Focus GoTweaks Lite" Tag="10" />
                                            </ComboBox>
                                        </Grid>
                                        <StackPanel x:Name="HotkeyMenuAKeyPanel" Orientation="Horizontal" Margin="80,4,0,0" Visibility="Collapsed">
                                            <ItemsControl x:Name="HotkeyMenuAKeyTags">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                            </ItemsControl>
                                            <ComboBox x:Name="HotkeyMenuAKeyComboBox" Width="90" Style="{StaticResource ModernComboBoxStyle}"
                                                      SelectedIndex="0" SelectionChanged="HotkeyMenuAKey_SelectionChanged">
                                                <x:String>+ Key</x:String><x:String>A</x:String><x:String>B</x:String><x:String>C</x:String><x:String>D</x:String><x:String>E</x:String><x:String>F</x:String><x:String>G</x:String><x:String>H</x:String><x:String>I</x:String><x:String>J</x:String><x:String>K</x:String><x:String>L</x:String><x:String>M</x:String><x:String>N</x:String><x:String>O</x:String><x:String>P</x:String><x:String>Q</x:String><x:String>R</x:String><x:String>S</x:String><x:String>T</x:String><x:String>U</x:String><x:String>V</x:String><x:String>W</x:String><x:String>X</x:String><x:String>Y</x:String><x:String>Z</x:String><x:String>0</x:String><x:String>1</x:String><x:String>2</x:String><x:String>3</x:String><x:String>4</x:String><x:String>5</x:String><x:String>6</x:String><x:String>7</x:String><x:String>8</x:String><x:String>9</x:String><x:String>F1</x:String><x:String>F2</x:String><x:String>F3</x:String><x:String>F4</x:String><x:String>F5</x:String><x:String>F6</x:String><x:String>F7</x:String><x:String>F8</x:String><x:String>F9</x:String><x:String>F10</x:String><x:String>F11</x:String><x:String>F12</x:String><x:String>Enter</x:String><x:String>Esc</x:String><x:String>Space</x:String><x:String>Tab</x:String><x:String>Backspace</x:String><x:String>Up</x:String><x:String>Down</x:String><x:String>Left</x:String><x:String>Right</x:String><x:String>LCtrl</x:String><x:String>LShift</x:String><x:String>LAlt</x:String><x:String>LWin</x:String><x:String>RCtrl</x:String><x:String>RShift</x:String><x:String>RAlt</x:String><x:String>RWin</x:String><x:String>Home</x:String><x:String>End</x:String><x:String>PgUp</x:String><x:String>PgDn</x:String><x:String>Insert</x:String><x:String>Delete</x:String><x:String>PrintScr</x:String><x:String>Pause</x:String><x:String>VolUp</x:String><x:String>VolDown</x:String><x:String>VolMute</x:String><x:String>[</x:String><x:String>]</x:String>
                                            </ComboBox>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Menu+B Row -->
                                    <StackPanel Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="80"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:Uid="S_ViewB" Text="View + B" VerticalAlignment="Center" Foreground="#B9C0CC" FontSize="14" />
                                            <ComboBox x:Name="HotkeyMenuBComboBox" Grid.Column="1"
                                                      Style="{StaticResource ModernComboBoxStyle}"
                                                      SelectionChanged="HotkeyMenuB_SelectionChanged"
                                                      UseSystemFocusVisuals="True"
                                                      FocusVisualPrimaryBrush="White">
                                                <ComboBoxItem x:Uid="S_Disabled" Content="Disabled" Tag="0" />
                                                <ComboBoxItem x:Uid="S_KeyboardShortcut" Content="Keyboard Shortcut" Tag="1" />
                                                <ComboBoxItem x:Uid="S_ToggleOSD" Content="Toggle OSD" Tag="3" />
                                                <ComboBoxItem x:Uid="S_Screenshot" Content="Screenshot" Tag="4" />
                                                <ComboBoxItem x:Uid="S_AltTab" Content="Alt+Tab" Tag="5" />
                                                <ComboBoxItem x:Uid="S_AltF4" Content="Alt+F4" Tag="6" />
                                                <ComboBoxItem x:Uid="S_OpenKeyboard" Content="Open Keyboard" Tag="7" />
                                                <ComboBoxItem x:Uid="S_TaskManager" Content="Task Manager" Tag="9" />
                                                <ComboBoxItem x:Uid="S_FocusGoTweaksLite" Content="Focus GoTweaks Lite" Tag="10" />
                                            </ComboBox>
                                        </Grid>
                                        <StackPanel x:Name="HotkeyMenuBKeyPanel" Orientation="Horizontal" Margin="80,4,0,0" Visibility="Collapsed">
                                            <ItemsControl x:Name="HotkeyMenuBKeyTags">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                            </ItemsControl>
                                            <ComboBox x:Name="HotkeyMenuBKeyComboBox" Width="90" Style="{StaticResource ModernComboBoxStyle}"
                                                      SelectedIndex="0" SelectionChanged="HotkeyMenuBKey_SelectionChanged">
                                                <x:String>+ Key</x:String><x:String>A</x:String><x:String>B</x:String><x:String>C</x:String><x:String>D</x:String><x:String>E</x:String><x:String>F</x:String><x:String>G</x:String><x:String>H</x:String><x:String>I</x:String><x:String>J</x:String><x:String>K</x:String><x:String>L</x:String><x:String>M</x:String><x:String>N</x:String><x:String>O</x:String><x:String>P</x:String><x:String>Q</x:String><x:String>R</x:String><x:String>S</x:String><x:String>T</x:String><x:String>U</x:String><x:String>V</x:String><x:String>W</x:String><x:String>X</x:String><x:String>Y</x:String><x:String>Z</x:String><x:String>0</x:String><x:String>1</x:String><x:String>2</x:String><x:String>3</x:String><x:String>4</x:String><x:String>5</x:String><x:String>6</x:String><x:String>7</x:String><x:String>8</x:String><x:String>9</x:String><x:String>F1</x:String><x:String>F2</x:String><x:String>F3</x:String><x:String>F4</x:String><x:String>F5</x:String><x:String>F6</x:String><x:String>F7</x:String><x:String>F8</x:String><x:String>F9</x:String><x:String>F10</x:String><x:String>F11</x:String><x:String>F12</x:String><x:String>Enter</x:String><x:String>Esc</x:String><x:String>Space</x:String><x:String>Tab</x:String><x:String>Backspace</x:String><x:String>Up</x:String><x:String>Down</x:String><x:String>Left</x:String><x:String>Right</x:String><x:String>LCtrl</x:String><x:String>LShift</x:String><x:String>LAlt</x:String><x:String>LWin</x:String><x:String>RCtrl</x:String><x:String>RShift</x:String><x:String>RAlt</x:String><x:String>RWin</x:String><x:String>Home</x:String><x:String>End</x:String><x:String>PgUp</x:String><x:String>PgDn</x:String><x:String>Insert</x:String><x:String>Delete</x:String><x:String>PrintScr</x:String><x:String>Pause</x:String><x:String>VolUp</x:String><x:String>VolDown</x:String><x:String>VolMute</x:String><x:String>[</x:String><x:String>]</x:String>
                                            </ComboBox>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Menu+X Row -->
                                    <StackPanel Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="80"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:Uid="S_ViewX" Text="View + X" VerticalAlignment="Center" Foreground="#B9C0CC" FontSize="14" />
                                            <ComboBox x:Name="HotkeyMenuXComboBox" Grid.Column="1"
                                                      Style="{StaticResource ModernComboBoxStyle}"
                                                      SelectionChanged="HotkeyMenuX_SelectionChanged"
                                                      UseSystemFocusVisuals="True"
                                                      FocusVisualPrimaryBrush="White">
                                                <ComboBoxItem x:Uid="S_Disabled" Content="Disabled" Tag="0" />
                                                <ComboBoxItem x:Uid="S_KeyboardShortcut" Content="Keyboard Shortcut" Tag="1" />
                                                <ComboBoxItem x:Uid="S_ToggleOSD" Content="Toggle OSD" Tag="3" />
                                                <ComboBoxItem x:Uid="S_Screenshot" Content="Screenshot" Tag="4" />
                                                <ComboBoxItem x:Uid="S_AltTab" Content="Alt+Tab" Tag="5" />
                                                <ComboBoxItem x:Uid="S_AltF4" Content="Alt+F4" Tag="6" />
                                                <ComboBoxItem x:Uid="S_OpenKeyboard" Content="Open Keyboard" Tag="7" />
                                                <ComboBoxItem x:Uid="S_TaskManager" Content="Task Manager" Tag="9" />
                                                <ComboBoxItem x:Uid="S_FocusGoTweaksLite" Content="Focus GoTweaks Lite" Tag="10" />

0" StepFrequency="1"/></ctk:SettingsCard><ctk:SettingsCard ContentAlignment="Vertical" HorizontalContentAlignment="Stretch"><ctk:SettingsCard.Header><TextBlock TextWrapping="Wrap" x:Uid="S_AntiDeadzoneY" Text="Anti-deadzone Y" /></ctk:SettingsCard.Header><ctk:SettingsCard.Description><TextBlock TextWrapping="Wrap" x:Name="ViiperLSADYValue" Text="0%"/></ctk:SettingsCard.Description><Slider x:Name="ViiperLSADYSlider" Style="{StaticResource ModernSliderStyle}" Minimum="0" Maximum="50" Value="0" StepFrequency="1"/></ctk:SettingsCard><ctk:SettingsCard><ctk:SettingsCard.Header><TextBlock TextWrapping="Wrap" x:Uid="S_SensitivityX" Text="Sensitivity X" /></ctk:SettingsCard.Header><ComboBox x:Name="ViiperLSCurveXComboBox" Style="{StaticResource ModernComboBoxStyle}" FontSize="13"> <ComboBoxItem x:Uid="S_Linear" Content="Linear" Tag="0" /> <ComboBoxItem x:Uid="S_Smooth" Content="Smooth" Tag="1" /> <ComboBoxItem x:Uid="S_Aggressive" Content="Aggressive" Tag="2" /> <ComboBoxItem x:Uid="S_Instant" Content="Instant" Tag="3" /> <ComboBoxItem x:Uid="S_SCurve" Content="S-Curve" Tag="4" /> <ComboBoxItem x:Uid="S_Delay" Content="Delay" Tag="5" /> </ComboBox></ctk:SettingsCard><ctk:SettingsCard><ctk:SettingsCard.Header><TextBlock TextWrapping="Wrap" x:Uid="S_SensitivityY" Text="Sensitivity Y" /></ctk:SettingsCard.Header><ComboBox x:Name="ViiperLSCurveYComboBox" Style="{StaticResource ModernComboBoxStyle}" FontSize="13"> <ComboBoxItem x:Uid="S_Linear" Content="Linear" Tag="0" /> <ComboBoxItem x:Uid="S_Smooth" Content="Smooth" Tag="1" /> <ComboBoxItem x:Uid="S_Aggressive" Content="Aggressive" Tag="2" /> <ComboBoxItem x:Uid="S_Instant" Content="Instant" Tag="3" /> <ComboBoxItem x:Uid="S_SCurve" Content="S-Curve" Tag="4" /> <ComboBoxItem x:Uid="S_Delay" Content="Delay" Tag="5" /> </ComboBox></ctk:SettingsCard></StackPanel>

                        <!-- Power & Sleep Card (Collapsible): power button behavior + screen/hibernate
                             idle timers, merged under one expandable card matching Windows' own
                             "Power & sleep" settings grouping. Power Button + Display Timeout are
                             pulled directly from the active Windows power plan; Hibernate Timeout is
                             a GoTweaks-only feature (see its section note below). -->
                        <Border x:Name="PowerAndSleepCard" Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <Grid Background="Transparent" Tapped="ExpandHeader_Tapped">
                                    <ctk:SettingsCard Style="{StaticResource HeaderRowStyle}">
                                        <ctk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE7E8;"/></ctk:SettingsCard.HeaderIcon>
                                        <ctk:SettingsCard.Header>
                                            <TextBlock x:Uid="S_PowerSleep" Text="Power &amp; Sleep" />
                                        </ctk:SettingsCard.Header>
                                        <ctk:SettingsCard.Description>
                                            <TextBlock x:Uid="S_PowerButtonBehaviorAndIdle" Text="Power button behavior and idle timers" TextWrapping="Wrap" />
                                        </ctk:SettingsCard.Description>
                                        <ToggleButton x:Name="PowerAndSleepExpandButton" MinWidth="44" MinHeight="40"
                                                  IsChecked="False"
                                                  Background="Transparent"
                                                  BorderThickness="0"
                                                  Padding="8,4"
                                                  Click="PowerAndSleepExpandButton_Click">
                                        <FontIcon x:Name="PowerAndSleepExpandIcon" Glyph="&#xE70D;" FontSize="13"/>
                                    </ToggleButton>
                                    </ctk:SettingsCard>
                                </Grid>

                                <StackPanel x:Name="PowerAndSleepContent" Visibility="Collapsed" Margin="0,12,0,0">

                                    <TextBlock x:Uid="S_PowerButton" Text="Power button" FontSize="14" FontWeight="SemiBold" Foreground="#B9C0CC" />

                                    <Grid Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Uid="S_PluggedInAC" Text="Plugged in (AC)" FontSize="14" Foreground="White" VerticalAlignment="Center" Grid.Column="0" />
                                        <ComboBox x:Name="PowerButtonActionACComboBox"
                                                  Width="150"
                                                  Grid.Column="1"
                                                  Style="{StaticResource ModernComboBoxStyle}">
                                            <ComboBoxItem x:Uid="S_Sleep" Content="Sleep" Tag="1" />
                                            <ComboBoxItem x:Uid="S_Hibernate" Content="Hibernate" Tag="2" />
                                            <ComboBoxItem x:Uid="S_DoNothing" Content="Do nothing" Tag="0" />
                                            <ComboBoxItem x:Uid="S_ShutDown" Content="Shut down" Tag="3" />
                                        </ComboBox>
                                    </Grid>

                                    <Grid Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Uid="S_OnBatteryDC" Text="On battery (DC)" FontSize="14" Foreground="White" VerticalAlignment="Center" Grid.Column="0" />
                                        <ComboBox x:Name="PowerButtonActionDCComboBox"
                                                  Width="150"
                                                  Grid.Column="1"
                                                  Style="{StaticResource ModernComboBoxStyle}">
                                            <ComboBoxItem x:Uid="S_Sleep" Content="Sleep" Tag="1" />
                                            <ComboBoxItem x:Uid="S_Hibernate" Content="Hibernate" Tag="2" />
                                            <ComboBoxItem x:Uid="S_DoNothing" Content="Do nothing" Tag="0" />
                                            <ComboBoxItem x:Uid="S_ShutDown" Content="Shut down" Tag="3" />
                                        </ComboBox>
                                    </Grid>

                                    <Border Margin="0,14,0,0" Height="1" Background="#22FFFFFF"/>

                                    <TextBlock x:Uid="S_TurnOffScreenAfter" Text="Turn off screen after" FontSize="14" FontWeight="SemiBold" Foreground="#B9C0CC" Margin="0,12,0,0" />

                                    <Grid Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Uid="S_PluggedInAC" Text="Plugged in (AC)" FontSize="14" Foreground="White" VerticalAlignment="Center" Grid.Column="0" />
                                        <ComboBox x:Name="DisplayTimeoutACComboBox"
                                                  Width="150"
                                                  Grid.Column="1"
                                                  Style="{StaticResource ModernComboBoxStyle}">
                                            <ComboBoxItem x:Uid="S_Never" Content="Never" Tag="0" />
                                            <ComboBoxItem x:Uid="S_1Minute" Content="1 minute" Tag="60" />
                                            <ComboBoxItem x:Uid="S_2Minutes" Content="2 minutes" Tag="120" />
                                            <ComboBoxItem x:Uid="S_3Minutes" Content="3 minutes" Tag="180" />
                                            <ComboBoxItem x:Uid="S_5Minutes" Content="5 minutes" Tag="300" />
                                            <ComboBoxItem x:Uid="S_10Minutes" Content="10 minutes" Tag="600" />
                                            <ComboBoxItem x:Uid="S_15Minutes" Content="15 minutes" Tag="900" />
                                            <ComboBoxItem x:Uid="S_20Minutes" Content="20 minutes" Tag="1200" />
                                            <ComboBoxItem x:Uid="S_30Minutes" Content="30 minutes" Tag="1800" />
                                            <ComboBoxItem x:Uid="S_45Minutes" Content="45 minutes" Tag="2700" />
                                            <ComboBoxItem x:Uid="S_1Hour" Content="1 hour" Tag="3600" />
                                        </ComboBox>
                                    </Grid>

                                    <Grid Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Uid="S_OnBatteryDC" Text="On battery (DC)" FontSize="14" Foreground="White" VerticalAlignment="Center" Grid.Column="0" />
                                        <ComboBox x:Name="DisplayTimeoutDCComboBox"
                                                  Width="150"
                                                  Grid.Column="1"
                                                  Style="{StaticResource ModernComboBoxStyle}">
                                            <ComboBoxItem x:Uid="S_Never" Content="Never" Tag="0" />
                                            <ComboBoxItem x:Uid="S_1Minute" Content="1 minute" Tag="60" />
                                            <ComboBoxItem x:Uid="S_2Minutes" Content="2 minutes" Tag="120" />
                                            <ComboBoxItem x:Uid="S_3Minutes" Content="3 minutes" Tag="180" />
                                            <ComboBoxItem x:Uid="S_5Minutes" Content="5 minutes" Tag="300" />
                                            <ComboBoxItem x:Uid="S_10Minutes" Content="10 minutes" Tag="600" />
                                            <ComboBoxItem x:Uid="S_15Minutes" Content="15 minutes" Tag="900" />
                                            <ComboBoxItem x:Uid="S_20Minutes" Content="20 minutes" Tag="1200" />
                                            <ComboBoxItem x:Uid="S_30Minutes" Content="30 minutes" Tag="1800" />
                                            <ComboBoxItem x:Uid="S_45Minutes" Content="45 minutes" Tag="2700" />
                                            <ComboBoxItem x:Uid="S_1Hour" Content="1 hour" Tag="3600" />
                                        </ComboBox>
                                    </Grid>

                                    <Border Margin="0,14,0,0" Height="1" Background="#22FFFFFF"/>

                                    <TextBlock x:Uid="S_HibernateAfter" Text="Hibernate after" FontSize="14" FontWeight="SemiBold" Foreground="#B9C0CC" Margin="0,12,0,0" />
                                    <TextBlock x:Uid="S_GoTweaksFeatureNotAWindows" Text="GoTweaks feature - not a Windows setting, since Windows has no built-in idle-to-hibernate timer"
                                               FontSize="12" Foreground="#B9C0CC" TextWrapping="Wrap" Margin="0,2,0,0" />

                                    <Grid Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Uid="S_PluggedInAC" Text="Plugged in (AC)" FontSize="14" Foreground="White" VerticalAlignment="Center" Grid.Column="0" />
                                        <ComboBox x:Name="HibernateTimeoutACComboBox"
                                                  Width="150"
                                                  Grid.Column="1"
                                                  Style="{StaticResource ModernComboBoxStyle}">
                                            <ComboBoxItem x:Uid="S_Never" Content="Never" Tag="0" />
                                            <ComboBoxItem x:Uid="S_10Minutes" Content="10 minutes" Tag="10" />
                                            <ComboBoxItem x:Uid="S_15Minutes" Content="15 minutes" Tag="15" />
                                            <ComboBoxItem x:Uid="S_20Minutes" Content="20 minutes" Tag="20" />
                                            <ComboBoxItem x:Uid="S_30Minutes" Content="30 minutes" Tag="30" />
                                            <ComboBoxItem x:Uid="S_45Minutes" Content="45 minutes" Tag="45" />
                                            <ComboBoxItem x:Uid="S_1Hour" Content="1 hour" Tag="60" />
                                            <ComboBoxItem x:Uid="S_2Hours" Content="2 hours" Tag="120" />
                                        </ComboBox>
                                    </Grid>

                                    <Grid Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Uid="S_OnBatteryDC" Text="On battery (DC)" FontSize="14" Foreground="White" VerticalAlignment="Center" Grid.Column="0" />
                                        <ComboBox x:Name="HibernateTimeoutDCComboBox"
                                                  Width="150"
                                                  Grid.Column="1"
                                                  Style="{StaticResource ModernComboBoxStyle}">
                                            <ComboBoxItem x:Uid="S_Never" Content="Never" Tag="0" />
                                            <ComboBoxItem x:Uid="S_10Minutes" Content="10 minutes" Tag="10" />
                                            <ComboBoxItem x:Uid="S_15Minutes" Content="15 minutes" Tag="15" />
                                            <ComboBoxItem x:Uid="S_20Minutes" Content="20 minutes" Tag="20" />
                                            <ComboBoxItem x:Uid="S_30Minutes" Content="30 minutes" Tag="30" />
                                            <ComboBoxItem x:Uid="S_45Minutes" Content="45 minutes" Tag="45" />
                                            <ComboBoxItem x:Uid="S_1Hour" Content="1 hour" Tag="60" />
                                            <ComboBoxItem x:Uid="S_2Hours" Content="2 hours" Tag="120" />
                                        </ComboBox>
                                    </Grid>

                                    <!-- Windows' own Sleep idle timer (Settings > Power & battery)
                                         still runs independently of the Hibernate timer above and can
                                         fire first, sending the system to Sleep before our Hibernate
                                         timeout is ever reached. This one-off button zeroes Windows'
                                         Sleep-after timeout for both AC and DC so the GoTweaks
                                         Hibernate timer above is the only idle-power action left. -->
                                    <Grid Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                                            <TextBlock x:Uid="S_WindowsOwnSleepTimerCan" Text="Windows' own Sleep timer can still fire first"
                                                       FontSize="12" Foreground="#B9C0CC" TextWrapping="Wrap" />
                                            <TextBlock x:Name="DisableSleepTimersStatusText"
                                                       Text=""
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       Foreground="#6CCB5F"
                                                       Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <Button x:Uid="DisableSleepTimersButton" x:Name="DisableSleepTimersButton"
                                                Grid.Column="1"
                                                Content="Disable Sleep Timer (AC+DC)"
                                                Style="{StaticResource ModernButtonStyle}"
                                                Click="DisableSleepTimersButton_Click"
                                                VerticalAlignment="Center" />
                                    </Grid>

                                    <muxc:InfoBar x:Name="PowerButtonInfoExpander"
                                                  Margin="0,14,0,0"
                                                  IsOpen="True"
                                                  IsClosable="False"
                                                  Severity="Warning">
                                        <muxc:InfoBar.Content>
                                            <StackPanel Margin="0,0,0,12">
                                                <TextBlock x:Uid="S_UseHibernateInsteadOfSleep" FontWeight="SemiBold" FontSize="13" TextWrapping="Wrap"
                                                           Text="⚠ Use Hibernate instead of Sleep" />
                                                <TextBlock x:Uid="S_WindowsDefaultSleepModernStandby" FontSize="12" Foreground="#B9C0CC" TextWrapping="Wrap" Margin="0,4,0,0"
                                                           Text="Windows' default Sleep (Modern Standby) sometimes drains the battery from background wake-ups or fails to resume cleanly. Hibernate saves the session to disk and fully powers off, which is closer to how SteamOS suspends and tends to be more reliable - at the cost of a slightly slower resume. Setting the Power Button and Hibernate Timeout options above to Hibernate (and disabling Windows' Sleep timer) is the recommended change." />
                                            </StackPanel>
                                        </muxc:InfoBar.Content>
                                    </muxc:InfoBar>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Debug Card (Collapsible) -->
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <!-- Header with Expand/Collapse -->
                                <Grid Background="Transparent" Tapped="ExpandHeader_Tapped">
                                    <ctk:SettingsCard Style="{StaticResource HeaderRowStyle}">
                                        <ctk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xEBE8;"/></ctk:SettingsCard.HeaderIcon>
                                        <ctk:SettingsCard.Header>
                                            <TextBlock x:Uid="S_Debug" Text="Debug" />
                                        </ctk:SettingsCard.Header>
                                        <ctk:SettingsCard.Description>
                                            <TextBlock x:Uid="S_TroubleshootingAndDiagnosticTools" Text="Troubleshooting and diagnostic tools" TextWrapping="Wrap" />
                                        </ctk:SettingsCard.Description>
                                        <ToggleButton x:Name="DebugExpandButton" MinWidth="44" MinHeight="40"
                                                  IsChecked="False"
                                                  Background="Transparent"
                                                  BorderThickness="0"
                                                  Padding="8,4"
                                                  Click="DebugExpandButton_Click">
                                        <FontIcon x:Name="DebugExpandIcon" Glyph="&#xE70D;" FontSize="13"/>
                                    </ToggleButton>
                                    </ctk:SettingsCard>
                                </Grid>

                                <!-- Collapsible Content -->
                                <StackPanel x:Name="DebugContent" Visibility="Collapsed" Margin="0,12,0,0">
                                    <!-- Restart Helper / Kill GoTweaks Buttons (side by side) -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Button x:Uid="RestartHelperButton" x:Name="RestartHelperButton"
                                                Grid.Column="0"
                                                Content="Restart Helper"
                                                HorizontalAlignment="Stretch"
                                                Style="{StaticResource StandaloneButtonStyle}"
                                                Click="RestartHelperButton_Click" />
                                        <Button x:Uid="KillGoTweaksButton" x:Name="KillGoTweaksButton"
                                                Grid.Column="2"
                                                Content="Kill GoTweaks Lite"
                                                HorizontalAlignment="Stretch"
                                                Style="{StaticResource StandaloneButtonStyle}"
                                                Click="KillGoTweaksButton_Click" />
                                    </Grid>

                                    <!-- Export Logs Button -->
                                    <Button x:Uid="ExportLogsButton" x:Name="ExportLogsButton"
                                            Content="Export Logs"
                                            HorizontalAlignment="Stretch"
                                            Margin="0,8,0,0"
                                            Style="{StaticResource StandaloneButtonStyle}"
                                            Click="ExportLogsButton_Click" />

                                    <!-- Export/Import All Data Buttons (side by side) -->
                                    <Grid Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Button x:Uid="ExportAllDataButton" x:Name="ExportAllDataButton"
                                                Grid.Column="0"
                                                Content="Export All Data"
                                                HorizontalAlignment="Stretch"
                                                Style="{StaticResource StandaloneButtonStyle}"
                                                Click="ExportAllDataButton_Click" />
                                        <Button x:Uid="ImportAllDataButton" x:Name="ImportAllDataButton"
                                                Grid.Column="2"
                                                Content="Import All Data"
                                                HorizontalAlignment="Stretch"
                                                Style="{StaticResource StandaloneButtonStyle}"
                                                Click="ImportAllDataButton_Click" />
                                    </Grid>

                                    <!-- Prepare for Uninstall Button -->
                                    <Button x:Uid="PrepareForUninstallButton" x:Name="PrepareForUninstallButton"
                                            Content="Prepare for Uninstall"
                                            HorizontalAlignment="Stretch"
                                            Margin="0,8,0,0"
                                            Style="{StaticResource StandaloneButtonStyle}"
                                            Click="PrepareForUninstallButton_Click" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- About Card (Collapsible) -->
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <!-- Header with Expand/Collapse -->
                                <Grid Background="Transparent" Tapped="ExpandHeader_Tapped">
                                    <ctk:SettingsCard Style="{StaticResource HeaderRowStyle}">
                                        <ctk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE946;"/></ctk:SettingsCard.HeaderIcon>
                                        <ctk:SettingsCard.Header>
                                            <TextBlock x:Uid="S_About" Text="About" />
                                        </ctk:SettingsCard.Header>
                                        <ctk:SettingsCard.Description>
                                            <TextBlock x:Uid="S_VersionAndCredits" Text="Version and credits" TextWrapping="Wrap" />
                                        </ctk:SettingsCard.Description>
                                        <ToggleButton x:Name="AboutExpandButton" MinWidth="44" MinHeight="40"
                                                  IsChecked="False"
                                                  Background="Transparent"
                                                  BorderThickness="0"
                                                  Padding="8,4"
                                                  Click="AboutExpandButton_Click">
                                        <FontIcon x:Name="AboutExpandIcon" Glyph="&#xE70D;" FontSize="13"/>
                                    </ToggleButton>
                                    </ctk:SettingsCard>
                                </Grid>

                                <!-- Collapsible Content -->
                                <StackPanel x:Name="AboutContent" Visibility="Collapsed" Margin="0,12,0,0">
                                    <!-- Updates - everything update-related lives here, at the top. -->
                                    <Button x:Uid="CheckForUpdateButton" x:Name="CheckForUpdateButton"
                                            Content="Check for Update"
                                            HorizontalAlignment="Stretch"
                                            Style="{StaticResource StandaloneButtonStyle}"
                                            Click="CheckForUpdateButton_Click" />

                                    <!-- Update Status Text -->
                                    <TextBlock x:Name="UpdateStatusText"
                                               Text=""
                                               FontSize="13"
                                               Foreground="#B9C0CC"
                                               TextWrapping="Wrap"
                                               Margin="0,8,0,0"
                                               Visibility="Collapsed"/>

                                    <!-- Update Button (shown when update available) -->
                                    <Button x:Uid="UpdateButton" x:Name="UpdateButton"
                                            Content="Update"
                                            HorizontalAlignment="Stretch"
                                            Margin="0,8,0,0"
                                            Style="{StaticResource StandaloneButtonStyle}"
                                            Background="#107C10"
                                            Click="UpdateButton_Click"
                                            Visibility="Collapsed" />

                                    <!-- Single "check for updates automatically" preference, gating both
                                         update surfaces (the helper's Quick-tab banner probe and the
                                         widget's own startup auto-check) so there is only one on-screen
                                         toggle instead of two near-duplicate ones. -->
                                    <Grid Margin="0,20,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Uid="S_CheckForUpdatesAutomaticallyOn" Grid.Column="0"
                                                   Text="Check for updates automatically on start"
                                                   FontSize="13"
                                                   Foreground="#B9C0CC"
                                                   VerticalAlignment="Center"
                                                   TextWrapping="Wrap" />
                                        <ToggleSwitch x:Name="GoTweaksUpdateOnStartCheckbox"
                                                      Grid.Column="1"
                                                      Style="{StaticResource ModernToggleStyle}"
                                                      IsOn="True"
                                                      Toggled="GoTweaksUpdateOnStartCheckbox_Changed"/>
                                    </Grid>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Uid="S_HideGoTweaksLiteUpdateBanner" Grid.Column="0"
                                                   Text="Hide GoTweaks Lite update banner on Quick tab"
                                                   FontSize="13"
                                                   Foreground="#B9C0CC"
                                                   VerticalAlignment="Center"
                                                   TextWrapping="Wrap" />
                                        <ToggleSwitch x:Name="GoTweaksHideBannerCheckbox"
                                                      Grid.Column="1"
                                                      Style="{StaticResource ModernToggleStyle}"
                                                      IsOn="False"
                                                      Toggled="GoTweaksHideBannerCheckbox_Changed"/>
                                    </Grid>

                                    <Border Height="1" Background="#33FFFFFF" Margin="0,16,0,16"/>

                                    <!-- Version -->
                                    <Grid Margin="0,0,0,8">
                                        <TextBlock x:Uid="S_Version" Text="Version"
                                                   FontSize="14"
                                                   Foreground="#B9C0CC"
                                                   VerticalAlignment="Center" />
                                        <TextBlock x:Name="AboutVersionText"
                                                   Text="0.3.98.0"
                                                   FontSize="14"
                                                   Foreground="#6CCB5F"
                                                   FontWeight="SemiBold"
                                                   HorizontalAlignment="Right"/>
                                    </Grid>

                                    <!-- Fork Author -->
                                    <Grid Margin="0,0,0,8">
                                        <TextBlock x:Uid="S_ForkAuthor" Text="Fork Author"
                                                   FontSize="14"
                                                   Foreground="#B9C0CC"
                                                   VerticalAlignment="Center" />
                                        <TextBlock x:Uid="S_RuloB" Text="RuloB"
                                                   FontSize="14"
                                                   Foreground="{StaticResource SystemAccentBrush}"
                                                   FontWeight="SemiBold"
                                                   HorizontalAlignment="Right" />
                                    </Grid>

                                    <!-- Original Author -->
                                    <Grid Margin="0,0,0,0">
                                        <TextBlock x:Uid="S_OriginalAuthor" Text="Original Author"
                                                   FontSize="14"
                                                   Foreground="#B9C0CC"
                                                   VerticalAlignment="Center" />
                                        <TextBlock x:Uid="S_LtChipotle" Text="LtChipotle"
                                                   FontSize="14"
                                                   Foreground="#FFFFFF"
                                                   FontWeight="SemiBold"
                                                   HorizontalAlignment="Right" />
                                    </Grid>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>

                <!-- LEGION TAB -->
                <ScrollViewer x:Name="LegionScrollViewer" VerticalScrollBarVisibility="Auto" Visibility="Collapsed"
                              BringIntoViewOnFocusChange="True">
                    <StackPanel Padding="16,8,16,16">

                        <!-- Controller Status Card -->
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <!-- Left Controller / Device Glyph / Right Controller, flanking row.
                                     All three panels share the same 132px height (the glyph box is
                                     taller than the others to fit the device name inside it). Left/
                                     Right cards are individually collapsible (hidden on devices
                                     without detachable controllers) via SetControllerBatterySectionVisibility. -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Left Controller -->
                                    <Border x:Name="LeftControllerCard" Grid.Column="0" Height="132"
                                            Background="{StaticResource PageBackgroundBrush}"
                                            CornerRadius="14" Padding="12,10" Margin="0,0,8,0">
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock x:Uid="S_LeftController" Text="Left Controller" FontSize="13" Foreground="#B9C0CC" Margin="0,0,0,4" HorizontalAlignment="Center" />
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <FontIcon Glyph="&#xE83F;" FontSize="14" Foreground="#B9C0CC" Margin="0,0,6,0"/>
                                                <TextBlock x:Name="LeftControllerBatteryText"
                                                           Text="--%"
                                                           FontSize="14"
                                                           FontWeight="SemiBold"
                                                           Foreground="#FFFFFF"/>
                                                <FontIcon x:Name="LeftControllerChargingIcon"
                                                          Glyph="&#xE945;"
                                                          FontSize="13"
                                                          Foreground="#4CAF50"
                                                          Margin="6,0,0,0"
                                                          Visibility="Collapsed"/>
                                            </StackPanel>
                                            <TextBlock x:Name="LeftControllerConnectionText"
                                                       Text="--"
                                                       FontSize="12"
                                                       Foreground="#B9C0CC"
                                                       Margin="0,2,0,0"
                                                       HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Device Glyph + name, stacked together in one taller box -->
                                    <Border Grid.Column="1" Width="176" Height="132" CornerRadius="18"
                                            Background="{StaticResource PageBackgroundBrush}"
                                            Margin="8,0,8,0">
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Image Source="/Assets/Glyph_LeGo2.png"
                                                   Width="136" Stretch="Uniform"
                                                   HorizontalAlignment="Center"/>
                                            <TextBlock x:Uid="LegionDeviceNameText" x:Name="LegionDeviceNameText" Text="Legion Go Controller"
                                                       Style="{StaticResource CardTitleStyle}"
                                                       HorizontalAlignment="Center" TextAlignment="Center"
                                                       Margin="0,8,0,0" />
                                        </StackPanel>
                                    </Border>

                                    <!-- Right Controller -->
                                    <Border x:Name="RightControllerCard" Grid.Column="2" Height="132"
                                            Background="{StaticResource PageBackgroundBrush}"
                                            CornerRadius="14" Padding="12,10" Margin="8,0,0,0">
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock x:Uid="S_RightController" Text="Right Controller" FontSize="13" Foreground="#B9C0CC" Margin="0,0,0,4" HorizontalAlignment="Center" />
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <FontIcon Glyph="&#xE83F;" FontSize="14" Foreground="#B9C0CC" Margin="0,0,6,0"/>
                                                <TextBlock x:Name="RightControllerBatteryText"
                                                           Text="--%"
                                                           FontSize="14"
                                                           FontWeight="SemiBold"
                                                           Foreground="#FFFFFF"/>
                                                <FontIcon x:Name="RightControllerChargingIcon"
                                                          Glyph="&#xE945;"
                                                          FontSize="13"
                                                          Foreground="#4CAF50"
                                                          Margin="6,0,0,0"
                                                          Visibility="Collapsed"/>
                                            </StackPanel>
                                            <TextBlock x:Name="RightControllerConnectionText"
                                                       Text="--"
                                                       FontSize="12"
                                                       Foreground="#B9C0CC"
                                                       Margin="0,2,0,0"
                                                       HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <!-- Separator under the title -->
                                <Border Height="1" Background="#33FFFFFF" Margin="0,10,0,0"/>

                                <!-- Controller Information — Win11-style info table.
                                     Visibility is driven by UpdateLegionControllerInfoSectionVisibility()
                                     (shows as soon as EITHER VID:PID or device-status JSON has data,
                                     so VID:PID isn't hidden just because the device-status readback
                                     hasn't arrived yet). -->
                                <StackPanel x:Name="LegionControllerInfoSection" Visibility="Collapsed" Margin="0,10,0,0">
                                    <TextBlock x:Uid="S_ControllerInformation" Text="Controller Information"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="#B9C0CC"
                                               Margin="0,0,0,8" />

                                    <Border Background="#2F3338" CornerRadius="6" Padding="12,2">
                                        <StackPanel>
                                            <Grid Margin="0,8,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="VID:PID" FontSize="13" Foreground="#B9C0CC"/>
                                                <TextBlock Grid.Column="1" x:Name="LegionControllerPidVidText"
                                                           Text="--" FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFF"
                                                           HorizontalAlignment="Right"/>
                                            </Grid>
                                            <Border Height="1" Background="#22FFFFFF" Margin="0,8,0,0"/>

                                            <Grid Margin="0,8,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock x:Uid="S_Firmware" Grid.Column="0" Text="Firmware" FontSize="13" Foreground="#B9C0CC" />
                                                <TextBlock Grid.Column="1" x:Name="LegionControllerFirmwareText"
                                                           Text="—" FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFF"
                                                           HorizontalAlignment="Right"/>
                                            </Grid>
                                            <Border Height="1" Background="#22FFFFFF" Margin="0,8,0,0"/>

                                            <Grid Margin="0,8,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock x:Uid="S_StickLight" Grid.Column="0" Text="Stick light" FontSize="13" Foreground="#B9C0CC" />
                                                <TextBlock Grid.Column="1" x:Name="LegionControllerLightText"
                                                           Text="—" FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFF"
                                                           HorizontalAlignment="Right" Margin="0,0,8,0"/>
                                                <Border Grid.Column="2" x:Name="LegionControllerLightSwatch"
                                                        Width="14" Height="14" CornerRadius="3"
                                                        BorderThickness="1" BorderBrush="#444444"
                                                        Visibility="Collapsed"/>
                                            </Grid>
                                            <Border Height="1" Background="#22FFFFFF" Margin="0,8,0,0"/>

                                            <Grid Margin="0,8,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock x:Uid="S_Vibration" Grid.Column="0" Text="Vibration" FontSize="13" Foreground="#B9C0CC" />
                                                <TextBlock Grid.Column="1" x:Name="LegionControllerVibrationText"
                                                           Text="—" FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFF"
                                                           HorizontalAlignment="Right"/>
                                            </Grid>
                                            <Border Height="1" Background="#22FFFFFF" Margin="0,8,0,0"/>

                                            <Grid Margin="0,8,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock x:Uid="S_Touchpad" Grid.Column="0" Text="Touchpad" FontSize="13" Foreground="#B9C0CC" />
                                                <TextBlock Grid.Column="1" x:Name="LegionControllerTouchpadText"
                                                           Text="—" FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFF"
                                                           HorizontalAlignment="Right"/>
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <!-- Controller auto-sleep (idle power-off) timeout -->
                                    <Grid Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Uid="S_ControllerSleep" Grid.Column="0" Text="Controller sleep" VerticalAlignment="Center" Foreground="#B9C0CC" FontSize="14" />
                                        <ComboBox x:Name="LegionControllerSleepComboBox" Grid.Column="1" Width="110"
                                                  Style="{StaticResource ModernComboBoxStyle}" SelectedIndex="3"
                                                  SelectionChanged="LegionControllerSleepComboBox_SelectionChanged">
                                            <ComboBoxItem x:Uid="S_Never" Content="Never" Tag="0" />
                                            <ComboBoxItem x:Uid="S_5Min" Content="5 min" Tag="5" />
                                            <ComboBoxItem x:Uid="S_10Min" Content="10 min" Tag="10" />
                                            <ComboBoxItem x:Uid="S_15Min" Content="15 min" Tag="15" />
                                            <ComboBoxItem x:Uid="S_20Min" Content="20 min" Tag="20" />
                                            <ComboBoxItem x:Uid="S_30Min" Content="30 min" Tag="30" />
                                        </ComboBox>
                                    </Grid>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Legion sub-sections: one visible container at a time (LB/RB or tap). -->
                        <!-- Same sliding-pill tabs as the main bar, on a subtle track. -->
                        <Grid Margin="0,12,0,0" Background="#26292D" CornerRadius="22" Padding="2">
                            <Border x:Name="LegionSectionPill" Background="{StaticResource SystemAccentBrush}" CornerRadius="20"
                                    Height="40" Width="0" HorizontalAlignment="Left" VerticalAlignment="Center">
                                <Border.RenderTransform><TranslateTransform x:Name="LegionSectionPillTransform"/></Border.RenderTransform>
                            </Border>
                            <StackPanel x:Name="LegionSectionTabs" Orientation="Horizontal" HorizontalAlignment="Left" XYFocusKeyboardNavigation="Disabled">
                                <RadioButton x:Uid="LegionSectionController" AutomationProperties.Name="Controller" Style="{StaticResource NavRadioButtonStyle}" GroupName="LegionSection" IsChecked="True" Checked="LegionSectionTab_Checked"><FontIcon Glyph="&#xE7FC;" FontSize="16"/></RadioButton>
                                <RadioButton x:Uid="LegionSectionVIIPER" AutomationProperties.Name="Emulation" Style="{StaticResource NavRadioButtonStyle}" GroupName="LegionSection" Checked="LegionSectionTab_Checked"><FontIcon Glyph="&#xE7F4;" FontSize="16"/></RadioButton>
                                <RadioButton x:Uid="LegionSectionInput" AutomationProperties.Name="Input" Style="{StaticResource NavRadioButtonStyle}" GroupName="LegionSection" Checked="LegionSectionTab_Checked"><FontIcon Glyph="&#xE765;" FontSize="16"/></RadioButton>
                                <RadioButton x:Uid="LegionSectionLighting" AutomationProperties.Name="Lighting" Style="{StaticResource NavRadioButtonStyle}" GroupName="LegionSection" Checked="LegionSectionTab_Checked"><FontIcon Glyph="&#xE781;" FontSize="16"/></RadioButton>
                                <RadioButton x:Uid="LegionSectionDevice" AutomationProperties.Name="Device" Style="{StaticResource NavRadioButtonStyle}" GroupName="LegionSection" Checked="LegionSectionTab_Checked"><FontIcon Glyph="&#xE772;" FontSize="16"/></RadioButton>
                            </StackPanel>
                        </Grid>
                        <StackPanel x:Name="LegionControllerSection">
                            <!-- Controller Settings Section (Touchpad & Vibration + Lighting) -->
                            <TextBlock x:Uid="S_ControllerSettings" Text="Controller Settings" Style="{StaticResource SectionHeaderStyle}" />

                            <Border Style="{StaticResource CardStyle}">
                                <StackPanel Spacing="8">
                                    <TextBlock x:Uid="S_LegionSpaceService" Text="Legion Space service" Style="{StaticResource CardTitleStyle}" />
                                    <TextBlock x:Uid="DAServiceStatusText" x:Name="DAServiceStatusText" Text="Checking service status"
                                               Style="{StaticResource CardCaptionStyle}" TextWrapping="Wrap" />
                                    <Button x:Uid="ToggleDAServiceButton" x:Name="ToggleDAServiceButton" Content="Refresh"
                                            Style="{StaticResource ModernButtonStyle}" Click="ToggleDAServiceButton_Click" />
                                </StackPanel>
                            </Border>

                            <!-- Controller Mode Card: Legion Space style X-Input / D-Input switch. Only shown
                                 once the helper reports a controller that supports it (see
                                 UpdateLegionControllerModeUI). Switch off = X-Input, on = D-Input. -->
                            <Border x:Name="LegionControllerModeCard" Style="{StaticResource CardStyle}" Visibility="Collapsed">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                                            <TextBlock x:Uid="S_DInputMode" Text="D-Input mode" Style="{StaticResource CardTitleStyle}" />
                                            <TextBlock x:Uid="LegionControllerModeStatusText" x:Name="LegionControllerModeStatusText"
                                                       Text="Controllers not detected"
                                                       Style="{StaticResource CardCaptionStyle}"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                        <ToggleSwitch x:Name="LegionControllerModeToggle"
                                                      Grid.Column="1"
                                                      Style="{StaticResource ModernToggleStyle}"
                                                      IsOn="False"
                                                      IsEnabled="False"
                                                      XYFocusUp="{x:Bind LegionNavItem}"
                                                      XYFocusDown="{x:Bind TouchpadVibrationExpandToggle}"
                                                      Toggled="LegionControllerModeToggle_Toggled"/>
                                    </Grid>
                                    <muxc:InfoBar IsOpen="True" IsClosable="False" Severity="Warning" Margin="0,10,0,0">
                                        <muxc:InfoBar.Content>
                                            <TextBlock x:Uid="S_SameSwitchAsLegionSpace" Text="Same switch as Legion Space. The controllers reconnect for a few seconds, and in D-Input the Xbox / Game Bar interface may stop responding to them - use the touchscreen to switch back." FontSize="12" TextWrapping="Wrap" Margin="0,0,0,12" />
                                        </muxc:InfoBar.Content>
                                    </muxc:InfoBar>
                                </StackPanel>
                            </Border>

                            <!-- Touchpad & Vibration Card (hidden on devices without HID touchpad support) -->
                            <StackPanel x:Name="TouchpadVibrationSection">
                                <Border Style="{StaticResource CardStyle}">
                                    <StackPanel>
                                        <Grid Background="Transparent" Tapped="ExpandHeader_Tapped">
                                            <ctk:SettingsCard Style="{StaticResource HeaderRowStyle}">
                                                <ctk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE877;"/></ctk:SettingsCard.HeaderIcon>
                                                <ctk:SettingsCard.Header>
                                                    <TextBlock x:Uid="S_TouchpadVibration" Text="Touchpad &amp; Vibration" />
                                                </ctk:SettingsCard.Header>
                                                <ctk:SettingsCard.Description>
                                                    <TextBlock x:Uid="S_TouchpadAndHapticFeedbackSettings" Text="Touchpad and haptic feedback settings" />
                                                </ctk:SettingsCard.Description>
                                                <ToggleButton x:Name="TouchpadVibrationExpandToggle" MinWidth="44" MinHeight="40"
                                                      IsChecked="False"
                                                      Background="Transparent"
                                                      BorderThickness="0"
                                                      Padding="8,4"
                                                      Click="TouchpadVibrationExpandToggle_Click"
                                                      XYFocusUp="{x:Bind LegionNavItem}">
                                            <FontIcon x:Name="TouchpadVibrationExpandIcon" Glyph="&#xE70D;" FontSize="13"/>
                                        </ToggleButton>
                                            </ctk:SettingsCard>
                                        </Grid>
                                    <StackPanel x:Name="TouchpadVibrationContent" Spacing="12" Margin="0,12,0,0" Visibility="Collapsed">
                                        <!-- Touchpad Toggle -->
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:Uid="S_TouchpadEnabled" Text="Touchpad Enabled" Grid.Column="0" VerticalAlignment="Center" Foreground="#B9C0CC" FontSize="14" />
                                            <ToggleSwitch x:Name="LegionTouchpadToggle"
                                                          Grid.Column="1"
                                                          Style="{StaticResource ModernToggleStyle}"
                                                          IsOn="True"
                                                          XYFocusUp="{x:Bind LegionNavItem}"
                                                          XYFocusDown="{x:Bind LegionVibrationComboBox}"/>
                                        </Grid>

                                        <!-- Vibration Intensity -->
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:Uid="S_VibrationIntensity" Text="Vibration Intensity" Grid.Column="0" VerticalAlignment="Center" Foreground="#B9C0CC" FontSize="14" />
                                            <ComboBox x:Name="LegionVibrationComboBox"
                                                      Grid.Column="1"
                                                      Width="120"
                                                      Style="{StaticResource ModernComboBoxStyle}"
                                                      SelectedIndex="2">
                                                <x:String>Off</x:String>
                                                <x:String>Weak</x:String>
                                                <x:String>Medium</x:String>
                                                <x:String>Strong</x:String>
                                            </ComboBox>
                                        </Grid>

                                        <!-- Vibration Mode -->
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:Uid="S_VibrationMode" Text="Vibration Mode" Grid.Column="0" VerticalAlignment="Center" Foreground="#B9C0CC" FontSize="14" />
                                            <ComboBox x:Name="LegionVibrationModeComboBox"
                                                      Grid.Column="1"
                                                      Width="120"
                                                      Style="{StaticResource ModernComboBoxStyle}"
                                                      SelectedIndex="0">
                                                <x:String>FPS</x:String>
                                                <x:String>Racing</x:String>
                                                <x:String>AVG</x:String>
                                                <x:String>SPG</x:String>
                                                <x:String>RPG</x:String>
                                            </ComboBox>
                                        </Grid>

                                        <!-- Touchpad Haptics Dropdown -->
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:Uid="S_TouchpadHaptics" Text="Touchpad Haptics" Grid.Column="0" VerticalAlignment="Center" Foreground="#B9C0CC" FontSize="14" />
                                            <ComboBox x:Name="LegionTouchpadVibrationComboBox"
                                                      Grid.Column="1"
                                                      SelectedIndex="2"
                                                      Width="120"
                                                      Style="{StaticResource ModernComboBoxStyle}">
                                                <x:String>Off</x:String>
                                                <x:String>Low</x:String>
                                                <x:String>Medium</x:String>
                                                <x:String>High</x:String>
                                            </ComboBox>
                                        </Grid>

                                        <!-- GoTweaks Haptics: standalone per-button LRA clicks (works outside emulation) -->
                                        <Border Height="1" Background="#22FFFFFF" Margin="0,4,0,4"/>
                                        <ctk:SettingsCard x:Uid="S_GoTweaksHaptics" Header="GoTweaks Haptics" Description="Tactile click on inputs, system-wide via the controller motors" Tapped="ToggleRow_Tapped">
                                            <ctk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE877;"/></ctk:SettingsCard.HeaderIcon>
                                            <ToggleSwitch x:Name="GoTweaksHapticsMasterToggle"
                                            Style="{StaticResource ModernToggleStyle}"
                                            IsOn="False"
                                            Toggled="GoTweaksHaptics_Changed"/>
                                        </ctk:SettingsCard>

                                        <StackPanel x:Name="GoTweaksHapticsGroupsPanel" Spacing="10" Margin="0,4,0,0" Visibility="Collapsed">
                                            <!-- Pulse length (tap duration) -->
                                            <StackPanel>
                                                <Grid>
                                                    <TextBlock x:Uid="S_PulseLength" Text="Pulse Length" FontSize="14" Foreground="#B9C0CC" />
                                                    <TextBlock x:Uid="GoTweaksHapticsPulseValue" x:Name="GoTweaksHapticsPulseValue" Text="10 ms" Style="{StaticResource CardValueStyle}" />
                                                </Grid>
                                                <Slider x:Name="GoTweaksHapticsPulseSlider"
                                                        Style="{StaticResource ModernSliderStyle}"
                                                        Minimum="4" Maximum="40" Value="10"
                                                        StepFrequency="1"
                                                        ValueChanged="GoTweaksHaptics_Changed"/>
                                            </StackPanel>
                                            <!-- Also click on release -->
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock x:Uid="S_ClickOnReleaseToo" Grid.Column="0" Text="Click on release too" VerticalAlignment="Center" Foreground="#B9C0CC" FontSize="14" />
                                                <ToggleSwitch x:Name="GoTweaksHapticsReleaseToggle" Grid.Column="1" MinWidth="0"
                                                              Style="{StaticResource ModernToggleStyle}" IsOn="False" Toggled="GoTweaksHaptics_Changed"/>
                                            </Grid>
                                            <!-- ABXY -->
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <ToggleSwitch x:Name="GoTweaksHapticsFaceToggle" Grid.Column="0" MinWidth="0"
                                                              Style="{StaticResource ModernToggleStyle}" IsOn="True" Toggled="GoTweaksHaptics_Changed"/>
                                                <TextBlock x:Uid="S_ABXYButtons" Grid.Column="1" Text="ABXY buttons" VerticalAlignment="Center" Foreground="#B9C0CC" FontSize="14" Margin="8,0,0,0" />
                                                <Slider x:Name="GoTweaksHapticsFaceSlider" Grid.Column="2" Width="110" Minimum="0" Maximum="100" Value="100"
                                                        StepFrequency="5" VerticalAlignment="Center" ValueChanged="GoTweaksHaptics_Changed"/>
                                            </Grid>
                                            <!-- Front -->
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <ToggleSwitch x:Name="GoTweaksHapticsFrontToggle" Grid.Column="0" MinWidth="0"
                                                              Style="{StaticResource ModernToggleStyle}" IsOn="True" Toggled="GoTweaksHaptics_Changed"/>
                                                <TextBlock x:Uid="S_FrontButtonsDPadStart" Grid.Column="1" Text="Front buttons (d-pad, start, bumpers)" VerticalAlignment="Center" Foreground="#B9C0CC" FontSize="14" Margin="8,0,0,0" />
                                                <Slider x:Name="GoTweaksHapticsFrontSlider" Grid.Column="2" Width="110" Minimum="0" Maximum="100" Value="100"
                                                        StepFrequency="5" VerticalAlignment="Center" ValueChanged="GoTweaksHaptics_Changed"/>
                                            </Grid>
                                            <!-- Back -->
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <ToggleSwitch x:Name="GoTweaksHapticsBackToggle" Grid.Column="0" MinWidth="0"
                                                              Style="{StaticResource ModernToggleStyle}" IsOn="True" Toggled="GoTweaksHaptics_Changed"/>
                                                <TextBlock x:Uid="S_BackButtonsPaddles" Grid.Column="1" Text="Back buttons / paddles" VerticalAlignment="Center" Foreground="#B9C0CC" FontSize="14" Margin="8,0,0,0" />
                                                <Slider x:Name="GoTweaksHapticsBackSlider" Grid.Column="2" Width="110" Minimum="0" Maximum="100" Value="100"
                                                        StepFrequency="5" VerticalAlignment="Center" ValueChanged="GoTweaksHaptics_Changed"/>
                                            </Grid>
                                            <!-- Triggers -->
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <ToggleSwitch x:Name="GoTweaksHapticsTriggerToggle" Grid.Column="0" MinWidth="0"
                                                              Style="{StaticResource ModernToggleStyle}" IsOn="True" Toggled="GoTweaksHaptics_Changed"/>
                                                <TextBlock x:Uid="S_TriggersLTRT" Grid.Column="1" Text="Triggers (LT / RT)" VerticalAlignment="Center" Foreground="#B9C0CC" FontSize="14" Margin="8,0,0,0" />
                                                <Slider x:Name="GoTweaksHapticsTriggerSlider" Grid.Column="2" Width="110" Minimum="0" Maximum="100" Value="100"
                                                        StepFrequency="5" VerticalAlignment="Center" ValueChanged="GoTweaksHaptics_Changed"/>
                                            </Grid>
                                        </StackPanel>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                        </StackPanel>
                        <StackPanel x:Name="LegionViiperSection" Visibility="Collapsed">
                            <Border x:Name="ControllerEmulationCard" Style="{StaticResource CardStyle}">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                            <TextBlock x:Uid="S_EnableVIIPER" Text="Controller emulation (VIIPER)" Style="{StaticResource CardTitleStyle}" />
                                            <TextBlock x:Uid="ControllerEmulationStatusText" x:Name="ControllerEmulationStatusText" Text="Waiting for helper"
                                                       Style="{StaticResource CardCaptionStyle}" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <ToggleSwitch x:Uid="ControllerEmulationEnabledToggle" x:Name="ControllerEmulationEnabledToggle" Grid.Column="1"
                                                      AutomationProperties.Name="Enable VIIPER"
                                                      Style="{StaticResource ModernToggleStyle}" IsEnabled="False" />
                                    </Grid>
                                    <StackPanel Margin="0,12,0,0"
                                                Visibility="{x:Bind ControllerEmulationEnabledToggle.IsOn, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}">
                                        <ctk:SettingsCard x:Uid="S_HideNativeControllerHIDOn" Header="Hide native controller HID on next activation" Description="Requires HidHide. The physical XInput interface can remain visible." Tapped="ToggleRow_Tapped">
                                            <ctk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xED1A;"/></ctk:SettingsCard.HeaderIcon>
                                            <ToggleSwitch x:Uid="ViiperSuppressPhysicalToggle" x:Name="ViiperSuppressPhysicalToggle"
                                            AutomationProperties.Name="Hide native controller HID on next activation"
                                            Style="{StaticResource ModernToggleStyle}" />
                                        </ctk:SettingsCard>
                                    <StackPanel x:Name="ControllerEmulationContent" Visibility="Collapsed" Margin="0,12,0,0">
                                    <StackPanel x:Name="GyroActivationContent" Visibility="Collapsed">
                                        <ctk:SettingsCard x:Uid="S_GyroActivation" Header="Gyro Activation" Description="Always on, hold, or toggle by button">
                                            <ctk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE809;"/></ctk:SettingsCard.HeaderIcon>
                                            <ComboBox x:Name="ControllerEmulationGyroActivationModeComboBox" Width="180"
                                            Style="{StaticResource ModernComboBoxStyle}"
                                            IsEnabled="False"
                                            >
                                            <ComboBoxItem x:Uid="S_AlwaysOn" Content="Always On" Tag="0" IsSelected="True" />
                                            <ComboBoxItem x:Uid="S_Hold" Content="Hold" Tag="1" />
                                            <ComboBoxItem x:Uid="S_Toggle" Content="Toggle" Tag="2" />
                                            </ComboBox>
                                        </ctk:SettingsCard>

                                        <ctk:SettingsCard x:Uid="S_ActivationButton" Margin="0,12,0,0" Header="Activation Button" Description="Button used for hold or toggle activation">
                                            <ctk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE713;"/></ctk:SettingsCard.HeaderIcon>
                                            <ComboBox x:Name="ControllerEmulationGyroActivationButtonComboBox" Width="180"
                                            Style="{StaticResource ModernComboBoxStyle}"
                                            IsEnabled="False">
                                            <ComboBoxItem x:Uid="S_None" Content="None" Tag="0" />
                                            <ComboBoxItem x:Uid="S_RightTrigger" Content="Right Trigger" Tag="1" IsSelected="True" />
                                            <ComboBoxItem x:Uid="S_LeftTrigger" Content="Left Trigger" Tag="2" />
                                            <ComboBoxItem x:Uid="S_RightBumper" Content="Right Bumper" Tag="3" />
                                            <ComboBoxItem x:Uid="S_LeftBumper" Content="Left Bumper" Tag="4" />
                                            <ComboBoxItem Content="A" Tag="5"/>
                                            <ComboBoxItem Content="B" Tag="6"/>
                                            <ComboBoxItem Content="X" Tag="7"/>
                                            <ComboBoxItem Content="Y" Tag="8"/>
                                            <ComboBoxItem x:Uid="S_RightStickClick" Content="Right Stick Click" Tag="9" />
                                            <ComboBoxItem x:Uid="S_LeftStickClick" Content="Left Stick Click" Tag="10" />
                                            <ComboBoxItem x:Uid="S_DPadUp" Content="D-Pad Up" Tag="11" />
                                            <ComboBoxItem x:Uid="S_DPadDown" Content="D-Pad Down" Tag="12" />
                                            <ComboBoxItem x:Uid="S_DPadLeft" Content="D-Pad Left" Tag="13" />
                                            <ComboBoxItem x:Uid="S_DPadRight" Content="D-Pad Right" Tag="14" />
                                            <ComboBoxItem x:Uid="S_Start" Content="Start" Tag="15" />
                                            <ComboBoxItem x:Uid="S_Back" Content="Back" Tag="16" />
                                            <!-- Legion-only auxiliary buttons (FR-1, issue #79). Reads from the cached LegionHid sample's AuxButtons; on non-Legion handhelds these never trigger. -->
                                            <ComboBoxItem x:Uid="S_M3BackRLower" Content="M3 (back R lower)" Tag="17" />
                                            <ComboBoxItem x:Uid="S_M1SideGripL" Content="M1 (side grip L)" Tag="18" />
                                            <ComboBoxItem x:Uid="S_M2SideGripR" Content="M2 (side grip R)" Tag="19" />
                                            <ComboBoxItem x:Uid="S_Y1BackLUpper" Content="Y1 (back L upper)" Tag="20" />
                                            <ComboBoxItem x:Uid="S_Y2BackLLower" Content="Y2 (back L lower)" Tag="21" />
                                            <ComboBoxItem x:Uid="S_Y3BackRUpper" Content="Y3 (back R upper)" Tag="22" />
                                            </ComboBox>
                                        </ctk:SettingsCard>
                                    </StackPanel>
                                    <StackPanel x:Name="JoystickOutputContent" Visibility="Collapsed" Margin="0,12,0,0">
                                        <!-- Send to Joystick -->
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:Uid="S_SendToJoystick" Text="Send to Joystick" FontSize="14" Foreground="#B9C0CC" VerticalAlignment="Center" />
                                            <ComboBox x:Name="ControllerEmulationStickSelectComboBox"
                                                      Grid.Column="1" Width="180"
                                                      Style="{StaticResource ModernComboBoxStyle}" IsEnabled="False">
                                                <ComboBoxItem x:Uid="S_Left" Content="Left" Tag="0" />
                                                <ComboBoxItem x:Uid="S_Right" Content="Right" Tag="1" IsSelected="True" />
                                            </ComboBox>
                                        </Grid>

                                        <!-- 3DOF to 2D Conversion -->
                                        <ctk:SettingsCard x:Uid="S_3DOFTo2DConversion" Margin="0,10,0,0" Header="3DOF to 2D Conversion" Description="Map gyro axes to stick output">
                                            <ctk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE713;"/></ctk:SettingsCard.HeaderIcon>
                                            <ComboBox x:Name="StickConversionComboBox" Width="180"
                                            Style="{StaticResource ModernComboBoxStyle}" IsEnabled="False">
                                            <ComboBoxItem x:Uid="S_YawLaserPointerFromBack" Content="Yaw (laser pointer from back)" Tag="0" IsSelected="True" />
                                            <ComboBoxItem x:Uid="S_Roll" Content="Roll" Tag="1" />
                                            <ComboBoxItem x:Uid="S_YawRoll" Content="Yaw + Roll" Tag="2" />
                                            <ComboBoxItem x:Uid="S_PlayerSpaceGravityAware" Content="Player Space (gravity-aware)" Tag="3" />
                                            <ComboBoxItem x:Uid="S_WorldSpaceGravityAware" Content="World Space (gravity-aware)" Tag="4" />
                                            </ComboBox>
                                        </ctk:SettingsCard>

                                        <!-- Orientation -->
                                        <ctk:SettingsCard x:Uid="S_HoldOrientation" Margin="0,10,0,0" Header="Hold Orientation" Description="How you hold the device. Flat = on a table, Handheld = held in front of you (default).">
                                            <ctk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE713;"/></ctk:SettingsCard.HeaderIcon>
                                            <ComboBox x:Name="StickOrientationV2ComboBox" Width="220"
                                            Style="{StaticResource ModernComboBoxStyle}" IsEnabled="False">
                                            <ComboBoxItem x:Uid="S_FlatParallelToGround" Content="Flat (parallel to ground)" Tag="0" IsSelected="True" />
                                            <ComboBoxItem x:Uid="S_HandheldHeldInFront" Content="Handheld (held in front)" Tag="1" />
                                            </ComboBox>
                                        </ctk:SettingsCard>

                                        <!-- Invert Y -->
                                        <Grid Margin="0,10,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:Uid="S_InvertYOutput" Text="Invert Y Output" FontSize="14" Foreground="#B9C0CC" VerticalAlignment="Center" />
                                            <ToggleSwitch x:Name="ControllerEmulationStickInvertYToggle"
                                                          Grid.Column="1" IsOn="False"
                                                          Style="{StaticResource ModernToggleStyle}" IsEnabled="False"/>
                                        </Grid>

                                        <!-- Invert X -->
                                        <Grid Margin="0,10,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:Uid="S_InvertXOutput" Text="Invert X Output" FontSize="14" Foreground="#B9C0CC" VerticalAlignment="Center" />
                                            <ToggleSwitch x:Name="ControllerEmulationStickInvertXToggle"
                                                          Grid.Column="1" IsOn="False"
                                                          Style="{StaticResource ModernToggleStyle}" IsEnabled="False"/>
                                        </Grid>

                                        <!-- Sensitivity -->
                                        <Grid Margin="0,10,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:Uid="S_Sensitivity" Text="Sensitivity" FontSize="14" Foreground="#B9C0CC" VerticalAlignment="Center" />
                                            <TextBlock x:Name="StickSensitivityV2ValueText" Grid.Column="1" Text="1.00x"
                                                       FontSize="14" Foreground="{StaticResource SystemAccentBrush}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        </Grid>
                                        <Slider x:Name="StickSensitivityV2Slider"
                                                Style="{StaticResource ModernSliderStyle}"
                                                Minimum="1" Maximum="400" TickFrequency="1" SnapsTo="Ticks" Value="100"
                                                IsEnabled="False"/>
                                    </StackPanel>
                                </StackPanel>
                                    <StackPanel x:Name="ViiperEmulationContent" Margin="0,12,0,0">
                                    <Border Background="#1E2A3E" BorderBrush="#3D5A80" BorderThickness="1" CornerRadius="6" Padding="12">
                                        <StackPanel>
                                            <TextBlock x:Uid="S_VIIPERDeviceConfiguration" Text="VIIPER Device Configuration" FontSize="14" FontWeight="SemiBold" Foreground="#4AB3F4" />
                                            <TextBlock x:Uid="S_ActiveBackendVIIPERUSBIPChanges" Text="Active backend: VIIPER (USBIP). Changes take effect immediately (hot-swap)." FontSize="12" Foreground="#B9C0CC" Margin="0,2,0,10" TextWrapping="Wrap" />

                                            <TextBlock x:Uid="S_VirtualDevice" Text="Virtual device" FontSize="13" Foreground="#B9C0CC" Margin="0,0,0,4" />
                                            <ComboBox x:Name="ViiperDeviceTypeComboBox" Style="{StaticResource ModernComboBoxStyle}" HorizontalAlignment="Stretch">
                                                <ComboBoxItem x:Uid="S_Xbox360" Content="Xbox 360" Tag="xbox360" />
                                                <ComboBoxItem x:Uid="S_Steam" Content="Steam" Tag="steam-generic" />
                                                <ComboBoxItem x:Uid="S_SonyVirtualDevice" Content="Sony Virtual Device" Tag="sony" />
                                                <ComboBoxItem x:Uid="S_NintendoVirtualDevice" Content="Nintendo Virtual Device" Tag="nintendo" />
                                            </ComboBox>

                                            <StackPanel x:Name="ViiperSteamSubDevicePanel" Visibility="Collapsed" Margin="0,12,0,0">
                                                <TextBlock x:Uid="S_SteamSubDevice" Text="Steam sub-device" FontSize="13" Foreground="#B9C0CC" Margin="0,0,0,4" />
                                                <ComboBox x:Name="ViiperSteamSubDeviceComboBox" Style="{StaticResource ModernComboBoxStyle}" HorizontalAlignment="Stretch">
                                                    <ComboBoxItem x:Uid="S_SteamDeck" Content="Steam Deck" Tag="steam-deck" />
                                                    <ComboBoxItem x:Uid="S_LegionGo" Content="Legion Go" Tag="legion-go" />
                                                    <ComboBoxItem x:Uid="S_LegionGoS" Content="Legion Go S" Tag="legion-go-s" />
                                                    <ComboBoxItem x:Uid="S_LegionGo2" Content="Legion Go 2" Tag="legion-go-2" />
                                                    <ComboBoxItem x:Uid="S_ROGAlly" Content="ROG Ally" Tag="rog-ally" />
                                                    <ComboBoxItem x:Uid="S_MSIClaw" Content="MSI Claw" Tag="msi-claw" />
                                                    <ComboBoxItem x:Uid="S_ZotacZone" Content="Zotac Zone" Tag="zotac-zone" />
                                                    <ComboBoxItem x:Uid="S_SteamControllerV1Gordon" Content="Steam Controller V1 (Gordon)" Tag="gordon" />
                                                </ComboBox>
                                            </StackPanel>

                                            <StackPanel x:Name="ViiperSonySubDevicePanel" Visibility="Collapsed" Margin="0,12,0,0">
                                                <TextBlock x:Uid="S_SonySubDevice" Text="Sony sub-device" FontSize="13" Foreground="#B9C0CC" Margin="0,0,0,4" />
                                                <ComboBox x:Name="ViiperSonySubDeviceComboBox" Style="{StaticResource ModernComboBoxStyle}" HorizontalAlignment="Stretch">
                                                    <ComboBoxItem x:Uid="S_DualSense" Content="DualSense" Tag="dualsense" />
                                                    <ComboBoxItem x:Uid="S_DualSenseEdge" Content="DualSense Edge" Tag="dualsense-edge" />
                                                    <ComboBoxItem x:Uid="S_DualShock4" Content="DualShock 4" Tag="dualshock4" />
                                                </ComboBox>
                                            </StackPanel>

                                            <StackPanel x:Name="ViiperNintendoSubDevicePanel" Visibility="Collapsed" Margin="0,12,0,0">
                                                <TextBlock x:Uid="S_NintendoSubDevice" Text="Nintendo sub-device" FontSize="13" Foreground="#B9C0CC" Margin="0,0,0,4" />
                                                <ComboBox x:Name="ViiperNintendoSubDeviceComboBox" Style="{StaticResource ModernComboBoxStyle}" HorizontalAlignment="Stretch">
                                                    <ComboBoxItem x:Uid="S_SwitchPro" Content="Switch Pro" Tag="switchpro" />
                                                    <ComboBoxItem x:Uid="S_SwitchPro2" Content="Switch Pro 2" Tag="switchpro2" />
                                                    <ComboBoxItem x:Uid="S_JoyConLeft" Content="Joy-Con (Left)" Tag="joycon-left" />
                                                    <ComboBoxItem x:Uid="S_JoyConRight" Content="Joy-Con (Right)" Tag="joycon-right" />
                                                    <ComboBoxItem x:Uid="S_JoyConPairLR" Content="Joy-Con Pair (L + R)" Tag="joycon-pair" />
                                                </ComboBox>
                                            </StackPanel>

                                            <!-- Joy-Con Pair: per-half gyro routing (only shown for Joy-Con Pair) -->
                                            <StackPanel x:Name="ViiperJoyconGyroPerHalfPanel" Visibility="Collapsed" Margin="0,12,0,0">
                                                <ctk:SettingsCard x:Uid="S_PerHalfGyro" Header="Per-half gyro" Description="Each Joy-Con uses its own controller's motion (off = both share the selected source)" Tapped="ToggleRow_Tapped">
                                                    <ctk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE809;"/></ctk:SettingsCard.HeaderIcon>
                                                    <ToggleSwitch x:Name="ViiperJoyconGyroPerHalfToggle"
                                                    Style="{StaticResource ModernToggleStyle}"
                                                    IsOn="False"/>
                                                </ctk:SettingsCard>
                                            </StackPanel>

                                            <TextBlock x:Uid="S_InputSource" Text="Input source" FontSize="13" Foreground="#B9C0CC" Margin="0,12,0,4" />
                                            <ComboBox x:Name="ViiperInputSourceComboBox" Style="{StaticResource ModernComboBoxStyle}" HorizontalAlignment="Stretch">
                                                <ComboBoxItem x:Uid="S_XInputAnyController" Content="XInput (any controller)" Tag="XInput" />
                                                <ComboBoxItem x:Uid="S_LegionGoHIDNative" Content="Legion Go HID (native)" Tag="LegionHid" />
                                            </ComboBox>

                                            <TextBlock x:Uid="S_GyroSource" Text="Gyro source" FontSize="13" Foreground="#B9C0CC" Margin="0,12,0,4" />
                                            <ComboBox x:Name="ViiperGyroSourceComboBox" Style="{StaticResource ModernComboBoxStyle}" HorizontalAlignment="Stretch">
                                                <ComboBoxItem x:Uid="S_None" Content="None" Tag="None" />
                                                <ComboBoxItem x:Uid="S_LeftController_2" Content="Left controller" Tag="Left" />
                                                <ComboBoxItem x:Uid="S_RightController_2" Content="Right controller" Tag="Right" />
                                                <ComboBoxItem x:Uid="S_MixedLRAveraged" Content="Mixed (L+R averaged)" Tag="Mixed" />
                                                <ComboBoxItem x:Uid="S_HandheldDeviceIMU" Content="Handheld (device IMU)" Tag="Handheld" />
                                            </ComboBox>

                                            <!-- Sony-target gyro sign mode. Default off = TOTK-correct
                                                 (yaw=+gz, roll=-gy). When on, reverts to the upstream pattern
                                                 (yaw=-gz, roll=+gy) which Steam Input's gyro-to-mouse mapping
                                                 sometimes prefers. Affects DS4 / DualSense / DualSense Edge —
                                                 Switch Pro and Steam Deck builders are unaffected. -->
                                            <ctk:SettingsCard x:Uid="S_AlternateGyroConvention" Margin="0,12,0,0" Header="Alternate gyro convention" Description="Flips gyro polarity for DS4/DualSense or rotates 90&#176; for Steam Deck/Switch Pro. Try this if Steam gyro moves the wrong way." Tapped="ToggleRow_Tapped">
                                                <ctk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE809;"/></ctk:SettingsCard.HeaderIcon>
                                                <ToggleSwitch x:Uid="ViiperAlternateGyroConventionToggle" x:Name="ViiperAlternateGyroConventionToggle"
                                                OnContent="On" OffContent="Off"
                                                Style="{StaticResource ModernToggleStyle}"
                                                IsOn="False" />
                                            </ctk:SettingsCard>

                                            <!-- Software Gyro Bias (Steam-style one-shot calibration). Captures the
                                                 current resting gyro reading and subtracts it from all subsequent
                                                 samples so any small post-firmware-cal drift gets zeroed across
                                                 every gyro consumer (DS4 / DualSense / Xbox native gyro, stick-gyro,
                                                 legacy CE). Separate from the Legion controller firmware calibration. -->
                                            <Border Background="#1F1F1F" CornerRadius="6" Padding="10" Margin="0,12,0,0">
                                                <StackPanel>
                                                    <TextBlock x:Uid="S_SoftwareGyroBias" Text="Software gyro bias" FontSize="14" Foreground="#B9C0CC" FontWeight="SemiBold" />
                                                    <TextBlock x:Uid="S_LayTheDeviceFlatOn" Margin="0,4,0,0"
                                                               FontSize="12" Foreground="#B9C0CC" TextWrapping="Wrap"
                                                               Text="Lay the device flat on a still surface, then press Calibrate to zero out gyro drift. This is separate from the Legion controller firmware calibration." />
                                                    <Grid Margin="0,8,0,0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Button x:Uid="CalibrateGyroBiasButton" x:Name="CalibrateGyroBiasButton"
                                                                Grid.Column="0"
                                                                Content="Calibrate gyro bias"
                                                                Click="CalibrateGyroBiasButton_Click"
                                                                Margin="0,0,6,0" />
                                                        <Button x:Uid="ResetGyroBiasButton" x:Name="ResetGyroBiasButton"
                                                                Grid.Column="1"
                                                                Content="Reset"
                                                                Click="ResetGyroBiasButton_Click" />
                                                    </Grid>
                                                    <TextBlock x:Uid="GyroBiasStatusText" x:Name="GyroBiasStatusText"
                                                               Margin="0,8,0,0"
                                                               FontSize="12" Foreground="#B9C0CC" TextWrapping="Wrap"
                                                               Text="Not calibrated" />
                                                </StackPanel>
                                            </Border>

                                            <!-- IMU Axis Mapping — per-axis source selector (with optional flip).
                                                 Only relevant for native-motion target types (DS4, DualSense,
                                                 joycon-pair etc.) where games read the emulated device's IMU
                                                 channels directly. Hidden for xbox360 / xboxelite2 / steam /
                                                 switchpro family which all go through the synthesized stick
                                                 gyro path and ignore IMU bytes. -->
                                            <StackPanel x:Name="ViiperGyroAxisMappingSection" Visibility="Collapsed">
                                            <TextBlock x:Uid="S_IMUAxisMapping" Text="IMU axis mapping" FontSize="13" Foreground="#B9C0CC" Margin="0,12,0,4" />
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="X→" FontSize="12" Foreground="#B9C0CC" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                <ComboBox x:Name="ViiperGyroAxisMapXComboBox" Style="{StaticResource ModernComboBoxStyle}" Grid.Column="1" HorizontalAlignment="Stretch" Margin="0,0,6,0" FontSize="13">
                                                    <ComboBoxItem Content="X"  Tag="X"/>
                                                    <ComboBoxItem Content="Y"  Tag="Y"/>
                                                    <ComboBoxItem Content="Z"  Tag="Z"/>
                                                    <ComboBoxItem Content="-X" Tag="-X"/>
                                                    <ComboBoxItem Content="-Y" Tag="-Y"/>
                                                    <ComboBoxItem Content="-Z" Tag="-Z"/>
                                                </ComboBox>
                                                <TextBlock Grid.Column="2" Text="Y→" FontSize="12" Foreground="#B9C0CC" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                <ComboBox x:Name="ViiperGyroAxisMapYComboBox" Style="{StaticResource ModernComboBoxStyle}" Grid.Column="3" HorizontalAlignment="Stretch" Margin="0,0,6,0" FontSize="13">
                                                    <ComboBoxItem Content="X"  Tag="X"/>
                                                    <ComboBoxItem Content="Y"  Tag="Y"/>
                                                    <ComboBoxItem Content="Z"  Tag="Z"/>
                                                    <ComboBoxItem Content="-X" Tag="-X"/>
                                                    <ComboBoxItem Content="-Y" Tag="-Y"/>
                                                    <ComboBoxItem Content="-Z" Tag="-Z"/>
                                                </ComboBox>
                                                <TextBlock Grid.Column="4" Text="Z→" FontSize="12" Foreground="#B9C0CC" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                <ComboBox x:Name="ViiperGyroAxisMapZComboBox" Style="{StaticResource ModernComboBoxStyle}" Grid.Column="5" HorizontalAlignment="Stretch" FontSize="13">
                                                    <ComboBoxItem Content="X"  Tag="X"/>
                                                    <ComboBoxItem Content="Y"  Tag="Y"/>
                                                    <ComboBoxItem Content="Z"  Tag="Z"/>
                                                    <ComboBoxItem Content="-X" Tag="-X"/>
                                                    <ComboBoxItem Content="-Y" Tag="-Y"/>
                                                    <ComboBoxItem Content="-Z" Tag="-Z"/>
                                                </ComboBox>
                                            </Grid>
                                            </StackPanel>

                                            <!-- Gyro → Right Stick (synthesized).
                                                 Visible only when targetType has no native motion field
                                                 (xbox360, xboxelite2, switchpro family, etc.) — see
                                                 ViiperStickGyroProcessor.IsApplicableForTarget. The four
                                                 controls below mirror the legacy ControllerEmulation
                                                 stick-gyro controls so the same widget property pushes
                                                 values to the helper; no separate property surface. -->
                                            <StackPanel x:Name="ViiperStickGyroSection" Visibility="Collapsed" Margin="0,12,0,0">
                                                <Grid Background="Transparent" MinHeight="48" Tapped="ExpandHeader_Tapped">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <!-- Header text is dynamic: reflects "Gyro → Left Stick" or "Gyro → Right
                                                         Stick" based on the Send-to-joystick setting so the title doesn't lie
                                                         when stickSelect is flipped. Driven from C# whenever the routing changes. -->
                                                    <TextBlock x:Uid="ViiperStickGyroSectionHeader" x:Name="ViiperStickGyroSectionHeader"
                                                               Grid.Column="0"
                                                               Text="Gyro → Right Stick"
                                                               FontSize="14" FontWeight="SemiBold" Foreground="#4AB3F4"
                                                               VerticalAlignment="Center" />
                                                    <!-- Configuration summary badge: at-a-glance "ON: Hold RT" / "ON: Always" /
                                                         "OFF" so first-time users can verify activation without expanding any
                                                         groups. Pure widget-side computation; no helper round-trip. -->
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Border x:Name="ViiperStickGyroStatusBadge"
                                                                Background="#1F2A3D"
                                                                BorderBrush="#3D5A80"
                                                                BorderThickness="1"
                                                                CornerRadius="4"
                                                                Padding="6,2"
                                                                VerticalAlignment="Center">
                                                            <TextBlock x:Uid="ViiperStickGyroStatusBadgeText" x:Name="ViiperStickGyroStatusBadgeText"
                                                                       Text="OFF"
                                                                       FontSize="12"
                                                                       Foreground="#B9C0CC" />
                                                        </Border>
                                                        <ToggleButton x:Name="ViiperStickGyroExpandButton" MinWidth="44" MinHeight="40" Width="22" Height="22" Padding="0" Margin="6,0,0,0"
                                                                      Background="Transparent" BorderThickness="0" VerticalAlignment="Center"
                                                                      Click="ViiperStickGyroExpandButton_Click">
                                                            <FontIcon x:Name="ViiperStickGyroExpandIcon" Glyph="&#xE70D;" FontSize="12"/>
                                                        </ToggleButton>
                                                    </StackPanel>
                                                </Grid>
                                                <StackPanel x:Name="ViiperStickGyroContent" Visibility="Collapsed">
                                                <TextBlock x:Uid="S_SynthesizesAStickContributionFrom" Text="Synthesizes a stick contribution from gyro motion for emulated targets without a native motion field (Xbox 360, Xbox Elite 2, Switch Pro)."
                                                           FontSize="12" Foreground="#B9C0CC" TextWrapping="Wrap" Margin="0,2,0,8" />

                                                <!-- Master enable.
                                                     Off = raw stick passthrough (legacy behavior pre-2152). On = synthesize gyro
                                                     contribution into the chosen stick. Default true. -->
                                                <ctk:SettingsCard x:Uid="S_EnableGyroStick" Margin="0,0,0,8" Header="Enable gyro → stick" Description="Off = raw stick passthrough; processor short-circuits." Tapped="ToggleRow_Tapped">
                                                    <ctk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE809;"/></ctk:SettingsCard.HeaderIcon>
                                                    <ToggleSwitch x:Name="ViiperStickGyroEnabledToggle"
                                                    Style="{StaticResource ModernToggleStyle}"/>
                                                </ctk:SettingsCard>

                                                <TextBlock x:Uid="S_ActivationMode" Text="Activation mode" FontSize="13" Foreground="#B9C0CC" Margin="0,0,0,4" />
                                                <ComboBox x:Name="ViiperStickGyroActivationModeComboBox" Style="{StaticResource ModernComboBoxStyle}" HorizontalAlignment="Stretch"
                                                          SelectionChanged="ViiperStickGyroActivationModeComboBox_SelectionChanged">
                                                    <ComboBoxItem x:Uid="S_AlwaysOn" Content="Always On" Tag="0" IsSelected="True" />
                                                    <ComboBoxItem x:Uid="S_Hold" Content="Hold" Tag="1" />
                                                    <ComboBoxItem x:Uid="S_Toggle" Content="Toggle" Tag="2" />
                                                </ComboBox>

                                                <TextBlock x:Uid="S_ActivationButton_2" Text="Activation button" FontSize="13" Foreground="#B9C0CC" Margin="0,8,0,4" />
                                                <ComboBox x:Name="ViiperStickGyroActivationButtonComboBox" Style="{StaticResource ModernComboBoxStyle}" HorizontalAlignment="Stretch"
                                                          SelectionChanged="ViiperStickGyroActivationButtonComboBox_SelectionChanged">
                                                    <ComboBoxItem x:Uid="S_None" Content="None" Tag="0" />
                                                    <ComboBoxItem x:Uid="S_RightTrigger" Content="Right Trigger" Tag="1" IsSelected="True" />
                                                    <ComboBoxItem x:Uid="S_LeftTrigger" Content="Left Trigger" Tag="2" />
                                                    <ComboBoxItem x:Uid="S_RightBumper" Content="Right Bumper" Tag="3" />
                                                    <ComboBoxItem x:Uid="S_LeftBumper" Content="Left Bumper" Tag="4" />
                                                    <ComboBoxItem Content="A" Tag="5"/>
                                                    <ComboBoxItem Content="B" Tag="6"/>
                                                    <ComboBoxItem Content="X" Tag="7"/>
                                                    <ComboBoxItem Content="Y" Tag="8"/>
                                                    <ComboBoxItem x:Uid="S_RightStickClick" Content="Right Stick Click" Tag="9" />
                                                    <ComboBoxItem x:Uid="S_LeftStickClick" Content="Left Stick Click" Tag="10" />
                                                    <ComboBoxItem x:Uid="S_DPadUp" Content="D-Pad Up" Tag="11" />
                                                    <ComboBoxItem x:Uid="S_DPadDown" Content="D-Pad Down" Tag="12" />
                                                    <ComboBoxItem x:Uid="S_DPadLeft" Content="D-Pad Left" Tag="13" />
                                                    <ComboBoxItem x:Uid="S_DPadRight" Content="D-Pad Right" Tag="14" />
                                                    <ComboBoxItem x:Uid="S_Start" Content="Start" Tag="15" />
                                                    <ComboBoxItem x:Uid="S_Back" Content="Back" Tag="16" />
                                                    <ComboBoxItem x:Uid="S_M3BackRLower" Content="M3 (back R lower)" Tag="17" />
                                                    <ComboBoxItem x:Uid="S_M1SideGripL" Content="M1 (side grip L)" Tag="18" />
                                                    <ComboBoxItem x:Uid="S_M2SideGripR" Content="M2 (side grip R)" Tag="19" />
                                                    <ComboBoxItem x:Uid="S_Y1BackLUpper" Content="Y1 (back L upper)" Tag="20" />
                                                    <ComboBoxItem x:Uid="S_Y2BackLLower" Content="Y2 (back L lower)" Tag="21" />
                                                    <ComboBoxItem x:Uid="S_Y3BackRUpper" Content="Y3 (back R upper)" Tag="22" />
                                                </ComboBox>

                                                <Grid Margin="0,8,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock x:Uid="S_Sensitivity" Text="Sensitivity" Grid.Column="0" VerticalAlignment="Center" FontSize="13" Foreground="#B9C0CC" />
                                                    <TextBlock x:Name="ViiperStickGyroSensitivityValueText" Grid.Column="1" Text="1.00x" FontSize="13" Foreground="#B9C0CC"/>
                                                </Grid>
                                                <Slider x:Name="ViiperStickGyroSensitivitySlider"
                                                        Minimum="1" Maximum="400" StepFrequency="1" SmallChange="5" LargeChange="25"
                                                        ValueChanged="ViiperStickGyroSensitivitySlider_ValueChanged"/>

                                                <!-- JSL gyro bias calibration. Place device flat and still for ~5s
                                                     after click; helper captures bias and persists it. -->
                                                <ctk:SettingsCard x:Uid="S_CalibrateGyroStickOutput" Margin="0,12,0,0" Header="Calibrate Gyro (Stick Output)" Description="Place device flat and still for ~5 seconds. Learns gyro bias for stick conversion.">
                                                    <ctk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE809;"/></ctk:SettingsCard.HeaderIcon>
                                                    <Button x:Uid="ViiperStickGyroCalibrateButton" x:Name="ViiperStickGyroCalibrateButton"
                                                    Content="Calibrate" Style="{StaticResource ModernButtonStyle}"
                                                    Click="ViiperStickGyroCalibrateButton_Click" />
                                                </ctk:SettingsCard>
                                                <TextBlock x:Name="ViiperStickGyroCalibrateStatusText"
                                                           Text=""
                                                           FontSize="12"
                                                           Foreground="#7FBFFF"
                                                           Margin="0,4,0,0"
                                                           TextWrapping="Wrap"
                                                           Visibility="Collapsed"/>

                                                <!-- Anti-deadzone tuning. Default 10% / 0.5°/s clears most game
                                                     stick deadzones while filtering sensor noise. -->
                                                <Grid Margin="0,12,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock x:Uid="S_AntiDeadzoneOfStick" Text="Anti-deadzone (% of stick)" Grid.Column="0" VerticalAlignment="Center" FontSize="13" Foreground="#B9C0CC" />
                                                    <TextBlock x:Name="ViiperStickGyroAntiDeadzoneValueText" Grid.Column="1" Text="10%" FontSize="13" Foreground="#B9C0CC"/>
                                                </Grid>
                                                <Slider x:Name="ViiperStickGyroAntiDeadzoneSlider"
                                                        Minimum="0" Maximum="30" StepFrequency="1" SmallChange="1" LargeChange="5"
                                                        ValueChanged="ViiperStickGyroAntiDeadzoneSlider_ValueChanged"/>

                                                <Grid Margin="0,8,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock x:Uid="S_InputThresholdS" Text="Input threshold (°/s)" Grid.Column="0" VerticalAlignment="Center" FontSize="13" Foreground="#B9C0CC" />
                                                    <TextBlock x:Name="ViiperStickGyroAntiDeadzoneThresholdValueText" Grid.Column="1" Text="0.3°/s" FontSize="13" Foreground="#B9C0CC"/>
                                                </Grid>
                                                <Slider x:Name="ViiperStickGyroAntiDeadzoneThresholdSlider"
                                                        Minimum="0" Maximum="50" StepFrequency="1" SmallChange="1" LargeChange="5"
                                                        ValueChanged="ViiperStickGyroAntiDeadzoneThresholdSlider_ValueChanged"/>

                                                <!-- Smoothing (EMA) on the calibrated gyro stream. -->
                                                <Grid Margin="0,12,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock x:Uid="S_SmoothingJitterReduction" Text="Smoothing (jitter reduction)" Grid.Column="0" VerticalAlignment="Center" FontSize="13" Foreground="#B9C0CC" />
                                                    <TextBlock x:Name="ViiperStickGyroSmoothingValueText" Grid.Column="1" Text="30%" FontSize="13" Foreground="#B9C0CC"/>
                                                </Grid>
                                                <Slider x:Name="ViiperStickGyroSmoothingSlider"
                                                        Minimum="0" Maximum="90" StepFrequency="5" SmallChange="5" LargeChange="10"
                                                        ValueChanged="ViiperStickGyroSmoothingSlider_ValueChanged"/>

                                                <!-- Per-axis vertical sensitivity scale (% of master). -->
                                                <Grid Margin="0,12,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock x:Uid="S_VerticalSensitivityOfMaster" Text="Vertical sensitivity (% of master)" Grid.Column="0" VerticalAlignment="Center" FontSize="13" Foreground="#B9C0CC" />
                                                    <TextBlock x:Name="ViiperStickGyroVerticalRatioValueText" Grid.Column="1" Text="100%" FontSize="13" Foreground="#B9C0CC"/>
                                                </Grid>
                                                <Slider x:Name="ViiperStickGyroVerticalRatioSlider"
                                                        Minimum="10" Maximum="200" StepFrequency="5" SmallChange="5" LargeChange="25"
                                                        ValueChanged="ViiperStickGyroVerticalRatioSlider_ValueChanged"/>

                                                <!-- Sensitivity curve preset. -->
                                                <Grid Margin="0,12,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock x:Uid="S_SensitivityCurve" Text="Sensitivity curve" Grid.Column="0" VerticalAlignment="Center" FontSize="13" Foreground="#B9C0CC" />
                                                    <ComboBox x:Name="ViiperStickGyroCurvePresetComboBox" Style="{StaticResource ModernComboBoxStyle}" Grid.Column="1" Width="180"
                                                              FontSize="13" SelectionChanged="ViiperStickGyroCurvePresetComboBox_SelectionChanged">
                                                        <ComboBoxItem x:Uid="S_LinearFlat" Content="Linear (flat)" Tag="0" />
                                                        <ComboBoxItem x:Uid="S_SlowPrecise" Content="Slow + Precise" Tag="1" />
                                                        <ComboBoxItem x:Uid="S_SnapAim" Content="Snap-aim" Tag="2" />
                                                    </ComboBox>
                                                </Grid>

                                                <!-- Tightening / fast-zone. -->
                                                <Grid Margin="0,12,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock x:Uid="S_TightenThresholdS0Off" Text="Tighten threshold (°/s, 0 = off)" Grid.Column="0" VerticalAlignment="Center" FontSize="13" Foreground="#B9C0CC" />
                                                    <TextBlock x:Name="ViiperStickGyroTightenThresholdValueText" Grid.Column="1" Text="0°/s" FontSize="13" Foreground="#B9C0CC"/>
                                                </Grid>
                                                <Slider x:Name="ViiperStickGyroTightenThresholdSlider"
                                                        Minimum="0" Maximum="500" StepFrequency="10" SmallChange="10" LargeChange="50"
                                                        ValueChanged="ViiperStickGyroTightenThresholdSlider_ValueChanged"/>
                                                <Grid Margin="0,8,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock x:Uid="S_TightenGainAtFullRamp" Text="Tighten gain (× at full ramp)" Grid.Column="0" VerticalAlignment="Center" FontSize="13" Foreground="#B9C0CC" />
                                                    <TextBlock x:Name="ViiperStickGyroTightenGainValueText" Grid.Column="1" Text="1.00×" FontSize="13" Foreground="#B9C0CC"/>
                                                </Grid>
                                                <Slider x:Name="ViiperStickGyroTightenGainSlider"
                                                        Minimum="100" Maximum="300" StepFrequency="10" SmallChange="10" LargeChange="50"
                                                        ValueChanged="ViiperStickGyroTightenGainSlider_ValueChanged"/>

                                                <!-- Stick-touch deactivation. -->
                                                <ctk:SettingsCard x:Uid="S_StickTouchDeactivation" Margin="0,12,0,0" Header="Stick-touch deactivation" Description="Suppress gyro while you move the physical stick. Useful in shooters where stick = big turns, gyro = fine aim." Tapped="ToggleRow_Tapped">
                                                    <ctk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE7FC;"/></ctk:SettingsCard.HeaderIcon>
                                                    <ToggleSwitch x:Name="ViiperStickGyroTouchDeactivateToggle"
                                                    OnContent="" OffContent="" MinWidth="0"
                                                    Toggled="ViiperStickGyroTouchDeactivateToggle_Toggled"/>
                                                </ctk:SettingsCard>
                                                <Grid Margin="0,8,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock x:Uid="S_TouchThresholdStick" Text="Touch threshold (% stick)" Grid.Column="0" VerticalAlignment="Center" FontSize="13" Foreground="#B9C0CC" />
                                                    <TextBlock x:Name="ViiperStickGyroTouchThresholdValueText" Grid.Column="1" Text="15%" FontSize="13" Foreground="#B9C0CC"/>
                                                </Grid>
                                                <Slider x:Name="ViiperStickGyroTouchThresholdSlider"
                                                        Minimum="0" Maximum="50" StepFrequency="1" SmallChange="1" LargeChange="5"
                                                        ValueChanged="ViiperStickGyroTouchThresholdSlider_ValueChanged"/>
                                                <Grid Margin="0,8,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock x:Uid="S_HoldOffAfterReleaseMs" Text="Hold-off after release (ms)" Grid.Column="0" VerticalAlignment="Center" FontSize="13" Foreground="#B9C0CC" />
                                                    <TextBlock x:Uid="ViiperStickGyroTouchHoldoffValueText" x:Name="ViiperStickGyroTouchHoldoffValueText" Grid.Column="1" Text="250 ms" FontSize="13" Foreground="#B9C0CC" />
                                                </Grid>
                                                <Slider x:Name="ViiperStickGyroTouchHoldoffSlider"
                                                        Minimum="0" Maximum="1000" StepFrequency="25" SmallChange="25" LargeChange="100"
                                                        ValueChanged="ViiperStickGyroTouchHoldoffSlider_ValueChanged"/>

                                                <!-- Live gyro readings (visualizer). -->
                                                <Border Margin="0,12,0,0" Padding="8" BorderBrush="#333" BorderThickness="1" CornerRadius="4">
                                                    <StackPanel>
                                                        <TextBlock x:Uid="S_LiveGyroReadings" Text="Live gyro readings" FontSize="13" Foreground="#B9C0CC" Margin="0,0,0,4" />
                                                        <TextBlock x:Uid="ViiperStickGyroLiveReadingsText" x:Name="ViiperStickGyroLiveReadingsText"
                                                                   Text="(no data — check that CE is enabled and gyro is active)"
                                                                   FontSize="12" FontFamily="Consolas" Foreground="#7FBFFF"
                                                                   TextWrapping="Wrap" />
                                                    </StackPanel>
                                                </Border>

                                                <!-- Deadzone slider removed in #79 round 5 — pipeline simplified. -->


                                                <!-- Advanced expander.
                                                     Each control mirrors a legacy ControllerEmulation* control via
                                                     GamingWidget.ViiperStickGyro.cs, so the same widget property
                                                     pushes values to the helper. Defaults match vvalente30's
                                                     recommended SteamOS-aligned settings (issue #79). -->
                                                <Grid Margin="0,12,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock x:Uid="S_AdvancedGyroStickOptions" Text="Advanced gyro → stick options" FontSize="13" Foreground="#B9C0CC"
                                                               VerticalAlignment="Center" />
                                                    <ToggleButton x:Name="ViiperStickGyroAdvancedToggle"
                                                                  Grid.Column="1" IsChecked="False"
                                                                  VerticalAlignment="Center" Background="Transparent" BorderThickness="0"
                                                                  Padding="8,4" Click="ViiperStickGyroAdvancedToggle_Click">
                                                        <FontIcon x:Name="ViiperStickGyroAdvancedIcon" Glyph="&#xE70D;" FontSize="13"/>
                                                    </ToggleButton>
                                                </Grid>
                                                <StackPanel x:Name="ViiperStickGyroAdvancedContent" Spacing="8" Margin="0,8,0,0" Visibility="Collapsed">

                                                    <!-- Send to joystick -->
                                                    <ctk:SettingsCard x:Uid="S_SendToJoystick_2" Header="Send to joystick" Description="Which emulated stick receives the gyro contribution.">
                                                        <ctk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE7FC;"/></ctk:SettingsCard.HeaderIcon>
                                                        <ComboBox x:Name="ViiperStickGyroSelectComboBox" Style="{StaticResource ModernComboBoxStyle}" Width="160"
                                                        SelectionChanged="ViiperStickGyroSelectComboBox_SelectionChanged">
                                                        <ComboBoxItem x:Uid="S_Left" Content="Left" Tag="0" />
                                                        <ComboBoxItem x:Uid="S_Right" Content="Right" Tag="1" IsSelected="True" />
                                                        </ComboBox>
                                                    </ctk:SettingsCard>

                                                    <!-- 3DOF to 2D conversion -->
                                                    <ctk:SettingsCard x:Uid="S_3DOFTo2DConversion_2" Header="3DOF to 2D conversion" Description="Yaw (default) = laser pointer from back of device: yaw the device → camera pans, roll has no effect. Player/World Space use gravity as the yaw axis (camera pans relative to world up, not device direction).">
                                                        <ctk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE713;"/></ctk:SettingsCard.HeaderIcon>
                                                        <ComboBox x:Name="ViiperStickGyroConversionComboBox" Style="{StaticResource ModernComboBoxStyle}" Width="220"
                                                        SelectionChanged="ViiperStickGyroConversionComboBox_SelectionChanged">
                                                        <ComboBoxItem x:Uid="S_YawLaserPointer" Content="Yaw (laser pointer)" Tag="0" IsSelected="True" />
                                                        <ComboBoxItem x:Uid="S_Roll" Content="Roll" Tag="1" />
                                                        <ComboBoxItem x:Uid="S_YawRoll" Content="Yaw + Roll" Tag="2" />
                                                        <ComboBoxItem x:Uid="S_PlayerSpace" Content="Player Space" Tag="3" />
                                                        <ComboBoxItem x:Uid="S_WorldSpace" Content="World Space" Tag="4" />
                                                        </ComboBox>
                                                    </ctk:SettingsCard>

                                                    <!-- Hold orientation -->
                                                    <ctk:SettingsCard x:Uid="S_HoldOrientation_2" Header="Hold orientation" Description="Flat = on a table; Handheld = held in front of you (default for Legion Go 2).">
                                                        <ctk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE713;"/></ctk:SettingsCard.HeaderIcon>
                                                        <ComboBox x:Name="ViiperStickGyroOrientationComboBox" Style="{StaticResource ModernComboBoxStyle}" Width="200"
                                                        SelectionChanged="ViiperStickGyroOrientationComboBox_SelectionChanged">
                                                        <ComboBoxItem x:Uid="S_FlatParallelToGround" Content="Flat (parallel to ground)" Tag="0" IsSelected="True" />
                                                        <ComboBoxItem x:Uid="S_HandheldHeldInFront" Content="Handheld (held in front)" Tag="1" />
                                                        </ComboBox>
                                                    </ctk:SettingsCard>

                                                    <!-- Invert toggles -->
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock x:Uid="S_InvertXOutput_2" Text="Invert X output" Grid.Column="0" VerticalAlignment="Center" FontSize="13" Foreground="#B9C0CC" />
                                                        <ToggleSwitch x:Name="ViiperStickGyroInvertXToggle"
                                                                      Grid.Column="1"
                                                                      Style="{StaticResource ModernToggleStyle}"
                                                                      Toggled="ViiperStickGyroInvertXToggle_Toggled"/>
                                                    </Grid>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock x:Uid="S_InvertYOutput_2" Text="Invert Y output" Grid.Column="0" VerticalAlignment="Center" FontSize="13" Foreground="#B9C0CC" />
                                                        <ToggleSwitch x:Name="ViiperStickGyroInvertYToggle"
                                                                      Grid.Column="1"
                                                                      Style="{StaticResource ModernToggleStyle}"
                                                                      Toggled="ViiperStickGyroInvertYToggle_Toggled"/>
                                                    </Grid>

                                                    <!-- Min/Max gyro input speed, Min/Max joystick output, Power curve,
                                                         Precision speed, and Output mix sliders all removed in #79 round 5
                                                         when the pipeline was simplified to
                                                         conversion → invert → sensitivity → clamp. Use the Sensitivity
                                                         slider above for tuning. -->

                                                    <!-- Reset to vvalente30's recommended SteamOS-aligned defaults. Each
                                                         value mirrors over to the legacy CE control via the existing
                                                         property pipe path; no separate save logic. -->
                                                    <Button x:Uid="ViiperStickGyroResetButton" x:Name="ViiperStickGyroResetButton"
                                                            Content="Reset to recommended defaults"
                                                            Margin="0,12,0,0"
                                                            HorizontalAlignment="Stretch"
                                                            Style="{StaticResource ModernButtonStyle}"
                                                            Click="ViiperStickGyroResetButton_Click" />
                                                </StackPanel>
                                                </StackPanel>
                                            </StackPanel>

                                            <TextBlock x:Uid="S_GuideModeButton" Text="Guide/Mode button" FontSize="13" Foreground="#B9C0CC" Margin="0,12,0,4" />
                                            <ComboBox x:Name="ViiperGuideButtonModeComboBox" Style="{StaticResource ModernComboBoxStyle}" HorizontalAlignment="Stretch">
                                                <ComboBoxItem x:Uid="S_NativeEmulatedDeviceGuidePS" Content="Native (emulated device Guide/PS)" Tag="Native" />
                                                <ComboBoxItem x:Uid="S_OpenXboxGameBarWin" Content="Open Xbox Game Bar (Win+G)" Tag="GameBar" />
                                            </ComboBox>
                                            <TextBlock x:Uid="ViiperLegionLDisabledHint" x:Name="ViiperLegionLDisabledHint"
                                                       Text="Legion L is disabled in Special Remapping — set it to &quot;Guide&quot; to route the Xbox button through the emulated device."
                                                       FontSize="12"
                                                       Foreground="#FFB060"
                                                       TextWrapping="Wrap"
                                                       Margin="0,6,0,0"
                                                       Visibility="Collapsed" />

                                            <!-- Swap rumble motors -->
                                            <Grid Margin="0,12,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock x:Uid="S_SwapRumbleMotors" Text="Swap rumble motors"
                                                           Grid.Column="0"
                                                           VerticalAlignment="Center"
                                                           FontSize="14"
                                                           Foreground="#B9C0CC" />
                                                <ToggleSwitch x:Name="ViiperSwapRumbleMotorsToggle"
                                                              Grid.Column="1"
                                                              Style="{StaticResource ModernToggleStyle}"
                                                              IsOn="False"/>
                                            </Grid>

                                            <!-- Mirror emulated lightbar (DS4 / DualSense Edge) onto Legion stick lights -->
                                            <ctk:SettingsCard x:Uid="S_MirrorEmulatedLightbarToStick" Margin="0,12,0,0" Header="Mirror emulated lightbar to stick lights" Description="DualShock 4 / DualSense Edge only — when on, game-driven LED color overrides the picker color you chose for the Legion Go sticks. Off keeps your saved stick color." Tapped="ToggleRow_Tapped">
                                                <ctk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE781;"/></ctk:SettingsCard.HeaderIcon>
                                                <ToggleSwitch x:Name="ViiperMirrorLightbarToStickToggle"
                                                VerticalAlignment="Center"
                                                Style="{StaticResource ModernToggleStyle}"
                                                IsOn="False"/>
                                            </ctk:SettingsCard>

                                            <!-- Rumble intensity -->
                                            <StackPanel Margin="0,8,0,0">
                                                <Grid>
                                                    <TextBlock x:Uid="S_RumbleIntensity" Text="Rumble intensity" FontSize="14" Foreground="#B9C0CC" />
                                                    <TextBlock x:Name="ViiperRumbleIntensityValue"
                                                               Text="100%"
                                                               Style="{StaticResource CardValueStyle}"/>
                                                </Grid>
                                                <Slider x:Name="ViiperRumbleIntensitySlider"
                                                        Style="{StaticResource ModernSliderStyle}"
                                                        Minimum="0" Maximum="200"
                                                        Value="100"
                                                        StepFrequency="5"/>
                                            </StackPanel>

                                            <!-- =============== Sticks & Triggers (PadForge-inspired shaping) =============== -->
                                            <StackPanel x:Name="ViiperStickTriggerSection" Margin="0,16,0,0">
                                                <Border Height="1" Background="#33FFFFFF" Margin="0,0,0,12"/>
                                                <Grid Background="Transparent" Tapped="ExpandHeader_Tapped">
                                                    <ctk:SettingsCard Style="{StaticResource HeaderRowStyle}">
                                                        <ctk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE7FC;"/></ctk:SettingsCard.HeaderIcon>
                                                        <ctk:SettingsCard.Header>
                                                            <TextBlock x:Uid="S_SticksTriggers" Text="Sticks &amp; Triggers" />
                                                        </ctk:SettingsCard.Header>
                                                        <ToggleButton x:Name="ViiperStickTriggerExpandButton" MinWidth="44" MinHeight="40"
                                                                  Background="Transparent"
                                                                  BorderBrush="Transparent"
                                                                  Padding="6,2"
                                                                  Click="ViiperStickTriggerExpandButton_Click">
                                                        <FontIcon x:Name="ViiperStickTriggerExpandIcon" Glyph="&#xE70D;" FontSize="13"/>
                                                    </ToggleButton>
                                                    </ctk:SettingsCard>
                                                </Grid>
                                                <TextBlock x:Uid="S_DeadzoneShapeAntiDeadzoneSensitivity" Text="Deadzone shape, anti-deadzone, sensitivity curves per stick/trigger."
                                                           FontSize="12" Foreground="#B9C0CC" TextWrapping="Wrap" Margin="0,2,0,0" />

                                                <StackPanel x:Name="ViiperStickTriggerContent" Visibility="Collapsed" Margin="0,8,0,0">

                                                    <!-- ============= LIVE PREVIEW ============= -->
                                                    <TextBlock x:Uid="S_LivePreview" Text="Live preview" FontSize="13" FontWeight="SemiBold" Foreground="#FFD000" Margin="0,4,0,4" />
                                                    <TextBlock x:Uid="S_GrayRawYellowShapedMove" Text="Gray = raw, yellow = shaped. Move the sticks/triggers to verify the curve." FontSize="12" Foreground="#B9C0CC" TextWrapping="Wrap" Margin="0,0,0,8" />

                                                    <!-- Two stick boxes side by side -->
                                                    <Grid HorizontalAlignment="Stretch" Margin="0,0,0,8">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>

                                                        <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                                            <TextBlock x:Uid="S_LS" Text="LS" FontSize="12" Foreground="#B9C0CC" HorizontalAlignment="Center" />
                                                            <Border Background="#11FFFFFF" BorderBrush="#33FFFFFF" BorderThickness="1" Margin="0,2,0,0">
                                                                <Canvas x:Name="ViiperLSPreviewCanvas" Width="80" Height="80">
                                                                    <Line X1="40" Y1="0" X2="40" Y2="80" Stroke="#33FFFFFF" StrokeThickness="1"/>
                                                                    <Line X1="0" Y1="40" X2="80" Y2="40" Stroke="#33FFFFFF" StrokeThickness="1"/>
                                                                    <Ellipse x:Name="ViiperLSRawDot" Width="8" Height="8" Fill="#88AAAAAA" Canvas.Left="36" Canvas.Top="36"/>
                                                                    <Ellipse x:Name="ViiperLSShapedDot" Width="8" Height="8" Fill="#FFFFD000" Canvas.Left="36" Canvas.Top="36"/>
                                                                </Canvas>
                                                            </Border>
                                                        </StackPanel>

                                                        <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                                            <TextBlock x:Uid="S_RS" Text="RS" FontSize="12" Foreground="#B9C0CC" HorizontalAlignment="Center" />
                                                            <Border Background="#11FFFFFF" BorderBrush="#33FFFFFF" BorderThickness="1" Margin="0,2,0,0">
                                                                <Canvas x:Name="ViiperRSPreviewCanvas" Width="80" Height="80">
                                                                    <Line X1="40" Y1="0" X2="40" Y2="80" Stroke="#33FFFFFF" StrokeThickness="1"/>
                                                                    <Line X1="0" Y1="40" X2="80" Y2="40" Stroke="#33FFFFFF" StrokeThickness="1"/>
                                                                    <Ellipse x:Name="ViiperRSRawDot" Width="8" Height="8" Fill="#88AAAAAA" Canvas.Left="36" Canvas.Top="36"/>

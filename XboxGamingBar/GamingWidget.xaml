                                                <x:String>Enter</x:String><x:String>Escape</x:String><x:String>Space</x:String><x:String>Tab</x:String><x:String>Backspace</x:String>
                                                <x:String>Up</x:String><x:String>Down</x:String><x:String>Left</x:String><x:String>Right</x:String>
                                                <x:String>Home</x:String><x:String>End</x:String><x:String>PageUp</x:String><x:String>PageDown</x:String><x:String>Insert</x:String><x:String>Delete</x:String>
                                                <x:String>Left Ctrl</x:String><x:String>Left Shift</x:String><x:String>Left Alt</x:String><x:String>Left Win</x:String>
                                                <x:String>Right Ctrl</x:String><x:String>Right Shift</x:String><x:String>Right Alt</x:String>
                                                <x:String>Mouse Left</x:String><x:String>Mouse Right</x:String><x:String>Mouse Middle</x:String>
                                                <x:String>Mouse Wheel Up</x:String><x:String>Mouse Wheel Down</x:String>
                                            </ComboBox>
                                        </Grid>

                                        <!-- Apply/Restore Buttons -->
                                        <Grid Margin="0,8,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="8"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <Button x:Uid="GPDApplyMappingsButton" x:Name="GPDApplyMappingsButton"
                                                    Grid.Column="0"
                                                    Content="Apply Mappings"
                                                    HorizontalAlignment="Stretch"
                                                    Style="{StaticResource StandaloneButtonStyle}"
                                                    Click="GPDApplyMappingsButton_Click" />

                                            <Button x:Uid="GPDRestoreDefaultsButton" x:Name="GPDRestoreDefaultsButton"
                                                    Grid.Column="2"
                                                    Content="Restore Defaults"
                                                    HorizontalAlignment="Stretch"
                                                    Style="{StaticResource StandaloneButtonStyle}"
                                                    Click="GPDRestoreDefaultsButton_Click" />
                                        </Grid>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                    </StackPanel>
                </ScrollViewer>

                <!-- Connection Status Banner - placed last for z-order (renders on top) -->
                <!-- Visible by default with Loading... so user sees immediate feedback before code runs -->
                <muxc:InfoBar x:Name="ConnectionStatusBanner"
                              VerticalAlignment="Top"
                              Margin="12,4,12,0"
                              IsOpen="True"
                              IsClosable="False"
                              Severity="Informational"
                              Visibility="Visible">
                    <muxc:InfoBar.Content>
                        <TextBlock x:Uid="ConnectionStatusText" x:Name="ConnectionStatusText" Text="Loading..." FontSize="13" Margin="0,0,0,12" TextWrapping="Wrap"/>
                    </muxc:InfoBar.Content>
                </muxc:InfoBar>

                <!-- Update Available Banner - appears below connection banner when update is found -->
                <muxc:InfoBar x:Name="UpdateAvailableBanner"
                              VerticalAlignment="Top"
                              Margin="12,64,12,0"
                              IsOpen="True"
                              IsClosable="False"
                              Severity="Success"
                              Visibility="Collapsed">
                    <muxc:InfoBar.Content>
                        <Grid Margin="0,0,0,10" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Uid="UpdateAvailableText" x:Name="UpdateAvailableText" Text="Update Available: v0.0.0" FontSize="13" VerticalAlignment="Center" TextWrapping="Wrap"/>
                            <Button x:Uid="UpdateBannerButton" x:Name="UpdateBannerButton" Grid.Column="1" Content="Update" MinHeight="40"
                                    Style="{ThemeResource AccentButtonStyle}" Click="UpdateBannerButton_Click"/>
                            <Button x:Name="DismissUpdateBannerButton" Grid.Column="2" MinWidth="40" MinHeight="40" Background="Transparent" BorderThickness="0"
                                    AutomationProperties.Name="Dismiss" Click="DismissUpdateBannerButton_Click">
                                <FontIcon Glyph="&#xE711;" FontSize="12"/>
                            </Button>
                        </Grid>
                    </muxc:InfoBar.Content>
                </muxc:InfoBar>

            </Grid>
            </Grid> <!-- End Content Area Grid.Row="1" -->

            <!-- Gamepad command bar: static key hints for the whole widget -->
            <Border x:Name="GamepadCommandBar"
                    Grid.Row="2"
                    Background="#1A1C1F"
                    BorderBrush="#14FFFFFF"
                    BorderThickness="0,1,0,0"
                    Padding="12,8,12,8">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="18">
                    <StackPanel Orientation="Horizontal">
                        <Border Style="{StaticResource GamepadKeyHintStyle}"><TextBlock Text="LT/RT" Style="{StaticResource GamepadKeyHintTextStyle}"/></Border>
                        <TextBlock x:Uid="CommandHintTabs" Text="Tabs" Style="{StaticResource CommandHintLabelStyle}"/>
                    </StackPanel>
                    <StackPanel x:Name="CommandHintSections" Orientation="Horizontal" Visibility="Collapsed">
                        <Border Style="{StaticResource GamepadKeyHintStyle}"><TextBlock Text="LB/RB" Style="{StaticResource GamepadKeyHintTextStyle}"/></Border>
                        <TextBlock x:Uid="CommandHintSections" Text="Section" Style="{StaticResource CommandHintLabelStyle}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Border Style="{StaticResource GamepadKeyHintStyle}"><TextBlock Text="A" Style="{StaticResource GamepadKeyHintTextStyle}"/></Border>
                        <TextBlock x:Uid="CommandHintSelect" Text="Select" Style="{StaticResource CommandHintLabelStyle}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Border Style="{StaticResource GamepadKeyHintStyle}"><TextBlock Text="B" Style="{StaticResource GamepadKeyHintTextStyle}"/></Border>
                        <TextBlock x:Uid="CommandHintBack" Text="Back" Style="{StaticResource CommandHintLabelStyle}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid> <!-- End MainNavContainer -->
    </Grid>
</Page>

                                                <x:String>+ Key</x:String><x:String>A</x:String><x:String>B</x:String><x:String>C</x:String><x:String>D</x:String><x:String>E</x:String><x:String>F</x:String><x:String>G</x:String><x:String>H</x:String><x:String>I</x:String><x:String>J</x:String><x:String>K</x:String><x:String>L</x:String><x:String>M</x:String><x:String>N</x:String><x:String>O</x:String><x:String>P</x:String><x:String>Q</x:String><x:String>R</x:String><x:String>S</x:String><x:String>T</x:String><x:String>U</x:String><x:String>V</x:String><x:String>W</x:String><x:String>X</x:String><x:String>Y</x:String><x:String>Z</x:String><x:String>0</x:String><x:String>1</x:String><x:String>2</x:String><x:String>3</x:String><x:String>4</x:String><x:String>5</x:String><x:String>6</x:String><x:String>7</x:String><x:String>8</x:String><x:String>9</x:String><x:String>F1</x:String><x:String>F2</x:String><x:String>F3</x:String><x:String>F4</x:String><x:String>F5</x:String><x:String>F6</x:String><x:String>F7</x:String><x:String>F8</x:String><x:String>F9</x:String><x:String>F10</x:String><x:String>F11</x:String><x:String>F12</x:String><x:String>Enter</x:String><x:String>Esc</x:String><x:String>Space</x:String><x:String>Tab</x:String><x:String>Backspace</x:String><x:String>Up</x:String><x:String>Down</x:String><x:String>Left</x:String><x:String>Right</x:String><x:String>LCtrl</x:String><x:String>LShift</x:String><x:String>LAlt</x:String><x:String>LWin</x:String><x:String>RCtrl</x:String><x:String>RShift</x:String><x:String>RAlt</x:String><x:String>RWin</x:String><x:String>Home</x:String><x:String>End</x:String><x:String>PgUp</x:String><x:String>PgDn</x:String><x:String>Insert</x:String><x:String>Delete</x:String><x:String>PrintScr</x:String><x:String>Pause</x:String><x:String>VolUp</x:String><x:String>VolDown</x:String><x:String>VolMute</x:String><x:String>[</x:String><x:String>]</x:String>
                                            </ComboBox>
                                        </StackPanel>

                                        <!-- Scroll Click Command Input (hidden by default) -->
                                        <Grid x:Name="ScrollClickCommandGrid" Margin="85,8,0,0" Visibility="Collapsed">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Uid="ScrollClickCommandTextBox" x:Name="ScrollClickCommandTextBox"
                                                     Grid.Column="0"
                                                     PlaceholderText="e.g. C:\path\app.exe -arg1" />
                                            <Button x:Uid="ScrollClickCommandApplyButton" x:Name="ScrollClickCommandApplyButton"
                                                    Grid.Column="1"
                                                    Content="Apply"
                                                    Style="{StaticResource ModernButtonStyle}"
                                                    Margin="8,0,0,0"
                                                    Click="ScrollClickCommandApplyButton_Click" />
                                        </Grid>

                                            <!-- Status Text for Scroll wheel -->
                                            <TextBlock x:Name="ScrollRemapStatusText"
                                                       Text=""
                                                       FontSize="13"
                                                       Foreground="#B9C0CC"
                                                       Margin="0,8,0,0"/>
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Brightness Gesture Card -->
                            <Border Style="{StaticResource CardStyle}">
                                <StackPanel Spacing="12">
                                    <ctk:SettingsCard x:Uid="S_BrightnessGesture" Header="Brightness Gesture" Description="Hold the trigger button below and tilt the axis to fade display brightness. A quick tap of the trigger still behaves normally." Tapped="ToggleRow_Tapped">
                                        <ctk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE706;"/></ctk:SettingsCard.HeaderIcon>
                                        <ToggleSwitch x:Name="BrightnessGestureEnabledToggle"
                                        Style="{StaticResource ModernToggleStyle}"
                                        IsOn="False"/>
                                    </ctk:SettingsCard>

                                    <StackPanel x:Name="BrightnessGestureOptionsPanel" Spacing="12" Visibility="Collapsed">
                                        <!-- Trigger Button -->
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="100"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:Uid="S_Trigger" Text="Trigger" VerticalAlignment="Center" Foreground="#B9C0CC" FontSize="14" />
                                            <ComboBox x:Name="BrightnessGestureTriggerComboBox"
                                                      Grid.Column="1"
                                                      MinWidth="140"
                                                      HorizontalAlignment="Left"
                                                      Style="{StaticResource ModernComboBoxStyle}"
                                                      SelectionChanged="BrightnessGestureTriggerComboBox_SelectionChanged">
                                                <ComboBoxItem x:Uid="S_Desktop_2" Content="Desktop" Tag="0" />
                                                <ComboBoxItem x:Uid="S_Page_2" Content="Page" Tag="1" />
                                                <ComboBoxItem x:Uid="S_ScrollClick_2" Content="Scroll Click" Tag="2" />
                                                <ComboBoxItem Content="Y1" Tag="3"/>
                                                <ComboBoxItem Content="Y2" Tag="4"/>
                                                <ComboBoxItem Content="Y3" Tag="5"/>
                                                <ComboBoxItem Content="M1" Tag="6"/>
                                                <ComboBoxItem Content="M2" Tag="7"/>
                                                <ComboBoxItem Content="M3" Tag="8"/>
                                            </ComboBox>
                                        </Grid>

                                        <!-- Axis -->
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="100"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:Uid="S_Axis" Text="Axis" VerticalAlignment="Center" Foreground="#B9C0CC" FontSize="14" />
                                            <ComboBox x:Name="BrightnessGestureAxisComboBox"
                                                      Grid.Column="1"
                                                      MinWidth="140"
                                                      HorizontalAlignment="Left"
                                                      Style="{StaticResource ModernComboBoxStyle}"
                                                      SelectionChanged="BrightnessGestureAxisComboBox_SelectionChanged">
                                                <ComboBoxItem x:Uid="S_RightStick_2" Content="Right Stick" Tag="0" />
                                                <ComboBoxItem x:Uid="S_LeftStick_2" Content="Left Stick" Tag="1" />
                                                <ComboBoxItem x:Uid="S_DPadUpDown" Content="D-Pad (Up/Down)" Tag="2" />
                                            </ComboBox>
                                        </Grid>
                                    </StackPanel>

                                    <!-- Info note, collapsed by default to keep the card tidy - explains
                                         why Legion L/R aren't offered as trigger options. -->
                                    <muxc:Expander HorizontalAlignment="Stretch"
                                                   HorizontalContentAlignment="Stretch"
                                                   IsExpanded="False">
                                        <muxc:Expander.Header>
                                            <TextBlock x:Uid="S_WhyNotLegionRLeft" Text="Why not Legion R + left stick, like SteamOS?" FontSize="13" Foreground="#B9C0CC" />
                                        </muxc:Expander.Header>
                                        <Border Background="{StaticResource PageBackgroundBrush}" CornerRadius="4" Padding="10">
                                            <TextBlock x:Uid="S_ThisGestureWasMeantTo" FontSize="12" Foreground="#B9C0CC" TextWrapping="Wrap"
                                                       Text="This gesture was meant to work exactly like on SteamOS - hold Legion R and tilt the left stick. On Windows, holding Legion L or R for more than about 5 seconds is hardcoded in the controller's own firmware to toggle that grip's connection off and on (a real Legion Space feature) - not something GoTweaks, or any app, can override. None of the trigger options below have this limitation." />
                                        </Border>
                                    </muxc:Expander>
                                </StackPanel>
                            </Border>

                        </StackPanel>
                        <StackPanel x:Name="LegionLightingSection" Visibility="Collapsed">
                            <!-- Lighting Section (hidden on devices without HID RGB lighting support) -->
                            <!-- No dedicated header - grouped under "Controller Settings" above, with Touchpad & Vibration -->
                            <StackPanel x:Name="LightingSection">
                            <!-- Lighting Card -->
                            <Border Style="{StaticResource CardStyle}">
                                <StackPanel>
                                    <Grid Background="Transparent" Tapped="ExpandHeader_Tapped">
                                        <ctk:SettingsCard Style="{StaticResource HeaderRowStyle}">
                                            <ctk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE781;"/></ctk:SettingsCard.HeaderIcon>
                                            <ctk:SettingsCard.Header>
                                                <TextBlock x:Uid="S_Lighting" Text="Lighting" />
                                            </ctk:SettingsCard.Header>
                                            <ctk:SettingsCard.Description>
                                                <TextBlock x:Uid="S_ControllerRGBAndPowerButton" Text="Controller RGB and power button lighting" />
                                            </ctk:SettingsCard.Description>
                                            <ToggleButton x:Name="LightingExpandToggle" MinWidth="44" MinHeight="40"
                                                      IsChecked="False"
                                                      Background="Transparent"
                                                      BorderThickness="0"
                                                      Padding="8,4"
                                                      Click="LightingExpandToggle_Click">
                                            <FontIcon x:Name="LightingExpandIcon" Glyph="&#xE70D;" FontSize="13"/>
                                        </ToggleButton>
                                        </ctk:SettingsCard>
                                    </Grid>
                                    <StackPanel x:Name="LightingContent" Spacing="12" Margin="0,12,0,0" Visibility="Collapsed">
                                        <!-- Light Mode -->
                                        <StackPanel>
                                            <TextBlock x:Uid="S_LightMode" Text="Light Mode" FontSize="14" Foreground="#B9C0CC" Margin="0,0,0,4" />
                                            <ComboBox x:Name="LegionLightModeComboBox"
                                                      Style="{StaticResource ModernComboBoxStyle}"
                                                      HorizontalAlignment="Stretch"
                                                      SelectedIndex="1"
                                                      SelectionChanged="LegionLightModeComboBox_SelectionChanged">
                                                <x:String>Off</x:String>
                                                <x:String>Solid</x:String>
                                                <x:String>Pulse</x:String>
                                                <x:String>Dynamic</x:String>
                                                <x:String>Spiral</x:String>
                                            </ComboBox>
                                        </StackPanel>

                                        <!-- Light Color (Solid, Pulse only) -->
                                        <StackPanel x:Name="LegionColorCard">
                                            <Grid Background="Transparent" MinHeight="48" Tapped="ExpandHeader_Tapped">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock x:Uid="S_LightColor" Text="Light Color" Grid.Column="0" VerticalAlignment="Center" Foreground="#B9C0CC" FontSize="14" />
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Border x:Name="LegionColorPreview"
                                                            Width="24" Height="24"
                                                            CornerRadius="4"
                                                            Background="White"
                                                            BorderBrush="#50555C"
                                                            BorderThickness="1"
                                                            Margin="0,0,8,0"/>
                                                    <Button x:Name="LegionColorExpandButton" MinWidth="44" MinHeight="40"
                                                            Content="&#xE70D;"
                                                            FontFamily="Segoe MDL2 Assets"
                                                            FontSize="13"
                                                            Padding="8,4"
                                                            Background="Transparent"
                                                            Click="LegionColorExpandButton_Click"
                                                            UseSystemFocusVisuals="True"
                                                            FocusVisualPrimaryBrush="White"/>
                                                </StackPanel>
                                            </Grid>
                                            <muxc:ColorPicker x:Name="LegionColorPicker"
                                                         Visibility="Collapsed"
                                                         Margin="0,12,0,0"
                                                         Color="White"
                                                         ColorSpectrumShape="Box"
                                                         IsMoreButtonVisible="False"
                                                         IsColorSliderVisible="False"
                                                         IsColorChannelTextInputVisible="False"
                                                         IsHexInputVisible="False"
                                                         IsAlphaEnabled="False"
                                                         IsAlphaSliderVisible="False"
                                                         IsAlphaTextInputVisible="False"
                                                         ColorChanged="LegionColorPicker_ColorChanged"/>
                                        </StackPanel>

                                        <!-- Brightness (all modes except Off) -->
                                        <StackPanel x:Name="LegionBrightnessCard">
                                            <Grid>
                                                <TextBlock x:Uid="S_Brightness" Text="Brightness" FontSize="14" Foreground="#B9C0CC" />
                                                <TextBlock x:Name="LegionBrightnessValue"
                                                           Text="100%"
                                                           Style="{StaticResource CardValueStyle}"/>
                                            </Grid>
                                            <Slider x:Name="LegionBrightnessSlider"
                                                    Style="{StaticResource ModernSliderStyle}"
                                                    Minimum="0" Maximum="100"
                                                    Value="100"
                                                    ValueChanged="LegionBrightnessSlider_ValueChanged"/>
                                        </StackPanel>

                                        <!-- Speed (Pulse, Dynamic, Spiral only) -->
                                        <StackPanel x:Name="LegionSpeedCard" Visibility="Collapsed">
                                            <Grid>
                                                <TextBlock x:Uid="S_Speed" Text="Speed" FontSize="14" Foreground="#B9C0CC" />
                                                <TextBlock x:Name="LegionSpeedValue"
                                                           Text="50%"
                                                           Style="{StaticResource CardValueStyle}"/>
                                            </Grid>
                                            <Slider x:Name="LegionSpeedSlider"
                                                    Style="{StaticResource ModernSliderStyle}"
                                                    Minimum="0" Maximum="100"
                                                    Value="50"
                                                    ValueChanged="LegionSpeedSlider_ValueChanged"/>
                                        </StackPanel>

                                        <!-- Power Light Toggle -->
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:Uid="S_PowerLight" Text="Power Light" Grid.Column="0" VerticalAlignment="Center" Foreground="#B9C0CC" FontSize="14" />
                                            <ToggleSwitch x:Name="LegionPowerLightToggle"
                                                          Grid.Column="1"
                                                          Style="{StaticResource ModernToggleStyle}"
                                                          IsOn="True"/>
                                        </Grid>

                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel x:Name="LegionDeviceSection" Visibility="Collapsed">
                            <!-- Fan Settings Section Header -->
                            <TextBlock x:Uid="S_FanSettings" Text="Fan Settings" Style="{StaticResource SectionHeaderStyle}" />

                            <!-- The Legion-tab "Power Profile" dropdown was removed: the Performance tab's
                                 TDP Mode dropdown (TDPModeComboBox) is now the single control for the
                                 performance mode (Quiet/Balanced/Performance/Custom). The Custom SPL/SPPL/FPPT
                                 sliders were likewise moved to the Performance tab. One source of truth. -->

                            <!-- Fan Full Speed Card -->
                            <Border Style="{StaticResource CardStyle}">
                                <ctk:SettingsCard x:Uid="S_FanFullSpeed" Header="Fan Full Speed" Description="Override fan curve for maximum cooling" Tapped="ToggleRow_Tapped">
                                    <ctk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE9CA;"/></ctk:SettingsCard.HeaderIcon>
                                    <ToggleSwitch x:Name="LegionFanFullSpeedToggle"
                                    Style="{StaticResource ModernToggleStyle}"
                                    IsOn="False"/>
                                </ctk:SettingsCard>
                            </Border>

                            <!-- Fan Curve Graph Card -->
                            <Border x:Name="LegionFanCurveCard" Style="{StaticResource CardStyle}">
                                <StackPanel>
                                    <!-- Header with expand toggle -->
                                    <Grid Background="Transparent" MinHeight="48" Tapped="ExpandHeader_Tapped">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock x:Uid="S_FanCurve" Text="Fan Curve" Style="{StaticResource CardTitleStyle}" />
                                            <!-- Live hardware readout: fan RPM + the temperature currently
                                                 driving the fan. Always shown while the card is expanded,
                                                 independent of which mode's curve is selected below. -->
                                            <StackPanel Margin="0,4,0,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock x:Uid="S_Fan" Text="Fan:" FontSize="13" FontWeight="SemiBold" Foreground="#B9C0CC" VerticalAlignment="Center" Margin="0,0,4,0" />
                                                    <TextBlock x:Uid="FanRPMLabel" x:Name="FanRPMLabel" Text="-- RPM" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource SystemAccentBrush}" VerticalAlignment="Center" />
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                    <TextBlock x:Uid="S_CPUTemp" Text="CPU Temp:" FontSize="13" FontWeight="SemiBold" Foreground="#B9C0CC" VerticalAlignment="Center" Margin="0,0,4,0" />
                                                    <TextBlock x:Name="FanHeaderTempLabel" Text="--°C" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource SystemAccentBrush}" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </StackPanel>
                                            <!-- Spells out that the graph below edits the Custom-mode curve, and
                                                 whether the console is currently running it. Set in UpdateActiveModeLabel. -->
                                            <TextBlock x:Name="FanCurveActiveModeLabel"
                                                       FontSize="12" Foreground="#88B0E0" Margin="0,2,0,0"
                                                       TextWrapping="Wrap" Visibility="Collapsed"/>
                                        </StackPanel>
                                        <ToggleButton x:Name="FanCurveExpandToggle" MinWidth="44" MinHeight="40"
                                                      Grid.Column="1"
                                                      IsChecked="False"
                                                      VerticalAlignment="Center"
                                                      Background="Transparent"
                                                      BorderThickness="0"
                                                      Padding="8,4"
                                                      Click="FanCurveExpandToggle_Click">
                                            <FontIcon x:Name="FanCurveExpandIcon" Glyph="&#xE70D;" FontSize="13"/>
                                        </ToggleButton>
                                    </Grid>

                                    <Border Height="1" Background="#33FFFFFF" Margin="0,10,0,0"/>

                                    <!-- Info / warning collapsed by default to keep the card tidy. Contains
                                         the safety warning and a short behavioral explainer. -->
                                    <muxc:Expander x:Name="FanCurveInfoExpander"
                                                   Margin="0,8,0,0"
                                                   HorizontalAlignment="Stretch"
                                                   HorizontalContentAlignment="Stretch"
                                                   IsExpanded="False">
                                        <muxc:Expander.Header>
                                            <TextBlock x:Uid="S_InfoSafetyNotes" Text="Info &amp; safety notes" FontSize="13" Foreground="#B9C0CC" />
                                        </muxc:Expander.Header>
                                        <StackPanel>
                                            <Border Background="#3D2A1A" CornerRadius="4" Padding="10"
                                                    x:Name="FanCurveWarningBorder">
                                                <StackPanel>
                                                    <TextBlock Foreground="#FFB060" FontWeight="SemiBold" FontSize="13">
                                                        ⚠ Aggressive curves can damage hardware
                                                    </TextBlock>
                                                    <TextBlock x:Uid="S_Never0Above50C" Foreground="#DDB890" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"
                                                               Text="• Never 0% above ~50°C" />
                                                </StackPanel>
                                            </Border>

                                            <Border Background="{StaticResource PageBackgroundBrush}" CornerRadius="4" Padding="10" Margin="0,8,0,0">
                                                <StackPanel>
                                                    <TextBlock x:Uid="S_ThisCurveIsAppliedThrough" FontSize="12" Foreground="#B9C0CC" TextWrapping="Wrap"
                                                               Text="• This curve is applied through Lenovo WMI while TDP Mode is Custom, with firmware-enforced floors&#x0a;• Quiet, Balanced and Performance use the firmware's own fan curves&#x0a;• Axis labels (10°C–100°C) are how the curve is stored; firmware may map temps differently" />
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </muxc:Expander>

                                    <!-- Expandable graph content -->
                                    <StackPanel x:Name="FanCurveContent" Margin="0,12,0,0" Visibility="Collapsed">
                                        <!-- Y-axis label -->
                                        <TextBlock x:Uid="S_Fan_2" Text="Fan %" FontSize="12" Foreground="#B9C0CC" Margin="0,0,0,4" />

                                        <!-- Graph area -->
                                        <Grid Height="150">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="30"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Y-axis labels (percentage scale) -->
                                            <StackPanel Grid.Column="0" VerticalAlignment="Stretch">
                                                <TextBlock Text="100" FontSize="12" Foreground="#B9C0CC" VerticalAlignment="Top"/>
                                                <TextBlock Text="75" FontSize="12" Foreground="#B9C0CC" VerticalAlignment="Top" Margin="0,25,0,0"/>
                                                <TextBlock Text="50" FontSize="12" Foreground="#B9C0CC" VerticalAlignment="Top" Margin="0,25,0,0"/>
                                                <TextBlock Text="25" FontSize="12" Foreground="#B9C0CC" VerticalAlignment="Top" Margin="0,25,0,0"/>
                                                <TextBlock Text="0" FontSize="12" Foreground="#B9C0CC" VerticalAlignment="Bottom"/>
                                            </StackPanel>

                                            <!-- Canvas for drawing the graph -->
                                            <Canvas x:Name="FanCurveCanvas"
                                                    Grid.Column="1"
                                                    Background="#1A1A1A"
                                                    PointerPressed="FanCurveCanvas_PointerPressed"
                                                    PointerMoved="FanCurveCanvas_PointerMoved"
                                                    PointerReleased="FanCurveCanvas_PointerReleased"
                                                    PointerCaptureLost="FanCurveCanvas_PointerReleased"
                                                    SizeChanged="FanCurveCanvas_SizeChanged">
                                                <!-- Grid lines drawn in code-behind -->

                                                <!-- Fill under the curve -->
                                                <Polygon x:Name="FanCurveFill"
                                                         Fill="#3300AAFF"
                                                         Stroke="Transparent"/>

                                                <!-- Firmware protection-floor line (dashed orange reference line) -->
                                                <Polyline x:Name="ECFloorPolyline"
                                                          Stroke="#FF6600"
                                                          StrokeThickness="1.5"
                                                          StrokeDashArray="4,2"
                                                          Opacity="0.7"/>

                                                <!-- The curve line -->
                                                <Polyline x:Name="FanCurvePolyline"
                                                          Stroke="#00AAFF"
                                                          StrokeThickness="2"
                                                          StrokeLineJoin="Round"/>

                                                <!-- Temperature indicator line (vertical dashed line) - on top of curve -->
                                                <Line x:Name="TempIndicatorLine"
                                                      Y1="0" Y2="150"
                                                      Stroke="#FF8800"
                                                      StrokeThickness="2"
                                                      StrokeDashArray="4,2"
                                                      Visibility="Collapsed"/>

                                                <!-- RPM indicator line (horizontal dashed line) - on top of curve -->
                                                <Line x:Name="RPMIndicatorLine"
                                                      X1="0" X2="300"
                                                      Stroke="#00FF88"
                                                      StrokeThickness="2"
                                                      StrokeDashArray="4,2"
                                                      Visibility="Collapsed"/>

                                                <!-- Control points are created in code-behind -->
                                            </Canvas>
                                        </Grid>

                                        <!-- X-axis labels — one per curve breakpoint. The breakpoints are
                                             how the curve is stored regardless of how it is applied.
                                             Under the firmware path Lenovo's mapping from
                                             sensor temp to curve point may not be 1:1 with these
                                             labels — the Info expander notes that — but hiding the
                                             labels entirely was worse: users had no temp reference
                                             at all when editing a non-EC-override curve. -->
                                        <Grid x:Name="FanCurveTempAxisGrid" Margin="30,4,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="10°C" FontSize="12"  Foreground="#B9C0CC" HorizontalAlignment="Left"/>
                                            <TextBlock Grid.Column="1" Text="20"   FontSize="12"  Foreground="#B9C0CC" HorizontalAlignment="Left"/>
                                            <TextBlock Grid.Column="2" Text="30"   FontSize="12"  Foreground="#B9C0CC" HorizontalAlignment="Left"/>
                                            <TextBlock Grid.Column="3" Text="40"   FontSize="12"  Foreground="#B9C0CC" HorizontalAlignment="Left"/>
                                            <TextBlock Grid.Column="4" Text="50"   FontSize="12"  Foreground="#B9C0CC" HorizontalAlignment="Left"/>
                                            <TextBlock Grid.Column="5" Text="60"   FontSize="12"  Foreground="#B9C0CC" HorizontalAlignment="Left"/>
                                            <TextBlock Grid.Column="6" Text="70"   FontSize="12"  Foreground="#B9C0CC" HorizontalAlignment="Left"/>
                                            <TextBlock Grid.Column="7" Text="80"   FontSize="12"  Foreground="#B9C0CC" HorizontalAlignment="Left"/>
                                            <TextBlock Grid.Column="8" Text="90"   FontSize="12"  Foreground="#B9C0CC" HorizontalAlignment="Left"/>
                                            <TextBlock Grid.Column="8" Text="100°C" FontSize="12" Foreground="#B9C0CC" HorizontalAlignment="Right"/>
                                        </Grid>

                                        <!-- Legacy locked-state hint, retained as collapsed shim so
                                             the code-behind reference (FanCurveLockedAxisHint) still
                                             resolves. The temp axis grid is now always visible. -->
                                        <TextBlock x:Name="FanCurveLockedAxisHint"
                                                   Visibility="Collapsed"
                                                   FontSize="12" Foreground="#B9C0CC"
                                                   HorizontalAlignment="Center"/>

                                        <!-- Current temperature display (true CPU temperature). -->
                                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0" HorizontalAlignment="Center">
                                            <TextBlock x:Uid="CurrentTempPrefixLabel" x:Name="CurrentTempPrefixLabel" Text="CPU Temp: " FontSize="13" Foreground="#B9C0CC" />
                                            <TextBlock x:Name="CurrentTempLabel" Text="--°C" FontSize="13" Foreground="#FF8800" FontWeight="SemiBold"/>
                                        </StackPanel>

                                        <!-- Firmware protection-floor legend; shown while the viewed curve is the one
                                             actually running (see RefreshFanCurveGraphForUnlockState). -->
                                        <StackPanel x:Name="ECFloorLegendPanel" Orientation="Horizontal" Margin="0,4,0,0" HorizontalAlignment="Center">
                                            <Line X1="0" Y1="0" X2="20" Y2="0" Stroke="#FF8800" StrokeThickness="2" StrokeDashArray="4,2" VerticalAlignment="Center"/>
                                            <TextBlock x:Uid="S_ECProtectionFloor" Text=" EC Protection Floor" FontSize="12" Foreground="#B9C0CC" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Battery Section Header -->
                            <TextBlock x:Uid="S_Battery" Text="Battery" Style="{StaticResource SectionHeaderStyle}" />

                            <!-- Battery Charge Limit Card -->
                            <Border Style="{StaticResource CardStyle}">
                                <ctk:SettingsCard x:Uid="S_ChargeLimit80" Header="Charge Limit (80%)" Description="Limit battery charge to extend lifespan" Tapped="ToggleRow_Tapped">
                                    <ctk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xEA95;"/></ctk:SettingsCard.HeaderIcon>
                                    <ToggleSwitch x:Name="LegionChargeLimitToggle"
                                    Style="{StaticResource ModernToggleStyle}"
                                    IsOn="False"/>
                                </ctk:SettingsCard>
                            </Border>

                            <!-- Game Bar Section: put GoTweaks in the device-maker slot left of Home -->
                            <TextBlock x:Uid="S_GameBar" Text="Game Bar" Style="{StaticResource SectionHeaderStyle}" />
                            <Border Style="{StaticResource CardStyle}">
                                <ctk:SettingsCard x:Uid="S_ShowGoTweaksFirst" Header="Show GoTweaks first" Description="Takes Legion Space's spot left of Home. Game Bar closes to apply; open it again." Tapped="ToggleRow_Tapped">
                                    <ctk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE7FC;"/></ctk:SettingsCard.HeaderIcon>
                                    <ToggleSwitch x:Name="GameBarFirstSlotToggle"
                                    Style="{StaticResource ModernToggleStyle}"
                                    IsOn="False"/>
                                </ctk:SettingsCard>
                            </Border>

                            <!-- Driver Updates Card (Lenovo): machine type + installed BIOS +
                                 direct link to the correct Lenovo downloads page, with a
                                 best-effort live driver list fetched from pcsupport.lenovo.com -->
                            <TextBlock x:Uid="S_DriverUpdates" Text="Driver Updates" Style="{StaticResource SectionHeaderStyle}" />
                            <Border x:Name="DriverUpdatesCard" Style="{StaticResource CardStyle}">
                                <StackPanel>
                                    <Grid Background="Transparent" Tapped="ExpandHeader_Tapped">
                                        <ctk:SettingsCard Style="{StaticResource HeaderRowStyle}">
                                            <ctk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE896;"/></ctk:SettingsCard.HeaderIcon>
                                            <ctk:SettingsCard.Header>
                                                <TextBlock x:Uid="S_LenovoDriverUpdates" Text="Lenovo Driver Updates" />
                                            </ctk:SettingsCard.Header>
                                            <ctk:SettingsCard.Description>
                                                <TextBlock x:Uid="S_CheckLenovoSDriverPage" Text="Check Lenovo's driver page for this machine type" />
                                            </ctk:SettingsCard.Description>
                                            <ToggleButton x:Name="DriverUpdatesExpandToggle" MinWidth="44" MinHeight="40"
                                                      IsChecked="True"
                                                      Background="Transparent"
                                                      BorderThickness="0"
                                                      Padding="8,4"
                                                      Click="DriverUpdatesExpandToggle_Click">
                                            <FontIcon x:Name="DriverUpdatesExpandIcon" Glyph="&#xE70E;" FontSize="13"/>
                                        </ToggleButton>
                                        </ctk:SettingsCard>
                                    </Grid>
                                    <StackPanel x:Name="DriverUpdatesContent" Spacing="10" Margin="0,12,0,0">
                                        <!-- Machine info: two rows of label:value -->
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="130"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <TextBlock x:Uid="S_MachineType" Grid.Row="0" Grid.Column="0" Text="Machine type" FontSize="14" Foreground="#B9C0CC" />
                                            <TextBlock Grid.Row="0" Grid.Column="1" x:Name="DriverUpdatesMachineType" Text="—" FontSize="14" Foreground="#FFFFFF"/>
                                            <TextBlock x:Uid="S_Model" Grid.Row="1" Grid.Column="0" Text="Model" FontSize="14" Foreground="#B9C0CC" Margin="0,4,0,0" />
                                            <TextBlock Grid.Row="1" Grid.Column="1" x:Name="DriverUpdatesModel" Text="—" FontSize="14" Foreground="#FFFFFF" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                            <TextBlock x:Uid="S_InstalledBIOS" Grid.Row="2" Grid.Column="0" Text="Installed BIOS" FontSize="14" Foreground="#B9C0CC" Margin="0,4,0,0" />
                                            <TextBlock Grid.Row="2" Grid.Column="1" x:Name="DriverUpdatesBios" Text="—" FontSize="14" Foreground="#FFFFFF" Margin="0,4,0,0"/>
                                        </Grid>

                                        <!-- Actions row -->
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Button x:Uid="DriverUpdatesCheckButton" x:Name="DriverUpdatesCheckButton"
                                                    Content="Check for updates"
                                                    Style="{StaticResource ModernButtonStyle}"
                                                    Click="DriverUpdatesCheckButton_Click" />
                                            <Button x:Uid="DriverUpdatesUpdateAllButton" x:Name="DriverUpdatesUpdateAllButton"
                                                    Content="Update all"
                                                    Visibility="Collapsed"
                                                    Style="{StaticResource ModernButtonStyle}"
                                                    Click="DriverUpdatesUpdateAllButton_Click" />
                                            <Button x:Uid="DriverUpdatesOpenPageButton" x:Name="DriverUpdatesOpenPageButton"
                                                    Content="Open Lenovo driver page"
                                                    Style="{StaticResource ModernButtonStyle}"
                                                    Click="DriverUpdatesOpenPageButton_Click" />
                                        </StackPanel>

                                        <TextBlock x:Uid="DriverUpdatesStatusText" x:Name="DriverUpdatesStatusText"
                                                   Text="Click Check for updates to query Lenovo."
                                                   FontSize="12"
                                                   Foreground="#B9C0CC"
                                                   TextWrapping="Wrap" />

                                        <Border Height="1" Background="#33FFFFFF" Margin="0,2,0,0"/>

                                        <TextBlock x:Uid="S_PREFERENCES" Text="PREFERENCES" FontSize="12" FontWeight="SemiBold" Foreground="#B9C0CC" />

                                        <!-- Category filter: utilities/diagnostics hidden by default -->
                                        <CheckBox x:Uid="DriverUpdatesShowUtilitiesCheckbox" x:Name="DriverUpdatesShowUtilitiesCheckbox"
                                                  Content="Show utilities and diagnostics"
                                                  IsChecked="False"
                                                  FontSize="13"
                                                  Foreground="#B9C0CC"
                                                  Checked="DriverUpdatesShowUtilitiesCheckbox_Changed"
                                                  Unchecked="DriverUpdatesShowUtilitiesCheckbox_Changed" />

                                        <!-- Auto-install + banner-hide preferences. Persisted in
                                             LocalSettings. UpdateOnStart triggers Update-all the
                                             moment the helper pushes a non-zero driver-update count. -->
                                        <CheckBox x:Uid="DriverUpdatesUpdateOnStartCheckbox" x:Name="DriverUpdatesUpdateOnStartCheckbox"
                                                  Content="Check for driver updates on start"
                                                  IsChecked="True"
                                                  FontSize="13"
                                                  Foreground="#B9C0CC"
                                                  Checked="DriverUpdatesUpdateOnStartCheckbox_Changed"
                                                  Unchecked="DriverUpdatesUpdateOnStartCheckbox_Changed" />
                                        <CheckBox x:Uid="DriverUpdatesHideBannerCheckbox" x:Name="DriverUpdatesHideBannerCheckbox"
                                                  Content="Hide driver-update banner on Quick tab"
                                                  IsChecked="False"
                                                  FontSize="13"
                                                  Foreground="#B9C0CC"
                                                  Checked="DriverUpdatesHideBannerCheckbox_Changed"
                                                  Unchecked="DriverUpdatesHideBannerCheckbox_Changed" />

                                        <!-- Live driver list (populated when the pcsupport API responds) -->
                                        <ItemsControl x:Name="DriverUpdatesList" Visibility="Collapsed">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="#1A1A2E" CornerRadius="4" Padding="10,8" Margin="0,4,0,0">
                                                        <StackPanel>
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="14" Foreground="#FFFFFF" TextWrapping="Wrap"/>
                                                                <!-- Status chip: color comes from StatusColor ("#6CCB5F" up-to-date, "#FFB060" update, "#888" unknown/not-installed).
                                                                     Text color comes from StatusTextColor (black on the up-to-date green for contrast, white otherwise). -->
                                                                <Border Grid.Column="1" Background="{Binding StatusColor}" CornerRadius="10" Padding="8,2" Margin="8,0,0,0" VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding StatusLabel}" FontSize="12" Foreground="{Binding StatusTextColor}"/>
                                                                </Border>
                                                            </Grid>
                                                            <TextBlock FontSize="12" Foreground="#B9C0CC" TextWrapping="Wrap" Margin="0,2,0,0">
                                                                <Run Text="{Binding Category}"/><Run Text=" • "/><Run Text="{Binding Severity}"/>
                                                            </TextBlock>
                                                            <TextBlock FontSize="12" Foreground="#B9C0CC" TextWrapping="Wrap" Margin="0,2,0,0">
                                                                <Run x:Uid="S_Installed" Text="Installed:" /><Run Text=" "/><Run Text="{Binding InstalledVersion}"/><Run Text="  →  "/><Run x:Uid="S_Latest" Text="Latest:" /><Run Text=" "/><Run Text="{Binding Version}"/>
                                                            </TextBlock>
                                                            <Grid Margin="0,4,0,0">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Grid.Column="0" Text="{Binding ReleaseDate, FallbackValue=''}" FontSize="12" Foreground="#B9C0CC" VerticalAlignment="Center"/>
                                                                <Button MinHeight="40" MinWidth="40" Grid.Column="1"
                                                                        Content="{Binding InstallButtonLabel}"
                                                                        Tag="{Binding DownloadUrl}"
                                                                        Visibility="{Binding InstallButtonVisibility}"
                                                                        Style="{StaticResource ModernButtonStyle}"
                                                                        FontSize="12"
                                                                        Padding="10,4"
                                                                        Click="DriverInstallButton_Click"/>
                                                            </Grid>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <!-- GPD TAB -->
                <ScrollViewer x:Name="GPDScrollViewer" VerticalScrollBarVisibility="Auto" Visibility="Collapsed"
                              BringIntoViewOnFocusChange="True">
                    <StackPanel Padding="16,8,16,16">

                        <!-- Device Status Card -->
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock x:Uid="GPDDeviceNameText" x:Name="GPDDeviceNameText" Text="GPD Device" Style="{StaticResource CardTitleStyle}" />
                                <TextBlock x:Uid="GPDConnectionStatusText" x:Name="GPDConnectionStatusText"
                                           Text="Detecting..."
                                           FontSize="14"
                                           Foreground="#B9C0CC"
                                           Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>

                        <!-- Fan Control Card (Win 5 specific) -->
                        <StackPanel x:Name="GPDFanControlSection" Visibility="Collapsed">
                            <TextBlock x:Uid="S_FanControl" Text="Fan Control" Style="{StaticResource SectionHeaderStyle}" />

                            <Border Style="{StaticResource CardStyle}">
                                <StackPanel>
                                    <!-- Header: Fan Settings + RPM -->
                                    <TextBlock x:Uid="S_FanSettings" Text="Fan Settings" Style="{StaticResource CardTitleStyle}" />
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock x:Uid="S_Fan_3" Text="Fan: " Style="{StaticResource CardCaptionStyle}" />
                                        <TextBlock x:Uid="GPDFanRPMText" x:Name="GPDFanRPMText" Text="-- RPM" Style="{StaticResource CardCaptionStyle}" />
                                    </StackPanel>

                                    <!-- Fan Curve Toggle -->
                                    <ctk:SettingsCard x:Uid="S_FanCurve_2" Margin="0,16,0,0" Header="Fan Curve" Description="Software-controlled fan curve based on CPU temperature" Tapped="ToggleRow_Tapped">
                                        <ctk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE9CA;"/></ctk:SettingsCard.HeaderIcon>
                                        <ToggleSwitch x:Name="GPDFanCurveToggle"
                                        Style="{StaticResource ModernToggleStyle}"
                                        IsOn="False"
                                        Toggled="GPDFanCurveToggle_Toggled"
                                        XYFocusUp="{x:Bind GPDNavItem}"/>
                                    </ctk:SettingsCard>

                                    <!-- Manual Fan Controls (visible when curve OFF) -->
                                    <StackPanel x:Name="GPDManualFanContent">
                                        <!-- Fan Mode Toggle -->
                                        <Grid Margin="0,16,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock x:Uid="S_FanMode" Text="Fan Mode" Foreground="#FFFFFF" FontSize="14" />
                                                <TextBlock x:Uid="GPDFanModeText" x:Name="GPDFanModeText"
                                                           Text="Auto"
                                                           FontSize="13"
                                                           Foreground="#B9C0CC" />
                                            </StackPanel>
                                            <ToggleSwitch x:Name="GPDFanModeToggle"
                                                          Grid.Column="1"
                                                          Style="{StaticResource ModernToggleStyle}"
                                                          IsOn="False"
                                                          Toggled="GPDFanModeToggle_Toggled"/>
                                        </Grid>

                                        <!-- Fan Speed Slider (visible only in manual mode) -->
                                        <StackPanel x:Name="GPDFanSpeedSection" Margin="0,16,0,0" Visibility="Collapsed">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock x:Uid="S_FanSpeed" Text="Fan Speed" Grid.Column="0" Foreground="#FFFFFF" FontSize="14" VerticalAlignment="Center" />
                                                <TextBlock x:Name="GPDFanSpeedValueText"
                                                           Grid.Column="1"
                                                           Text="50%"
                                                           FontSize="14"
                                                           Foreground="#00C8FF"
                                                           VerticalAlignment="Center"/>
                                            </Grid>
                                            <Slider x:Name="GPDFanSpeedSlider"
                                                    Style="{StaticResource ModernSliderStyle}"
                                                    Minimum="30"
                                                    Maximum="100"
                                                    Value="50"
                                                    ValueChanged="GPDFanSpeedSlider_ValueChanged"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Fan Curve Content (visible when curve ON) -->
                                    <StackPanel x:Name="GPDFanCurveContent" Visibility="Collapsed">
                                        <!-- Preset + Expand toggle row -->
                                        <Grid Background="Transparent" MinHeight="48" Tapped="ExpandHeader_Tapped" Margin="0,12,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <ComboBox x:Name="GPDFanCurvePresetComboBox"
                                                      Grid.Column="0"
                                                      Width="130"
                                                      HorizontalAlignment="Left"
                                                      SelectionChanged="GPDFanCurvePresetComboBox_SelectionChanged">
                                                <ComboBoxItem x:Uid="S_Silent" Content="Silent" Tag="Silent" />
                                                <ComboBoxItem x:Uid="S_Balanced" Content="Balanced" Tag="Balanced" />
                                                <ComboBoxItem x:Uid="S_Performance" Content="Performance" Tag="Performance" />
                                                <ComboBoxItem x:Uid="S_MaxCooling" Content="Max Cooling" Tag="MaxCooling" />
                                                <ComboBoxItem x:Uid="S_Custom" Content="Custom" Tag="Custom" IsSelected="True" />
                                            </ComboBox>
                                            <ToggleButton x:Name="GPDFanCurveExpandToggle" MinWidth="44" MinHeight="40"
                                                          Grid.Column="1"
                                                          IsChecked="False"
                                                          VerticalAlignment="Center"
                                                          Background="Transparent"
                                                          BorderThickness="0"
                                                          Padding="8,4"
                                                          Click="GPDFanCurveExpandToggle_Click">
                                                <FontIcon x:Name="GPDFanCurveExpandIcon" Glyph="&#xE70D;" FontSize="13"/>
                                            </ToggleButton>
                                        </Grid>

                                        <!-- Expandable graph content -->
                                        <StackPanel x:Name="GPDFanCurveGraphContent" Margin="0,12,0,0" Visibility="Collapsed">
                                            <!-- Y-axis label -->
                                            <TextBlock x:Uid="S_Fan_2" Text="Fan %" FontSize="12" Foreground="#B9C0CC" Margin="0,0,0,4" />

                                            <!-- Graph area -->
                                            <Grid Height="150">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="30"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Y-axis labels -->
                                                <StackPanel Grid.Column="0" VerticalAlignment="Stretch">
                                                    <TextBlock Text="100" FontSize="12" Foreground="#B9C0CC" VerticalAlignment="Top"/>
                                                    <TextBlock Text="75" FontSize="12" Foreground="#B9C0CC" VerticalAlignment="Top" Margin="0,25,0,0"/>
                                                    <TextBlock Text="50" FontSize="12" Foreground="#B9C0CC" VerticalAlignment="Top" Margin="0,25,0,0"/>
                                                    <TextBlock Text="25" FontSize="12" Foreground="#B9C0CC" VerticalAlignment="Top" Margin="0,25,0,0"/>
                                                    <TextBlock Text="0" FontSize="12" Foreground="#B9C0CC" VerticalAlignment="Bottom"/>
                                                </StackPanel>

                                                <!-- Canvas for drawing the graph -->
                                                <Canvas x:Name="GPDFanCurveCanvas"
                                                        Grid.Column="1"
                                                        Background="#1A1A1A"
                                                        PointerPressed="GPDFanCurveCanvas_PointerPressed"
                                                        PointerMoved="GPDFanCurveCanvas_PointerMoved"
                                                        PointerReleased="GPDFanCurveCanvas_PointerReleased"
                                                        PointerCaptureLost="GPDFanCurveCanvas_PointerReleased"
                                                        SizeChanged="GPDFanCurveCanvas_SizeChanged">

                                                    <!-- Fill under the curve -->
                                                    <Polygon x:Name="GPDFanCurveFill"
                                                             Fill="#3300AAFF"
                                                             Stroke="Transparent"/>

                                                    <!-- The curve line -->
                                                    <Polyline x:Name="GPDFanCurvePolyline"
                                                              Stroke="#00AAFF"
                                                              StrokeThickness="2"
                                                              StrokeLineJoin="Round"/>

                                                    <!-- Temperature indicator line (vertical dashed orange) -->
                                                    <Line x:Name="GPDTempIndicatorLine"
                                                          Y1="0" Y2="150"
                                                          Stroke="#FF8800"
                                                          StrokeThickness="2"
                                                          StrokeDashArray="4,2"
                                                          Visibility="Collapsed"/>

                                                    <!-- Control points created in code-behind -->
                                                </Canvas>
                                            </Grid>

                                            <!-- X-axis labels (30°C to 100°C) -->
                                            <Grid Margin="30,4,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="30°C" FontSize="12" Foreground="#B9C0CC" HorizontalAlignment="Left"/>
                                                <TextBlock Grid.Column="1" Text="46°C" FontSize="12" Foreground="#B9C0CC" HorizontalAlignment="Left"/>
                                                <TextBlock Grid.Column="2" Text="62°C" FontSize="12" Foreground="#B9C0CC" HorizontalAlignment="Center"/>
                                                <TextBlock Grid.Column="3" Text="78°C" FontSize="12" Foreground="#B9C0CC" HorizontalAlignment="Right"/>
                                                <TextBlock Grid.Column="4" Text="100°C" FontSize="12" Foreground="#B9C0CC" HorizontalAlignment="Right"/>
                                            </Grid>

                                            <!-- Current CPU temperature display -->
                                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0" HorizontalAlignment="Center">
                                                <TextBlock x:Uid="S_CPUTemp_2" Text="CPU Temp: " FontSize="13" Foreground="#B9C0CC" />
                                                <TextBlock x:Name="GPDCurrentTempLabel" Text="--°C" FontSize="13" Foreground="#FF8800" FontWeight="SemiBold"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Button Remapping Section (Win 5 specific) -->
                        <StackPanel x:Name="GPDButtonRemapSection" Visibility="Collapsed">
                            <TextBlock x:Uid="S_ButtonRemapping" Text="Button Remapping" Style="{StaticResource SectionHeaderStyle}" />

                            <Border Style="{StaticResource CardStyle}">
                                <StackPanel>
                                    <Grid Background="Transparent" Tapped="ExpandHeader_Tapped">
                                        <ctk:SettingsCard Style="{StaticResource HeaderRowStyle}">
                                            <ctk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE8AB;"/></ctk:SettingsCard.HeaderIcon>
                                            <ctk:SettingsCard.Header>
                                                <TextBlock x:Uid="S_ButtonRemapping" Text="Button Remapping" />
                                            </ctk:SettingsCard.Header>
                                            <ctk:SettingsCard.Description>
                                                <TextBlock x:Uid="S_RemapControllerButtonsToKeyboard" Text="Remap controller buttons to keyboard or mouse" />
                                            </ctk:SettingsCard.Description>
                                            <ToggleButton x:Name="GPDButtonRemapExpandToggle" MinWidth="44" MinHeight="40"
                                                      IsChecked="False"
                                                      Background="Transparent"
                                                      BorderThickness="0"
                                                      Padding="8,4"
                                                      Click="GPDButtonRemapExpandToggle_Click">
                                            <FontIcon x:Name="GPDButtonRemapExpandIcon" Glyph="&#xE70D;" FontSize="13"/>
                                        </ToggleButton>
                                        </ctk:SettingsCard>
                                    </Grid>

                                    <StackPanel x:Name="GPDButtonRemapContent" Spacing="8" Margin="0,12,0,0" Visibility="Collapsed">

                                        <!-- Face Buttons -->
                                        <TextBlock x:Uid="S_FaceButtons" Text="Face Buttons" Foreground="#FFFFFF" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,4" />
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="80"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="A" Grid.Column="0" VerticalAlignment="Center" Foreground="#B9C0CC" FontSize="14"/>
                                            <ComboBox x:Name="GPDButtonAComboBox" Grid.Column="1" Style="{StaticResource ModernComboBoxStyle}" SelectionChanged="GPDButtonComboBox_SelectionChanged" Tag="A">
                                                <x:String>Disabled</x:String>
                                                <x:String>F1</x:String><x:String>F2</x:String><x:String>F3</x:String><x:String>F4</x:String><x:String>F5</x:String><x:String>F6</x:String><x:String>F7</x:String><x:String>F8</x:String><x:String>F9</x:String><x:String>F10</x:String><x:String>F11</x:String><x:String>F12</x:String>
                                                <x:String>F13</x:String><x:String>F14</x:String><x:String>F15</x:String><x:String>F16</x:String><x:String>F17</x:String>
                                                <x:String>Enter</x:String><x:String>Escape</x:String><x:String>Space</x:String><x:String>Tab</x:String><x:String>Backspace</x:String>
                                                <x:String>Up</x:String><x:String>Down</x:String><x:String>Left</x:String><x:String>Right</x:String>
                                                <x:String>Home</x:String><x:String>End</x:String><x:String>PageUp</x:String><x:String>PageDown</x:String><x:String>Insert</x:String><x:String>Delete</x:String>
                                                <x:String>Left Ctrl</x:String><x:String>Left Shift</x:String><x:String>Left Alt</x:String><x:String>Left Win</x:String>
                                                <x:String>Right Ctrl</x:String><x:String>Right Shift</x:String><x:String>Right Alt</x:String>
                                                <x:String>Mouse Left</x:String><x:String>Mouse Right</x:String><x:String>Mouse Middle</x:String>
                                                <x:String>Mouse Wheel Up</x:String><x:String>Mouse Wheel Down</x:String>
                                            </ComboBox>
                                        </Grid>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="80"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="B" Grid.Column="0" VerticalAlignment="Center" Foreground="#B9C0CC" FontSize="14"/>
                                            <ComboBox x:Name="GPDButtonBComboBox" Grid.Column="1" Style="{StaticResource ModernComboBoxStyle}" SelectionChanged="GPDButtonComboBox_SelectionChanged" Tag="B">
                                                <x:String>Disabled</x:String>
                                                <x:String>F1</x:String><x:String>F2</x:String><x:String>F3</x:String><x:String>F4</x:String><x:String>F5</x:String><x:String>F6</x:String><x:String>F7</x:String><x:String>F8</x:String><x:String>F9</x:String><x:String>F10</x:String><x:String>F11</x:String><x:String>F12</x:String>
                                                <x:String>F13</x:String><x:String>F14</x:String><x:String>F15</x:String><x:String>F16</x:String><x:String>F17</x:String>
                                                <x:String>Enter</x:String><x:String>Escape</x:String><x:String>Space</x:String><x:String>Tab</x:String><x:String>Backspace</x:String>
                                                <x:String>Up</x:String><x:String>Down</x:String><x:String>Left</x:String><x:String>Right</x:String>
                                                <x:String>Home</x:String><x:String>End</x:String><x:String>PageUp</x:String><x:String>PageDown</x:String><x:String>Insert</x:String><x:String>Delete</x:String>
                                                <x:String>Left Ctrl</x:String><x:String>Left Shift</x:String><x:String>Left Alt</x:String><x:String>Left Win</x:String>
                                                <x:String>Right Ctrl</x:String><x:String>Right Shift</x:String><x:String>Right Alt</x:String>
                                                <x:String>Mouse Left</x:String><x:String>Mouse Right</x:String><x:String>Mouse Middle</x:String>
                                                <x:String>Mouse Wheel Up</x:String><x:String>Mouse Wheel Down</x:String>
                                            </ComboBox>
                                        </Grid>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="80"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="X" Grid.Column="0" VerticalAlignment="Center" Foreground="#B9C0CC" FontSize="14"/>

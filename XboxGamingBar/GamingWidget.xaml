                                    <StackPanel Style="{x:Null}" x:Name="LegionBrightnessCard"><ctk:SettingsCard ContentAlignment="Vertical" HorizontalContentAlignment="Stretch"><ctk:SettingsCard.Header><TextBlock TextWrapping="Wrap" x:Uid="S_Brightness" Text="Brightness" /></ctk:SettingsCard.Header><ctk:SettingsCard.Description><TextBlock TextWrapping="Wrap" x:Name="LegionBrightnessValue" Text="100%"/></ctk:SettingsCard.Description><Slider x:Name="LegionBrightnessSlider" Style="{StaticResource ModernSliderStyle}" Minimum="0" Maximum="100" Value="100" ValueChanged="LegionBrightnessSlider_ValueChanged"/></ctk:SettingsCard></StackPanel>
                                    <StackPanel Style="{x:Null}" x:Name="LegionSpeedCard" Visibility="Collapsed"><ctk:SettingsCard ContentAlignment="Vertical" HorizontalContentAlignment="Stretch"><ctk:SettingsCard.Header><TextBlock TextWrapping="Wrap" x:Uid="S_Speed" Text="Speed" /></ctk:SettingsCard.Header><ctk:SettingsCard.Description><TextBlock TextWrapping="Wrap" x:Name="LegionSpeedValue" Text="50%"/></ctk:SettingsCard.Description><Slider x:Name="LegionSpeedSlider" Style="{StaticResource ModernSliderStyle}" Minimum="0" Maximum="100" Value="50" ValueChanged="LegionSpeedSlider_ValueChanged"/></ctk:SettingsCard></StackPanel>

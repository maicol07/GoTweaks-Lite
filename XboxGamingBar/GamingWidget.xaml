<Page
    x:Class="XboxGamingBar.GamingWidget"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:XboxGamingBar"
    xmlns:converter="using:XboxGamingBar.Converter"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:ctk="using:CommunityToolkit.WinUI.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    d:DesignHeight="670" d:DesignWidth="600">

    <Page.Resources>
        <!-- Existing Converters -->
        <converter:WattStringConverter x:Key="WattStringConverter"/>
        <converter:MegahertzStringConverter x:Key="MegahertzStringConverter"/>
        <converter:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <converter:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter"/>
        <converter:SharpnessPercentStringConverter x:Key="SharpnessPercentStringConverter"/>
        <converter:RadeonBoostResolutionStringConverter x:Key="RadeonBoostResolutionStringConverter"/>

        <!-- System Accent Color Brush (Light2 variant for dark theme text) -->
        <SolidColorBrush x:Key="SystemAccentBrush" Color="{ThemeResource SystemAccentColorLight2}"/>

        <!-- Win11 Theme Colors (promoted app-wide 2026-07-11 from the Performance-tab
             pilot checkpoint; matches the already-shipped Quick Settings tile palette) -->
        <SolidColorBrush x:Key="PageBackgroundBrush" Color="#25282C"/>
        <SolidColorBrush x:Key="CardBackgroundBrush" Color="#35393F"/>
        <SolidColorBrush x:Key="CardBorderBrush" Color="#22FFFFFF"/>
        <SolidColorBrush x:Key="ButtonBackground" Color="#3E434B"/>
        <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#484E58"/>
        <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#3A3F47"/>
        <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="#2C3035"/>
        <SolidColorBrush x:Key="ButtonBorderBrush" Color="#22FFFFFF"/>
        <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#33FFFFFF"/>
        <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="#22FFFFFF"/>
        <SolidColorBrush x:Key="ButtonBorderBrushDisabled" Color="#14FFFFFF"/>
        <CornerRadius x:Key="ControlCornerRadius">8,8,8,8</CornerRadius>
        <Thickness x:Key="ButtonPadding">15,10,15,11</Thickness>

        <!-- Card Focus Border Brush -->
        <SolidColorBrush x:Key="CardFocusBorderBrush" Color="White"/>

        <!-- Navigation RadioButton Style - Optimized for Handheld XY Navigation -->
        <!-- Uses RadioButtons group which treats tabs as single navigable unit -->

        <!-- Card Title Style - Win11 -->
        <Style x:Key="CardTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <!-- Card Title Style - Compact Mode -->
        <Style x:Key="CardTitleStyleCompact" TargetType="TextBlock" BasedOn="{StaticResource CardTitleStyle}">
            <Setter Property="FontSize" Value="20"/>
        </Style>

        <!-- Card Caption Style - Win11 -->
        <Style x:Key="CardCaptionStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#B9C0CC"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
        </Style>

        <!-- Card Caption Style - Compact Mode -->
        <Style x:Key="CardCaptionStyleCompact" TargetType="TextBlock" BasedOn="{StaticResource CardCaptionStyle}">
            <Setter Property="FontSize" Value="16"/>
        </Style>

        <!-- Card Value Style -->
        <Style x:Key="CardValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource SystemAccentBrush}"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Card Value Style - Compact Mode -->
        <Style x:Key="CardValueStyleCompact" TargetType="TextBlock" BasedOn="{StaticResource CardValueStyle}">
            <Setter Property="FontSize" Value="20"/>
        </Style>

        <!-- Modern Toggle Style - Uses system style, focus highlight on parent card -->
        <Style x:Key="ModernToggleStyle" TargetType="ToggleSwitch" BasedOn="{StaticResource DefaultToggleSwitchStyle}">
            <Setter Property="MinWidth" Value="40"/>
            <Setter Property="MaxWidth" Value="40"/>
            <Setter Property="MinHeight" Value="20"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="OffContent" Value=""/>
            <Setter Property="OnContent" Value=""/>
            <Setter Property="UseSystemFocusVisuals" Value="True"/>
            <Setter Property="FocusVisualPrimaryBrush" Value="White"/>
            <Setter Property="FocusVisualSecondaryBrush" Value="Transparent"/>
            <Setter Property="FocusVisualPrimaryThickness" Value="2"/>
            <Setter Property="FocusVisualMargin" Value="-3,-3,-3,-3"/>
        </Style>

        <!-- Modern Slider Style - Fluent with System Accent Color, focus on parent card -->
        <Style x:Key="ModernSliderStyle" TargetType="Slider" BasedOn="{StaticResource DefaultSliderStyle}">
            <Setter Property="Margin" Value="0,4,0,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="ManipulationMode" Value="None"/>
            <Setter Property="IsFocusEngagementEnabled" Value="True"/>
            <!-- High-visibility white focus ring for gamepad navigation (matches ModernToggleStyle) -->
            <Setter Property="UseSystemFocusVisuals" Value="True"/>
            <Setter Property="FocusVisualPrimaryBrush" Value="White"/>
            <Setter Property="FocusVisualSecondaryBrush" Value="Transparent"/>
            <Setter Property="FocusVisualPrimaryThickness" Value="2"/>
            <Setter Property="FocusVisualMargin" Value="-3,-3,-3,-3"/>
        </Style>

        <!-- Modern ComboBox Style - System style with minor customizations -->
        <Style x:Key="ModernComboBoxStyle" TargetType="ComboBox" BasedOn="{StaticResource DefaultComboBoxStyle}">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <!-- High-visibility white focus ring for gamepad navigation -->
            <Setter Property="UseSystemFocusVisuals" Value="True"/>
            <Setter Property="FocusVisualPrimaryBrush" Value="White"/>
            <Setter Property="FocusVisualSecondaryBrush" Value="Transparent"/>
            <Setter Property="FocusVisualPrimaryThickness" Value="2"/>
            <Setter Property="FocusVisualMargin" Value="-3,-3,-3,-3"/>
        </Style>

        <!-- Override ComboBox border colors to prevent highlight on focus/hover -->
        <SolidColorBrush x:Key="ComboBoxBorderBrushPointerOver" Color="#33FFFFFF"/>
        <SolidColorBrush x:Key="ComboBoxBorderBrushPressed" Color="#33FFFFFF"/>
        <SolidColorBrush x:Key="ComboBoxBorderBrushFocused" Color="#33FFFFFF"/>
        <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="#35393F"/>
        <SolidColorBrush x:Key="ComboBoxBackgroundPressed" Color="#35393F"/>
        <SolidColorBrush x:Key="ComboBoxBackgroundFocused" Color="#35393F"/>


        <!-- Reusable high-visibility white focus-ring setters for gamepad navigation.
             Merged into the interactive-control styles below so every button/toggle/checkbox
             shows the same clear white ring when focused with the pad. -->

        <!-- Modern Button Style - System style -->
        <Style x:Key="ModernButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="UseSystemFocusVisuals" Value="True"/>
            <Setter Property="FocusVisualPrimaryBrush" Value="White"/>
            <Setter Property="FocusVisualSecondaryBrush" Value="Transparent"/>
            <Setter Property="FocusVisualPrimaryThickness" Value="2"/>
            <Setter Property="FocusVisualMargin" Value="-3,-3,-3,-3"/>
        </Style>

        <!-- Standalone Button Style - System style -->
        <Style x:Key="StandaloneButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="UseSystemFocusVisuals" Value="True"/>
            <Setter Property="FocusVisualPrimaryBrush" Value="White"/>
            <Setter Property="FocusVisualSecondaryBrush" Value="Transparent"/>
            <Setter Property="FocusVisualPrimaryThickness" Value="2"/>
            <Setter Property="FocusVisualMargin" Value="-3,-3,-3,-3"/>
        </Style>

        <!-- Standalone ToggleButton Style - System style -->
        <Style x:Key="StandaloneToggleButtonStyle" TargetType="ToggleButton" BasedOn="{StaticResource DefaultToggleButtonStyle}">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="UseSystemFocusVisuals" Value="True"/>
            <Setter Property="FocusVisualPrimaryBrush" Value="White"/>
            <Setter Property="FocusVisualSecondaryBrush" Value="Transparent"/>
            <Setter Property="FocusVisualPrimaryThickness" Value="2"/>
            <Setter Property="FocusVisualMargin" Value="-3,-3,-3,-3"/>
        </Style>

        <!-- Scale button (Scaling tab): accent-colored fill with dark text for contrast, in
             every state (idle and checked alike - no more accent-vs-gray distinction between
             them). Full custom template (not just resource overrides) so this stays scoped to
             this one control instead of affecting every other ToggleButton in the app (the
             many small expand/collapse chevron toggles). Disabled while there are unsaved
             Scale-tab setting changes pending Apply-and-Restart - see
             GamingWidget.LosslessScaling.cs's dirty-tracking. -->
        <Style x:Key="ScaleToggleButtonStyle" TargetType="ToggleButton">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="{StaticResource ButtonPadding}"/>
            <Setter Property="Background" Value="{StaticResource SystemAccentBrush}"/>
            <Setter Property="Foreground" Value="#1A1A1A"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="UseSystemFocusVisuals" Value="True"/>
            <Setter Property="FocusVisualPrimaryBrush" Value="White"/>
            <Setter Property="FocusVisualSecondaryBrush" Value="Transparent"/>
            <Setter Property="FocusVisualPrimaryThickness" Value="2"/>
            <Setter Property="FocusVisualMargin" Value="-3,-3,-3,-3"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="RootBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="{StaticResource ControlCornerRadius}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                BorderBrush="{TemplateBinding BorderBrush}">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal"/>
                                    <VisualState x:Name="PointerOver">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="RootBorder" Storyboard.TargetProperty="Opacity" To="0.85" Duration="0"/>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="RootBorder" Storyboard.TargetProperty="Opacity" To="0.7" Duration="0"/>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RootBorder" Storyboard.TargetProperty="Background">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource ButtonBackgroundDisabled}"/>
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Checked"/>
                                    <VisualState x:Name="CheckedPointerOver">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="RootBorder" Storyboard.TargetProperty="Opacity" To="0.85" Duration="0"/>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="CheckedPressed">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="RootBorder" Storyboard.TargetProperty="Opacity" To="0.7" Duration="0"/>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="CheckedDisabled">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RootBorder" Storyboard.TargetProperty="Background">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource ButtonBackgroundDisabled}"/>
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <ContentPresenter x:Name="ContentPresenter"
                                              Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              Foreground="{TemplateBinding Foreground}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              Padding="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Apply and Restart button (Scaling tab): default StandaloneButtonStyle look while
             disabled (no pending changes), but a custom template so that while it's enabled
             (green - see GamingWidget.LosslessScaling.cs's dirty-tracking) hovering/pressing
             darkens via opacity like the Scale button, instead of the system default template's
             PointerOver/Pressed VisualStates swapping to their own gray ButtonBackgroundPointerOver/
             Pressed resources (which would flash the green back to gray on hover, overriding
             whatever code-behind just set .Background to). Background/Foreground are driven
             entirely from code-behind (UpdateLosslessScalingDirtyState) - the Disabled VisualState
             here restores the normal disabled look regardless of what code-behind last set. -->
        <Style x:Key="LosslessScalingApplyButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="UseSystemFocusVisuals" Value="True"/>
            <Setter Property="FocusVisualPrimaryBrush" Value="White"/>
            <Setter Property="FocusVisualSecondaryBrush" Value="Transparent"/>
            <Setter Property="FocusVisualPrimaryThickness" Value="2"/>
            <Setter Property="FocusVisualMargin" Value="-3,-3,-3,-3"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="RootBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="{StaticResource ControlCornerRadius}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                BorderBrush="{TemplateBinding BorderBrush}">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal"/>
                                    <VisualState x:Name="PointerOver">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="RootBorder" Storyboard.TargetProperty="Opacity" To="0.85" Duration="0"/>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="RootBorder" Storyboard.TargetProperty="Opacity" To="0.7" Duration="0"/>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RootBorder" Storyboard.TargetProperty="Background">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource ButtonBackgroundDisabled}"/>
                                            </ObjectAnimationUsingKeyFrames>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPresenter" Storyboard.TargetProperty="Foreground">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource ButtonForegroundDisabled}"/>
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <ContentPresenter x:Name="ContentPresenter"
                                              Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              Foreground="{TemplateBinding Foreground}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              Padding="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Checkbox with system style -->
        <Style x:Key="FocusableCheckBoxStyle" TargetType="CheckBox" BasedOn="{StaticResource DefaultCheckBoxStyle}">
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="UseSystemFocusVisuals" Value="True"/>
            <Setter Property="FocusVisualPrimaryBrush" Value="White"/>
            <Setter Property="FocusVisualSecondaryBrush" Value="Transparent"/>
            <Setter Property="FocusVisualPrimaryThickness" Value="2"/>
            <Setter Property="FocusVisualMargin" Value="-3,-3,-3,-3"/>
        </Style>

        <!-- Default Button Style Override - uses system style -->
        <Style TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="UseSystemFocusVisuals" Value="True"/>
            <Setter Property="FocusVisualPrimaryBrush" Value="White"/>
            <Setter Property="FocusVisualSecondaryBrush" Value="Transparent"/>
            <Setter Property="FocusVisualPrimaryThickness" Value="2"/>
            <Setter Property="FocusVisualMargin" Value="-3,-3,-3,-3"/>
        </Style>

        <!-- Default ToggleButton Style Override - uses system style -->
        <Style TargetType="ToggleButton" BasedOn="{StaticResource DefaultToggleButtonStyle}">
            <Setter Property="UseSystemFocusVisuals" Value="True"/>
            <Setter Property="FocusVisualPrimaryBrush" Value="White"/>
            <Setter Property="FocusVisualSecondaryBrush" Value="Transparent"/>
            <Setter Property="FocusVisualPrimaryThickness" Value="2"/>
            <Setter Property="FocusVisualMargin" Value="-3,-3,-3,-3"/>
        </Style>

        <!-- Default CheckBox Style Override - uses system style -->
        <Style TargetType="CheckBox" BasedOn="{StaticResource DefaultCheckBoxStyle}">
            <Setter Property="UseSystemFocusVisuals" Value="True"/>
            <Setter Property="FocusVisualPrimaryBrush" Value="White"/>
            <Setter Property="FocusVisualSecondaryBrush" Value="Transparent"/>
            <Setter Property="FocusVisualPrimaryThickness" Value="2"/>
            <Setter Property="FocusVisualMargin" Value="-3,-3,-3,-3"/>
        </Style>

        <!-- Implicit Slider style: sliders without an explicit style still require A
             to engage before the D-pad changes their value. -->
        <Style TargetType="Slider" BasedOn="{StaticResource DefaultSliderStyle}">
            <Setter Property="IsFocusEngagementEnabled" Value="True"/>
            <Setter Property="UseSystemFocusVisuals" Value="True"/>
            <Setter Property="FocusVisualPrimaryBrush" Value="White"/>
            <Setter Property="FocusVisualSecondaryBrush" Value="Transparent"/>
            <Setter Property="FocusVisualPrimaryThickness" Value="2"/>
            <Setter Property="FocusVisualMargin" Value="-3,-3,-3,-3"/>
        </Style>

        <!-- Gamepad key chips (nav bar LT/RT and the bottom command bar) -->
        <Style x:Key="GamepadKeyHintStyle" TargetType="Border">
            <Setter Property="Background" Value="#45494F"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="MinWidth" Value="24"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="Padding" Value="6,0,6,0"/>
        </Style>
        <Style x:Key="GamepadKeyHintTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="CommandHintLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#B9C0CC"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="5,0,0,0"/>
        </Style>

        <!-- Settings look (Windows Settings style). Page-level overrides of the toolkit/WinUI
             theme brushes so SettingsCard/SettingsExpander/Expander match the widget palette. -->
        <SolidColorBrush x:Key="SettingsCardBackground" Color="#35393F"/>
        <SolidColorBrush x:Key="SettingsCardBackgroundPointerOver" Color="#3C4047"/>
        <SolidColorBrush x:Key="SettingsCardBackgroundPressed" Color="#32363C"/>
        <SolidColorBrush x:Key="SettingsCardBackgroundDisabled" Color="#2C3035"/>
        <SolidColorBrush x:Key="SettingsCardBorderBrush" Color="#14FFFFFF"/>
        <SolidColorBrush x:Key="SettingsCardBorderBrushPointerOver" Color="#22FFFFFF"/>
        <SolidColorBrush x:Key="ExpanderHeaderBackground" Color="#35393F"/>
        <SolidColorBrush x:Key="ExpanderContentBackground" Color="#2F3338"/>
        <SolidColorBrush x:Key="ExpanderHeaderBorderBrush" Color="#14FFFFFF"/>
        <SolidColorBrush x:Key="ExpanderContentBorderBrush" Color="#14FFFFFF"/>

        <!-- Section title above a group of rows (14 px SemiBold, like Windows Settings). -->
        <Style x:Key="SettingsSectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Margin" Value="2,18,0,6"/>
        </Style>

        <!-- SettingsCard keeps its control beside the header down to the widget width (toolkit default wraps below 476). -->
        <x:Double x:Key="SettingsCardWrapThreshold">300</x:Double>
        <x:Double x:Key="SettingsCardWrapNoIconThreshold">240</x:Double>

        <!-- Segmented items at touch size -->
        <Style TargetType="ctk:SegmentedItem">
            <Setter Property="MinHeight" Value="44"/>
            <Setter Property="MinWidth" Value="48"/>
            <Setter Property="Padding" Value="12,6,12,6"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <!-- Section Header Style - Win11 -->
        <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Margin" Value="2,18,0,6"/>
        </Style>

        <!-- Quick Settings Tile Colors - Dark mode with sharp contrast -->
        <SolidColorBrush x:Key="TileOffBackground" Color="#1A1C1E"/>
        <SolidColorBrush x:Key="TileOnBackground" Color="#1A2E1F"/>
        <SolidColorBrush x:Key="TileActiveBackground" Color="#1A2530"/>
        <SolidColorBrush x:Key="TileTriggerBackground" Color="#252030"/>
        <SolidColorBrush x:Key="TileBorderBrush" Color="Transparent"/>
        <SolidColorBrush x:Key="TileFocusBorderBrush" Color="White"/>
        <!-- Inactive state: even darker -->
        <SolidColorBrush x:Key="TileInactiveBackground" Color="#0D0E0F"/>
        <SolidColorBrush x:Key="TileInactiveForeground" Color="#606060"/>

        <!-- Quick Settings Tile Style - Xbox Game Bar Widget UI Guidelines -->
        <!-- Rest: normal background, Focus: rest + white stroke, Press: 10% darker, Focus+Press: press + stroke, Inactive: 50% darker -->
        <Style x:Key="QuickSettingsTileStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource TileOffBackground}"/>
            <Setter Property="BorderBrush" Value="#22FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="MinWidth" Value="60"/>
            <Setter Property="MinHeight" Value="72"/>
            <Setter Property="UseSystemFocusVisuals" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal"/>
                                    <VisualState x:Name="PointerOver"/>
                                    <VisualState x:Name="Pressed">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="PressedOverlay" Storyboard.TargetProperty="Visibility">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="Visible"/>
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="InactiveOverlay" Storyboard.TargetProperty="Visibility">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="Visible"/>
                                            </ObjectAnimationUsingKeyFrames>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPresenter" Storyboard.TargetProperty="Foreground">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource TileInactiveForeground}"/>
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                </VisualStateGroup>
                                <VisualStateGroup x:Name="FocusStates">
                                    <VisualState x:Name="Focused">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="FocusBorder" Storyboard.TargetProperty="Visibility">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="Visible"/>
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Unfocused"/>
                                    <VisualState x:Name="PointerFocused"/>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>

                            <!-- Background with a faint, constant Win11-style hairline
                                 border (same on every tile, doesn't change with state) -->
                            <Border x:Name="BackgroundBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="12"/>

                            <!-- Pressed overlay (10% darker) -->
                            <Border x:Name="PressedOverlay"
                                    Background="#1A000000"
                                    CornerRadius="12"
                                    Visibility="Collapsed"/>

                            <!-- Inactive overlay (50% darker) -->
                            <Border x:Name="InactiveOverlay"
                                    Background="#80000000"
                                    CornerRadius="12"
                                    Visibility="Collapsed"/>

                            <!-- Focus stroke border -->
                            <Border x:Name="FocusBorder"
                                    BorderBrush="White"
                                    BorderThickness="2"
                                    CornerRadius="12"
                                    Visibility="Collapsed"/>

                            <!-- Content -->
                            <ContentPresenter x:Name="ContentPresenter"
                                              Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              Padding="{TemplateBinding Padding}"
                                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Quick Settings Edit Mode Checkbox Style -->
        <Style x:Key="TileVisibilityCheckBoxStyle" TargetType="CheckBox" BasedOn="{StaticResource DefaultCheckBoxStyle}">
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

    </Page.Resources>

    <Grid Background="{StaticResource PageBackgroundBrush}">
        <ProgressRing x:Name="LoadingProgressRing"
                      IsActive="True"
                      Visibility="Collapsed"
                      Width="60"
                      Height="60"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"/>

        <!-- Navigation Bar using RadioButtons for proper XY focus navigation -->
        <Grid x:Name="MainNavContainer">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Nav Bar Row -->
            <Grid Grid.Row="0" Background="Transparent" Margin="8,6,8,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- LT indicator -->
                <Border Grid.Column="0" Style="{StaticResource GamepadKeyHintStyle}" Margin="0,0,6,0" VerticalAlignment="Center">
                    <TextBlock Text="LT" Style="{StaticResource GamepadKeyHintTextStyle}"/>
                </Border>

                <!-- Navigation Tabs - StackPanel for proper horizontal XY navigation -->
                <!-- XYFocusKeyboardNavigation="Disabled" prevents vertical nav within, allows left/right -->
                <!-- Main tabs: Segmented with the selection pill animation; the label is shown on the
                     selected tab only (UpdateMainNavLabels). The D-pad moves focus, A or a tap selects. -->
                <ctk:Segmented x:Name="MainNavPanel"
                               Grid.Column="1"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               SingleSelectionFollowsFocus="False"
                               SelectionChanged="MainNav_SelectionChanged">
                    <ctk:Segmented.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="2"/></ItemsPanelTemplate></ctk:Segmented.ItemsPanel>
                    <ctk:SegmentedItem x:Name="QuickNavItem" x:Uid="QuickNavItem" AutomationProperties.Name="Quick" Tag="Quick">
                        <ctk:SegmentedItem.Icon><FontIcon Glyph="&#xE80A;"/></ctk:SegmentedItem.Icon>
                    </ctk:SegmentedItem>
                    <ctk:SegmentedItem x:Name="PerformanceNavItem" x:Uid="PerformanceNavItem" AutomationProperties.Name="Performance" Tag="Performance">
                        <ctk:SegmentedItem.Icon><FontIcon Glyph="&#xEC4A;"/></ctk:SegmentedItem.Icon>
                    </ctk:SegmentedItem>
                    <ctk:SegmentedItem x:Name="ProfilesNavItem" x:Uid="ProfilesNavItem" AutomationProperties.Name="Profiles" Tag="Game">
                        <ctk:SegmentedItem.Icon><FontIcon Glyph="&#xE7FC;"/></ctk:SegmentedItem.Icon>
                    </ctk:SegmentedItem>
                    <ctk:SegmentedItem x:Name="LegionNavItem" x:Uid="LegionNavItem" AutomationProperties.Name="Legion" Tag="Legion" Visibility="Collapsed">
                        <ctk:SegmentedItem.Icon><FontIcon Glyph="&#xE772;"/></ctk:SegmentedItem.Icon>
                    </ctk:SegmentedItem>
                    <ctk:SegmentedItem x:Name="GPDNavItem" x:Uid="GPDNavItem" AutomationProperties.Name="GPD" Tag="GPD" Visibility="Collapsed">
                        <ctk:SegmentedItem.Icon><FontIcon Glyph="&#xE7F8;"/></ctk:SegmentedItem.Icon>
                    </ctk:SegmentedItem>
                    <ctk:SegmentedItem x:Name="SystemNavItem" x:Uid="SystemNavItem" AutomationProperties.Name="System" Tag="System">
                        <ctk:SegmentedItem.Icon><FontIcon Glyph="&#xE713;"/></ctk:SegmentedItem.Icon>
                    </ctk:SegmentedItem>
                </ctk:Segmented>

                <!-- RT indicator and status dot -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Spacing="4">
                    <Border Style="{StaticResource GamepadKeyHintStyle}" Margin="6,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="RT" Style="{StaticResource GamepadKeyHintTextStyle}"/>
                    </Border>
                    <!-- Helper Connection Status Indicator (40 px touch target) -->
                    <Border x:Name="HelperStatusIndicator"
                            x:Uid="HelperStatusIndicator"
                            Background="Transparent"
                            CornerRadius="20"
                            MinWidth="40"
                            MinHeight="40"
                            Padding="15,0,15,0"
                            Margin="0,0,0,0"
                            VerticalAlignment="Center"
                            ToolTipService.ToolTip="Helper Status"
                            Tapped="HelperStatusIndicator_Tapped">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <Ellipse x:Name="HelperStatusDot"
                                     Width="10" Height="10"
                                     Fill="#FF5555"
                                     VerticalAlignment="Center"/>
                            <TextBlock x:Uid="HelperStatusText" x:Name="HelperStatusText"
                                       Text="Disconnected"
                                       Foreground="#B9C0CC"
                                       FontSize="13"
                                       VerticalAlignment="Center"
                                       Visibility="Collapsed" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- Helper connection and app update notices, between the tabs and the content. -->
            <StackPanel Grid.Row="1" Margin="12,2,12,4" Spacing="4">
                <muxc:InfoBar x:Name="ConnectionStatusBanner"
                              x:Uid="ConnectionStatusBanner"
                              IsOpen="True"
                              IsClosable="False"
                              Severity="Informational"
                              Message="Loading..."
                              Visibility="Visible"/>
                <muxc:InfoBar x:Name="UpdateAvailableBanner"
                              x:Uid="UpdateAvailableBanner"
                              IsOpen="True"
                              IsClosable="True"
                              CloseButtonClick="UpdateAvailableBanner_CloseButtonClick"
                              Severity="Success"
                              Message="Update Available: v0.0.0"
                              Visibility="Collapsed">
                    <muxc:InfoBar.ActionButton>
                        <Button x:Uid="UpdateBannerButton" x:Name="UpdateBannerButton" Content="Update" Click="UpdateBannerButton_Click"/>
                    </muxc:InfoBar.ActionButton>
                </muxc:InfoBar>
            </StackPanel>

            <!-- Content Area -->
            <Grid Grid.Row="2">
            <!-- QUICK SETTINGS TAB -->
            <Grid>
                <ScrollViewer x:Name="QuickSettingsScrollViewer" VerticalScrollBarVisibility="Auto" Visibility="Visible"
                              BringIntoViewOnFocusChange="True">
                    <StackPanel Padding="16,8,16,16" Spacing="4">

                        <!-- Driver updates (Legion only, visible when count > 0): View jumps to the
                             Legion tab's Device section. -->
                        <muxc:InfoBar x:Name="QuickDriverUpdatesTile"
                                      Visibility="Collapsed"
                                      IsOpen="True"
                                      IsClosable="False"
                                      Severity="Warning"
                                      Margin="0,0,0,8">
                            <muxc:InfoBar.Content>
                                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,12">
                                    <Border Background="#FFB060" CornerRadius="11" MinWidth="22" Height="22" Padding="6,0" VerticalAlignment="Center">
                                        <TextBlock x:Name="QuickDriverUpdatesCountText" Text="0" FontSize="12" FontWeight="Bold" Foreground="#1A1A1A"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock x:Uid="QuickDriverUpdatesTitleText" x:Name="QuickDriverUpdatesTitleText" Text="Driver updates available"
                                               FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                </StackPanel>
                            </muxc:InfoBar.Content>
                            <muxc:InfoBar.ActionButton>
                                <Button x:Uid="S_QuickDriverUpdatesView" Content="View" Click="QuickDriverUpdatesTile_Click"/>
                            </muxc:InfoBar.ActionButton>
                        </muxc:InfoBar>

                        <!-- GoTweaks self-update: Install asks the helper to download and install the
                             signed bundle. Hidden when there is no update or the banner is turned off. -->
                        <muxc:InfoBar x:Name="QuickGoTweaksUpdateTile"
                                      Visibility="Collapsed"
                                      IsOpen="True"
                                      IsClosable="False"
                                      Severity="Informational"
                                      Margin="0,0,0,8">
                            <muxc:InfoBar.Content>
                                <StackPanel Margin="0,0,0,12">
                                    <TextBlock x:Uid="QuickGoTweaksTitleText" x:Name="QuickGoTweaksTitleText" Text="GoTweaks Lite update available"
                                               FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                    <TextBlock x:Uid="QuickGoTweaksSubtitleText" x:Name="QuickGoTweaksSubtitleText" Text="Tap to install"
                                               FontSize="12" Foreground="#B9C0CC" TextWrapping="Wrap"/>
                                </StackPanel>
                            </muxc:InfoBar.Content>
                            <muxc:InfoBar.ActionButton>
                                <Button x:Uid="S_QuickGoTweaksInstall" Content="Install" Click="QuickGoTweaksUpdateTile_Click"/>
                            </muxc:InfoBar.ActionButton>
                        </muxc:InfoBar>

                        <!-- Quick Metrics Row (compact stats display - dynamically populated) -->
                        <Border x:Name="QuickMetricsRow"
                                Background="#35393F"
                                CornerRadius="12"
                                Padding="4,9"
                                Margin="0,0,0,8"
                                BorderBrush="#22FFFFFF"
                                BorderThickness="1"
                                Visibility="Collapsed">
                            <!-- Dynamic metrics grid - populated in code-behind -->
                            <Grid x:Name="QuickMetricsGrid"/>
                        </Border>

                        <!-- Optional Built-in Display Brightness slider (hidden by default; -->
                        <!-- revealed under Customize. Sits under the metrics row, or in its -->
                        <!-- place when metrics are hidden. Background matches the metrics row; -->
                        <!-- the slider itself uses the active system accent color by default. -->
                        <Border x:Name="PanelBrightnessRow"
                                Background="#35393F"
                                CornerRadius="12"
                                Padding="12,8"
                                Margin="0,0,0,8"
                                BorderBrush="#22FFFFFF"
                                BorderThickness="1"
                                Visibility="Collapsed">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <FontIcon Grid.Column="0"
                                          Glyph="&#xE706;"
                                          FontSize="16"
                                          Foreground="#FFFFFF"
                                          Margin="0,0,10,0"
                                          VerticalAlignment="Center"/>
                                <Slider x:Name="PanelBrightnessSlider"
                                        Grid.Column="1"
                                        Style="{StaticResource ModernSliderStyle}"
                                        Minimum="0"
                                        Maximum="100"
                                        StepFrequency="1"
                                        VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- Dynamic Tiles Container - tiles generated in code-behind -->
                        <StackPanel x:Name="QuickSettingsTilesContainer"/>

                        <ctk:SettingsExpander Margin="0,12,0,0">
                            <ctk:SettingsExpander.HeaderIcon><FontIcon Glyph="&#xEA5F;"/></ctk:SettingsExpander.HeaderIcon>
                            <ctk:SettingsExpander.Header>
                                <TextBlock x:Uid="S_LosslessScaling" Text="Lossless Scaling"/>
                            </ctk:SettingsExpander.Header>
                            <ctk:SettingsExpander.Description>
                                <TextBlock x:Uid="LosslessProfilesStatus" x:Name="LosslessProfilesStatus" Text="Load profiles to edit scaling settings." TextWrapping="Wrap"/>
                            </ctk:SettingsExpander.Description>
                            <Button x:Uid="S_ToggleScaling" Content="Toggle scaling" Click="ToggleLosslessScaling_Click" />
                            <ctk:SettingsExpander.ItemsHeader>
                                <StackPanel Spacing="8" Padding="16,12,16,12">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button x:Uid="S_OpenApp" Content="Open app" Click="OpenLosslessApp_Click" />
                                        <Button x:Uid="LoadLosslessProfilesButton" x:Name="LoadLosslessProfilesButton" Content="Load profiles" Click="LoadLosslessProfiles_Click" />
                                    </StackPanel>
                                    <ComboBox x:Uid="LosslessProfileSelector" x:Name="LosslessProfileSelector" Header="Profile" HorizontalAlignment="Stretch"
                                              Visibility="Collapsed" SelectionChanged="LosslessProfileSelector_SelectionChanged" />
                                    <StackPanel x:Name="LosslessProfileFields" Spacing="8"/>
                                    <Button x:Uid="SaveLosslessProfileButton" x:Name="SaveLosslessProfileButton" Content="Save profile" Visibility="Collapsed"
                                            Click="SaveLosslessProfile_Click" />
                                </StackPanel>
                            </ctk:SettingsExpander.ItemsHeader>
                        </ctk:SettingsExpander>

                        <!-- Customize Button -->
                        <Button x:Uid="QuickSettingsCustomizeButton" x:Name="QuickSettingsCustomizeButton"
                                Content="Customize"
                                HorizontalAlignment="Stretch"
                                Margin="0,16,0,0"
                                Style="{StaticResource StandaloneButtonStyle}"
                                Click="QuickSettingsCustomize_Click" />

                        <!-- Customization Panel (hidden by default) -->
                        <ctk:SettingsExpander x:Name="QuickSettingsCustomizePanel"
                                Visibility="Collapsed"
                                Margin="0,8,0,0" IsExpanded="True">
                            <ctk:SettingsExpander.HeaderIcon><FontIcon Glyph="&#xE713;"/></ctk:SettingsExpander.HeaderIcon>
                            <ctk:SettingsExpander.Header>
                                <TextBlock x:Uid="S_CustomizeTiles" Text="Customize Tiles" />
                            </ctk:SettingsExpander.Header>
                            <ctk:SettingsExpander.Description>
                                <TextBlock x:Uid="S_TapTileToSelectTap" Text="Tap tile to select, tap another to swap. Tap same tile to toggle visibility."
                                           TextWrapping="Wrap" />
                            </ctk:SettingsExpander.Description>
                            <ctk:SettingsExpander.Items>
                                <ctk:SettingsCard><ctk:SettingsCard.Header><TextBlock TextWrapping="Wrap" x:Uid="S_Columns" Text="Columns:" /></ctk:SettingsCard.Header><StackPanel Orientation="Horizontal" Spacing="8"><Button x:Name="Column3Button" Content="3" MinWidth="40" Click="ColumnCount3_Click"/><Button x:Name="Column4Button" Content="4" MinWidth="40" Click="ColumnCount4_Click"/><Button x:Name="Column5Button" Content="5" MinWidth="40" Click="ColumnCount5_Click"/></StackPanel></ctk:SettingsCard>
                                <ctk:SettingsCard x:Uid="S_ShowMetricsRow" Header="Show Metrics Row" Description="Select up to 6 metrics below" Tapped="ToggleRow_Tapped">
                                    <ctk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE9D2;"/></ctk:SettingsCard.HeaderIcon>
                                    <ToggleSwitch x:Name="QuickMetricsToggle"
                                    OffContent=""
                                    OnContent=""
                                    Toggled="QuickMetricsToggle_Toggled"/>
                                </ctk:SettingsCard>
                                <ctk:SettingsCard x:Uid="S_ShowBrightnessSlider" Header="Show Brightness Slider" Description="Built-in screen brightness" Tapped="ToggleRow_Tapped">
                                    <ctk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE706;"/></ctk:SettingsCard.HeaderIcon>
                                    <ToggleSwitch x:Name="PanelBrightnessToggle"
                                    OffContent=""
                                    OnContent=""
                                    Toggled="PanelBrightnessToggle_Toggled"/>
                                </ctk:SettingsCard>
                                <ctk:SettingsCard x:Name="MetricsSelectionPanel" Visibility="Collapsed" ContentAlignment="Vertical" HorizontalContentAlignment="Stretch"><Border Background="#1A1A2E" CornerRadius="4" Padding="10"> <StackPanel> <TextBlock x:Uid="S_SelectMetricsGroupedIntoBattery" Text="Select Metrics (grouped into Battery, CPU, GPU and Memory cells)" TextWrapping="Wrap" Foreground="#B9C0CC" FontSize="12" Margin="0,0,0,8" /> <Grid> <Grid.ColumnDefinitions> <ColumnDefinition Width="*"/> <ColumnDefinition Width="*"/> </Grid.ColumnDefinitions> <Grid.RowDefinitions> <RowDefinition Height="Auto"/> <RowDefinition Height="Auto"/> <RowDefinition Height="Auto"/> <RowDefinition Height="Auto"/> <RowDefinition Height="Auto"/> <RowDefinition Height="Auto"/> </Grid.RowDefinitions> <!-- Row 0 --> <CheckBox x:Uid="MetricCheck_BatteryDrain" x:Name="MetricCheck_BatteryDrain" Content="Battery Drain" Grid.Row="0" Grid.Column="0" Foreground="White" FontSize="13" Margin="0,2" Checked="MetricCheckBox_Changed" Unchecked="MetricCheckBox_Changed" /> <CheckBox x:Uid="MetricCheck_BatteryLevel" x:Name="MetricCheck_BatteryLevel" Content="Battery Level" Grid.Row="0" Grid.Column="1" Foreground="White" FontSize="13" Margin="0,2" Checked="MetricCheckBox_Changed" Unchecked="MetricCheckBox_Changed" /> <!-- Row 1 --> <CheckBox x:Uid="MetricCheck_CPUUsage" x:Name="MetricCheck_CPUUsage" Content="CPU Usage" Grid.Row="1" Grid.Column="0" Foreground="White" FontSize="13" Margin="0,2" Checked="MetricCheckBox_Changed" Unchecked="MetricCheckBox_Changed" /> <CheckBox x:Uid="MetricCheck_CPUTemp" x:Name="MetricCheck_CPUTemp" Content="CPU Temp" Grid.Row="1" Grid.Column="1" Foreground="White" FontSize="13" Margin="0,2" Checked="MetricCheckBox_Changed" Unchecked="MetricCheckBox_Changed" /> <!-- Row 2 --> <CheckBox x:Uid="MetricCheck_CPUWattage" x:Name="MetricCheck_CPUWattage" Content="CPU Wattage" Grid.Row="2" Grid.Column="0" Foreground="White" FontSize="13" Margin="0,2" Checked="MetricCheckBox_Changed" Unchecked="MetricCheckBox_Changed" /> <CheckBox x:Uid="MetricCheck_GPUUsage" x:Name="MetricCheck_GPUUsage" Content="GPU Usage" Grid.Row="2" Grid.Column="1" Foreground="White" FontSize="13" Margin="0,2" Checked="MetricCheckBox_Changed" Unchecked="MetricCheckBox_Changed" /> <!-- Row 3 --> <CheckBox x:Uid="MetricCheck_GPUTemp" x:Name="MetricCheck_GPUTemp" Content="GPU Temp" Grid.Row="3" Grid.Column="0" Foreground="White" FontSize="13" Margin="0,2" Checked="MetricCheckBox_Changed" Unchecked="MetricCheckBox_Changed" /> <CheckBox x:Uid="MetricCheck_GPUWattage" x:Name="MetricCheck_GPUWattage" Content="GPU Wattage" Grid.Row="3" Grid.Column="1" Foreground="White" FontSize="13" Margin="0,2" Checked="MetricCheckBox_Changed" Unchecked="MetricCheckBox_Changed" /> <!-- Row 4 --> <CheckBox x:Uid="MetricCheck_MemoryUsage" x:Name="MetricCheck_MemoryUsage" Content="Memory Usage" Grid.Row="4" Grid.Column="0" Foreground="White" FontSize="13" Margin="0,2" Checked="MetricCheckBox_Changed" Unchecked="MetricCheckBox_Changed" /> <CheckBox x:Uid="MetricCheck_TimeRemaining" x:Name="MetricCheck_TimeRemaining" Content="Time Remaining" Grid.Row="4" Grid.Column="1" Foreground="White" FontSize="13" Margin="0,2" Checked="MetricCheckBox_Changed" Unchecked="MetricCheckBox_Changed" /> <!-- Row 5 --> <CheckBox x:Uid="MetricCheck_VRAMUsage" x:Name="MetricCheck_VRAMUsage" Content="VRAM Used" Grid.Row="5" Grid.Column="0" Foreground="White" FontSize="13" Margin="0,2" Checked="MetricCheckBox_Changed" Unchecked="MetricCheckBox_Changed" /> </Grid> <TextBlock x:Uid="MetricsSelectionCount" x:Name="MetricsSelectionCount" Text="0 selected" Foreground="#B9C0CC" FontSize="12" Margin="0,6,0,0" HorizontalAlignment="Right" /> <!-- Reorder Section --> <Border x:Name="MetricsReorderSection" Background="#1A1A2E" CornerRadius="6" Padding="8" Margin="0,10,0,0" Visibility="Collapsed"> <StackPanel> <TextBlock x:Uid="S_ReorderDragOrUseArrows" Text="Reorder (drag or use arrows)" Foreground="#B9C0CC" FontSize="12" Margin="0,0,0,6" /> <StackPanel x:Name="MetricsReorderList" Spacing="4"/> </StackPanel> </Border> </StackPanel> </Border></ctk:SettingsCard>
                                <ctk:SettingsCard ContentAlignment="Vertical" HorizontalContentAlignment="Stretch"><StackPanel x:Name="TileSortableGrid"/></ctk:SettingsCard>
                                <ctk:SettingsCard x:Name="SelectedTileIndicator" Visibility="Collapsed" ContentAlignment="Vertical" HorizontalContentAlignment="Stretch"><Border Background="#1A2530" CornerRadius="4" Padding="8"> <Grid> <Grid.ColumnDefinitions> <ColumnDefinition Width="*"/> <ColumnDefinition Width="Auto"/> </Grid.ColumnDefinitions> <TextBlock x:Name="SelectedTileText" Foreground="#00C8FF" FontSize="13" TextWrapping="Wrap" VerticalAlignment="Center"/> <Button x:Name="DeleteSelectedTileButton" Grid.Column="1" Visibility="Collapsed" Background="#662020" Foreground="White" Margin="8,0,0,0" Padding="12,6" Click="DeleteSelectedTile_Click"> <StackPanel Orientation="Horizontal"> <FontIcon Glyph="&#xE74D;" FontSize="14" Margin="0,0,6,0"/> <TextBlock x:Uid="S_Delete" Text="Delete" /> </StackPanel> </Button> </Grid> </Border></ctk:SettingsCard>
                                <ctk:SettingsCard ContentAlignment="Vertical" HorizontalContentAlignment="Stretch"><ctk:SettingsCard.Header><TextBlock TextWrapping="Wrap" x:Uid="S_AddCustomShortcut" Text="Add Custom Shortcut" /></ctk:SettingsCard.Header><TextBox x:Uid="CustomShortcutNameBox" x:Name="CustomShortcutNameBox" PlaceholderText="Tile Name" /></ctk:SettingsCard>
                                <ctk:SettingsCard ContentAlignment="Vertical" HorizontalContentAlignment="Stretch"><StackPanel Orientation="Horizontal"> <ItemsControl x:Name="CustomShortcutKeyTags"> <ItemsControl.ItemsPanel> <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate> </ItemsControl.ItemsPanel> </ItemsControl> <ComboBox x:Name="CustomShortcutKeyComboBox" Width="90" Style="{StaticResource ModernComboBoxStyle}" SelectedIndex="0" SelectionChanged="CustomShortcutKey_SelectionChanged"> <x:String>+ Key</x:String><x:String>A</x:String><x:String>B</x:String><x:String>C</x:String><x:String>D</x:String><x:String>E</x:String><x:String>F</x:String><x:String>G</x:String><x:String>H</x:String><x:String>I</x:String><x:String>J</x:String><x:String>K</x:String><x:String>L</x:String><x:String>M</x:String><x:String>N</x:String><x:String>O</x:String><x:String>P</x:String><x:String>Q</x:String><x:String>R</x:String><x:String>S</x:String><x:String>T</x:String><x:String>U</x:String><x:String>V</x:String><x:String>W</x:String><x:String>X</x:String><x:String>Y</x:String><x:String>Z</x:String><x:String>0</x:String><x:String>1</x:String><x:String>2</x:String><x:String>3</x:String><x:String>4</x:String><x:String>5</x:String><x:String>6</x:String><x:String>7</x:String><x:String>8</x:String><x:String>9</x:String><x:String>F1</x:String><x:String>F2</x:String><x:String>F3</x:String><x:String>F4</x:String><x:String>F5</x:String><x:String>F6</x:String><x:String>F7</x:String><x:String>F8</x:String><x:String>F9</x:String><x:String>F10</x:String><x:String>F11</x:String><x:String>F12</x:String><x:String>Enter</x:String><x:String>Esc</x:String><x:String>Space</x:String><x:String>Tab</x:String><x:String>Backspace</x:String><x:String>Up</x:String><x:String>Down</x:String><x:String>Left</x:String><x:String>Right</x:String><x:String>LCtrl</x:String><x:String>LShift</x:String><x:String>LAlt</x:String><x:String>LWin</x:String><x:String>RCtrl</x:String><x:String>RShift</x:String><x:String>RAlt</x:String><x:String>RWin</x:String><x:String>Home</x:String><x:String>End</x:String><x:String>PgUp</x:String><x:String>PgDn</x:String><x:String>Insert</x:String><x:String>Delete</x:String><x:String>PrintScr</x:String><x:String>Pause</x:String><x:String>VolUp</x:String><x:String>VolDown</x:String><x:String>VolMute</x:String><x:String>[</x:String><x:String>]</x:String> </ComboBox> </StackPanel></ctk:SettingsCard>
                                <ctk:SettingsCard ContentAlignment="Left"><Button x:Uid="AddCustomShortcutButton" x:Name="AddCustomShortcutButton" Content="Add Shortcut Tile" Style="{StaticResource StandaloneButtonStyle}" Click="AddCustomShortcut_Click" /></ctk:SettingsCard>
                                <ctk:SettingsCard ContentAlignment="Left"><Button x:Uid="S_Done" Content="Done" Style="{StaticResource StandaloneButtonStyle}" Click="QuickSettingsCustomizeDone_Click" /></ctk:SettingsCard>
                            </ctk:SettingsExpander.Items>
                        </ctk:SettingsExpander>

                    </StackPanel>
                </ScrollViewer>

                <!-- PERFORMANCE TAB -->
                <ScrollViewer x:Name="PerformanceScrollViewer" VerticalScrollBarVisibility="Auto" Visibility="Collapsed"
                              BringIntoViewOnFocusChange="True">
                    <StackPanel Padding="16,0,16,16" Spacing="4">

                        <!-- PROFILE -->
                        <TextBlock x:Uid="S_SectionProfile" Text="Profile" Style="{StaticResource SettingsSectionTitleStyle}"/>
                        <ctk:SettingsCard x:Name="ActiveProfileCard">
                            <ctk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE77B;"/></ctk:SettingsCard.HeaderIcon>
                            <ctk:SettingsCard.Header>
                                <TextBlock x:Uid="S_CurrentProfile" Text="Current Profile"/>
                            </ctk:SettingsCard.Header>
                            <ctk:SettingsCard.Description>
                                <!-- Long names marquee-scroll (UpdateMarqueeScrollAnimation). -->
                                <Canvas x:Name="ActiveProfileTextCanvas" Height="22" Width="300" HorizontalAlignment="Left">
                                    <Canvas.Clip>
                                        <RectangleGeometry Rect="0,0,300,22"/>
                                    </Canvas.Clip>
                                    <TextBlock x:Uid="ActiveProfileText" x:Name="ActiveProfileText"
                                               Text="Global Settings"
                                               FontSize="16"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource SystemAccentBrush}">
                                        <TextBlock.RenderTransform>
                                            <TranslateTransform x:Name="ActiveProfileTextTransform"/>
                                        </TextBlock.RenderTransform>
                                    </TextBlock>
                                </Canvas>
                            </ctk:SettingsCard.Description>
                        </ctk:SettingsCard>
                        <ctk:SettingsCard Tapped="ToggleRow_Tapped">
                            <ctk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE7FC;"/></ctk:SettingsCard.HeaderIcon>
                            <ctk:SettingsCard.Header>
                                <TextBlock x:Uid="S_UsePerGameProfile" Text="Use per-game profile"/>
                            </ctk:SettingsCard.Header>
                            <ctk:SettingsCard.Description>
                                <!-- Detected game name; long window titles marquee-scroll. -->
                                <Canvas x:Name="DetectedGameTextCanvas" Height="16" MaxWidth="200" HorizontalAlignment="Left">
                                    <Canvas.Clip>
                                        <RectangleGeometry Rect="0,0,200,16"/>
                                    </Canvas.Clip>
                                    <TextBlock x:Uid="DetectedGameText" x:Name="DetectedGameText" Text="No game detected">
                                        <TextBlock.RenderTransform>
                                            <TranslateTransform x:Name="DetectedGameTextTransform"/>
                                        </TextBlock.RenderTransform>
                                    </TextBlock>
                                </Canvas>
                            </ctk:SettingsCard.Description>
                            <ToggleSwitch x:Name="PerGameProfileToggle"
                                          Style="{StaticResource ModernToggleStyle}"
                                          IsEnabled="False"/>
                        </ctk:SettingsCard>
                        <ctk:SettingsCard Tapped="ToggleRow_Tapped">
                            <ctk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE83F;"/></ctk:SettingsCard.HeaderIcon>
                            <ctk:SettingsCard.Header>
                                <TextBlock x:Uid="S_PowerSourceProfile_Title" Text="Power Source Profile"/>
                            </ctk:SettingsCard.Header>
                            <ctk:SettingsCard.Description>
                                <StackPanel>
                                    <TextBlock x:Uid="S_PowerSourceProfile_Desc" Text="Separate profiles for AC (plugged in) and DC (battery)" TextWrapping="Wrap"/>
                                    <TextBlock x:Uid="PowerSourceProfileScopeText" x:Name="PowerSourceProfileScopeText"
                                               Margin="0,4,0,0"
                                               TextWrapping="Wrap"
                                               Text="Scope: Global profiles. AC/DC split: Off. Enable Per-Game Profile to set this per game." />
                                </StackPanel>
                            </ctk:SettingsCard.Description>
                            <ToggleSwitch x:Name="PowerSourceProfileToggle"
                                          Style="{StaticResource ModernToggleStyle}" Width="47"/>
                        </ctk:SettingsCard>

                        <!-- OVERLAY -->
                        <TextBlock x:Uid="S_SectionOverlay" Text="Overlay" Style="{StaticResource SettingsSectionTitleStyle}"/>
                        <ctk:SettingsCard x:Uid="S_PerformanceOverlay" Header="Performance Overlay" Description="FPS, CPU/GPU, RAM/VRAM, Battery, Time" Tapped="ToggleRow_Tapped">
                            <ctk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE9D9;"/></ctk:SettingsCard.HeaderIcon>
                            <ToggleSwitch x:Name="PerformanceOverlayToggle"
                                          Style="{StaticResource ModernToggleStyle}"
                                          Width="52"
                                          Toggled="PerformanceOverlayToggle_Toggled"
                                          XYFocusLeft="{x:Bind PerformanceNavItem}"/>
                        </ctk:SettingsCard>
                        <!-- Hidden slider for property system compatibility (OSDProperty binds to a Slider) -->
                        <Slider x:Name="PerformanceOverlaySlider"
                                Visibility="Collapsed"
                                Minimum="0" Maximum="1"
                                Value="0"
                                ValueChanged="PerformanceOverlaySlider_ValueChanged"/>
                        <ctk:SettingsCard x:Uid="PerformanceOverlayPresetComboBox" Header="Overlay preset (RTSS)">
                            <ctk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE8FD;"/></ctk:SettingsCard.HeaderIcon>
                            <ComboBox x:Name="PerformanceOverlayPresetComboBox"
                                      Style="{StaticResource ModernComboBoxStyle}" MinWidth="130"
                                      SelectedIndex="0" SelectionChanged="OSDPreset_Changed">
                                <ComboBoxItem x:Uid="S_Custom" Content="Custom" Tag="Custom" />
                                <ComboBoxItem x:Uid="S_Basic" Content="Basic" Tag="Basic" />
                                <ComboBoxItem x:Uid="S_Detailed" Content="Detailed" Tag="Detailed" />
                                <ComboBoxItem x:Uid="S_Full" Content="Full" Tag="Full" />
                                <ComboBoxItem x:Uid="S_Original" Content="Original" Tag="Original" />
                            </ComboBox>
                        </ctk:SettingsCard>
                        <ctk:SettingsExpander IsExpanded="{x:Bind FPSLimitToggle.IsOn, Mode=OneWay}">
                            <ctk:SettingsExpander.HeaderIcon><FontIcon Glyph="&#xE916;"/></ctk:SettingsExpander.HeaderIcon>
                            <ctk:SettingsExpander.Header>
                                <TextBlock x:Uid="S_FPSLimit" Text="FPS Limit"/>
                            </ctk:SettingsExpander.Header>
                            <ctk:SettingsExpander.Description>
                                <TextBlock x:Name="FPSLimitCaption" Text="" Visibility="Collapsed"/>
                            </ctk:SettingsExpander.Description>
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <TextBlock x:Name="FPSLimitValue"
                                           Text=""
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"
                                           Visibility="{x:Bind FPSLimitToggle.IsOn, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}"/>
                                <ToggleSwitch x:Name="FPSLimitToggle"
                                              Style="{StaticResource ModernToggleStyle}"
                                              IsEnabled="False" Width="52"/>
                            </StackPanel>
                            <ctk:SettingsExpander.Items>
                                <ctk:SettingsCard ContentAlignment="Vertical" HorizontalContentAlignment="Stretch"><Slider x:Name="FPSLimitSlider" Style="{StaticResource ModernSliderStyle}" Minimum="15" Maximum="144" StepFrequency="1" TickFrequency="15" TickPlacement="Outside" SnapsTo="StepValues"/></ctk:SettingsCard>
                            </ctk:SettingsExpander.Items>
                        </ctk:SettingsExpander>

                        <!-- POWER -->
                        <TextBlock x:Uid="S_SectionPower" Text="Power" Style="{StaticResource SettingsSectionTitleStyle}"/>
                        <!-- TDP Mode (all devices). Named *ComboBox for code-behind compatibility;
                             Segmented is a Selector too. Focus moves with the D-pad, A applies. -->
                        <ctk:SettingsCard x:Name="TDPModeCard" ContentAlignment="Vertical" HorizontalContentAlignment="Stretch">
                            <ctk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE945;"/></ctk:SettingsCard.HeaderIcon>
                            <ctk:SettingsCard.Header>
                                <TextBlock x:Uid="S_TDPMode" Text="TDP Mode"/>
                            </ctk:SettingsCard.Header>
                            <ctk:SettingsCard.Description>
                                <TextBlock x:Uid="S_ControlsPowerAndThermalProfile" Text="Controls power and thermal profile" TextWrapping="Wrap"/>
                            </ctk:SettingsCard.Description>
                            <ctk:Segmented x:Name="TDPModeComboBox"
                                           HorizontalAlignment="Stretch"
                                           SingleSelectionFollowsFocus="False"
                                           SelectionChanged="TDPModeComboBox_SelectionChanged">
                                <ctk:SegmentedItem x:Uid="S_Quiet" Content="Quiet" Tag="1" />
                                <ctk:SegmentedItem x:Uid="S_Balanced" Content="Balanced" Tag="2" IsSelected="True" />
                                <ctk:SegmentedItem x:Uid="S_Performance" Content="Performance" Tag="3" />
                                <ctk:SegmentedItem x:Uid="S_Custom" Content="Custom" Tag="255" />
                            </ctk:Segmented>
                        </ctk:SettingsCard>

                        <!-- Custom Power Limits (Legion only, Custom mode): TDP (SPL), SPPT and FPPT
                             boosts through Lenovo WMI, with the live hardware readout. -->
                        <ctk:SettingsExpander x:Name="CustomTDPCard" IsExpanded="True" Visibility="Collapsed">
                            <ctk:SettingsExpander.HeaderIcon><FontIcon Glyph="&#xE9E9;"/></ctk:SettingsExpander.HeaderIcon>
                            <ctk:SettingsExpander.Header>
                                <TextBlock x:Uid="S_CustomPowerLimits" Text="Custom Power Limits"/>
                            </ctk:SettingsExpander.Header>
                            <ctk:SettingsExpander.Description>
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock x:Uid="CurrentTDPText" x:Name="CurrentTDPText" Text="Limits:" />
                                    <TextBlock x:Name="CurrentTDPValueText" Text="-- W" />
                                </StackPanel>
                            </ctk:SettingsExpander.Description>
                            <ctk:SettingsExpander.Items>
                                <ctk:SettingsCard ContentAlignment="Vertical" HorizontalContentAlignment="Stretch">
                                    <ctk:SettingsCard.Header>
                                        <TextBlock x:Uid="S_TDP" Text="TDP"/>
                                    </ctk:SettingsCard.Header>
                                    <ctk:SettingsCard.Description>
                                        <TextBlock x:Name="CustomTDPSlowValue" Text="-- W"/>
                                    </ctk:SettingsCard.Description>
                                    <Slider x:Name="CustomTDPSlowSlider"
                                            Style="{StaticResource ModernSliderStyle}"
                                            Minimum="5" Maximum="50"
                                            TickFrequency="1"
                                            SnapsTo="Ticks"
                                            Value="15"
                                            ValueChanged="CustomTDPSlowSlider_ValueChanged"/>
                                </ctk:SettingsCard>
                                <ctk:SettingsCard ContentAlignment="Vertical" HorizontalContentAlignment="Stretch">
                                    <ctk:SettingsCard.Header>
                                        <TextBlock x:Uid="S_SPPTBoost" Text="SPPT Boost"/>
                                    </ctk:SettingsCard.Header>
                                    <ctk:SettingsCard.Description>
                                        <TextBlock x:Name="CustomTDPFastValue" Text="-- W"/>
                                    </ctk:SettingsCard.Description>
                                    <Slider x:Name="CustomTDPFastSlider"
                                            Style="{StaticResource ModernSliderStyle}"
                                            Minimum="0" Maximum="10"
                                            TickFrequency="1"
                                            SnapsTo="Ticks"
                                            Value="2"
                                            ValueChanged="CustomTDPFastSlider_ValueChanged"/>
                                </ctk:SettingsCard>
                                <ctk:SettingsCard ContentAlignment="Vertical" HorizontalContentAlignment="Stretch">
                                    <ctk:SettingsCard.Header>
                                        <TextBlock x:Uid="S_FPPTBoost" Text="FPPT Boost"/>
                                    </ctk:SettingsCard.Header>
                                    <ctk:SettingsCard.Description>
                                        <TextBlock x:Name="CustomTDPPeakValue" Text="-- W"/>
                                    </ctk:SettingsCard.Description>
                                    <Slider x:Name="CustomTDPPeakSlider"
                                            Style="{StaticResource ModernSliderStyle}"
                                            Minimum="0" Maximum="15"
                                            TickFrequency="1"
                                            SnapsTo="Ticks"
                                            Value="5"
                                            ValueChanged="CustomTDPPeakSlider_ValueChanged"/>
                                </ctk:SettingsCard>
                            </ctk:SettingsExpander.Items>
                        </ctk:SettingsExpander>

                        <!-- AutoTDP (Legion only): adjusts TDP to hit a target FPS. Enabling it forces
                             TDP Mode to Custom and locks the mode selector until disabled. -->
                        <ctk:SettingsExpander x:Name="AutoTDPCard" Visibility="Collapsed" IsExpanded="{x:Bind AutoTDPToggle.IsOn, Mode=OneWay}">
                            <ctk:SettingsExpander.HeaderIcon><FontIcon Glyph="&#xE9F5;"/></ctk:SettingsExpander.HeaderIcon>
                            <ctk:SettingsExpander.Header>
                                <TextBlock x:Uid="S_AutoTDP_Title" Text="AutoTDP"/>
                            </ctk:SettingsExpander.Header>
                            <ctk:SettingsExpander.Description>
                                <TextBlock x:Uid="S_AutoTDP_Desc" Text="Adjusts TDP live to hit a target FPS" TextWrapping="Wrap"/>
                            </ctk:SettingsExpander.Description>
                            <ToggleSwitch x:Name="AutoTDPToggle"
                                          Style="{StaticResource ModernToggleStyle}"
                                          Width="52"
                                          Toggled="AutoTDPToggle_Toggled"/>
                            <ctk:SettingsExpander.Items>
                                <ctk:SettingsCard ContentAlignment="Vertical" HorizontalContentAlignment="Stretch">
                                    <ctk:SettingsCard.Header>
                                        <TextBlock x:Uid="S_TargetFPS" Text="Target FPS"/>
                                    </ctk:SettingsCard.Header>
                                    <ctk:SettingsCard.Description>
                                        <TextBlock x:Uid="AutoTDPTargetFPSValue" x:Name="AutoTDPTargetFPSValue" Text="60 FPS"/>
                                    </ctk:SettingsCard.Description>
                                    <Slider x:Name="AutoTDPTargetFPSSlider"
                                            Style="{StaticResource ModernSliderStyle}"
                                            Minimum="30" Maximum="144"
                                            StepFrequency="5" TickFrequency="15" TickPlacement="Outside" SnapsTo="StepValues"
                                            Value="60"
                                            ValueChanged="AutoTDPTargetFPSSlider_ValueChanged"/>
                                </ctk:SettingsCard>
                                <ctk:SettingsCard>
                                    <ctk:SettingsCard.Header>
                                        <TextBlock x:Uid="S_CurrentFPS" Text="Current FPS"/>
                                    </ctk:SettingsCard.Header>
                                    <TextBlock x:Uid="AutoTDPCurrentFPSValue" x:Name="AutoTDPCurrentFPSValue" Text="-- FPS" FontWeight="SemiBold"/>
                                </ctk:SettingsCard>
                                <ctk:SettingsCard ContentAlignment="Vertical" HorizontalContentAlignment="Stretch">
                                    <ctk:SettingsCard.Header>
                                        <TextBlock x:Uid="S_MinTDP" Text="Min TDP"/>
                                    </ctk:SettingsCard.Header>
                                    <ctk:SettingsCard.Description>
                                        <TextBlock x:Name="AutoTDPMinValue" Text="8W"/>
                                    </ctk:SettingsCard.Description>
                                    <Slider x:Name="AutoTDPMinSlider"
                                            Style="{StaticResource ModernSliderStyle}"
                                            Minimum="4" Maximum="35" StepFrequency="1"
                                            Value="8"
                                            ValueChanged="AutoTDPMinSlider_ValueChanged"/>
                                </ctk:SettingsCard>
                                <ctk:SettingsCard ContentAlignment="Vertical" HorizontalContentAlignment="Stretch">
                                    <ctk:SettingsCard.Header>
                                        <TextBlock x:Uid="S_MaxTDP" Text="Max TDP"/>
                                    </ctk:SettingsCard.Header>
                                    <ctk:SettingsCard.Description>
                                        <TextBlock x:Name="AutoTDPMaxValue" Text="30W"/>
                                    </ctk:SettingsCard.Description>
                                    <Slider x:Name="AutoTDPMaxSlider"
                                            Style="{StaticResource ModernSliderStyle}"
                                            Minimum="4" Maximum="35" StepFrequency="1"
                                            Value="30"
                                            ValueChanged="AutoTDPMaxSlider_ValueChanged"/>
                                </ctk:SettingsCard>
                                <ctk:SettingsCard Tapped="ToggleRow_Tapped">
                                    <ctk:SettingsCard.Header>
                                        <TextBlock x:Uid="S_PauseWhenGameNotFocused" Text="Pause when game not focused" TextWrapping="Wrap"/>
                                    </ctk:SettingsCard.Header>
                                    <ToggleSwitch x:Name="AutoTDPPauseWhenUnfocusedToggle"
                                                  Style="{StaticResource ModernToggleStyle}"
                                                  Width="52"
                                                  IsOn="True"
                                                  Toggled="AutoTDPPauseWhenUnfocusedToggle_Toggled"/>
                                </ctk:SettingsCard>
                                <ctk:SettingsCard Tapped="ToggleRow_Tapped">
                                    <ctk:SettingsCard.Header>
                                        <TextBlock x:Uid="S_FastResponse" Text="Fast response" TextWrapping="Wrap"/>
                                    </ctk:SettingsCard.Header>
                                    <ctk:SettingsCard.Description>
                                        <TextBlock x:Uid="S_JumpToTheEstimatedWattage" Text="Jump to the estimated wattage when FPS is far off target, then fine-tune" TextWrapping="Wrap"/>
                                    </ctk:SettingsCard.Description>
                                    <ToggleSwitch x:Name="AutoTDPFastResponseToggle"
                                                  Style="{StaticResource ModernToggleStyle}"
                                                  Width="52"
                                                  IsOn="True"/>
                                </ctk:SettingsCard>
                            </ctk:SettingsExpander.Items>
                        </ctk:SettingsExpander>

                        <!-- OS Power Mode -->
                        <ctk:SettingsCard ContentAlignment="Vertical" HorizontalContentAlignment="Stretch">
                            <ctk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xEC4A;"/></ctk:SettingsCard.HeaderIcon>
                            <ctk:SettingsCard.Header>
                                <TextBlock x:Uid="S_OSPowerMode" Text="OS Power Mode"/>
                            </ctk:SettingsCard.Header>
                            <ctk:SettingsCard.Description>
                                <StackPanel>
                                    <TextBlock x:Uid="S_WindowsPowerSliderSetting" Text="Windows power slider setting" TextWrapping="Wrap"/>
                                    <TextBlock x:Uid="OSPowerModeValue" x:Name="OSPowerModeValue"
                                               Text="Balanced"
                                               FontWeight="SemiBold"
                                               Visibility="Collapsed" />
                                </StackPanel>
                            </ctk:SettingsCard.Description>
                            <ctk:Segmented x:Name="OSPowerModeComboBox"
                                           HorizontalAlignment="Stretch"
                                           SingleSelectionFollowsFocus="False"
                                           SelectionChanged="OSPowerModeComboBox_SelectionChanged">
                                <ctk:SegmentedItem x:Uid="S_Efficiency" Content="Efficiency" />
                                <ctk:SegmentedItem x:Uid="S_Balanced" Content="Balanced" IsSelected="True" />
                                <ctk:SegmentedItem x:Uid="S_Performance" Content="Performance" />
                            </ctk:Segmented>
                        </ctk:SettingsCard>

                        <!-- PROCESSOR -->
                        <TextBlock x:Uid="S_SectionProcessor" Text="Processor" Style="{StaticResource SettingsSectionTitleStyle}"/>
                        <ctk:SettingsExpander x:Name="CPUExtrasExpander">
                            <ctk:SettingsExpander.HeaderIcon><FontIcon Glyph="&#xEEA1;"/></ctk:SettingsExpander.HeaderIcon>
                            <ctk:SettingsExpander.Header>
                                <TextBlock x:Uid="S_CPUExtras" Text="CPU Extras"/>
                            </ctk:SettingsExpander.Header>
                            <ctk:SettingsExpander.Description>
                                <TextBlock x:Uid="S_CPUBoostEPPAndState" Text="CPU Boost, EPP, and State limits" TextWrapping="Wrap"/>
                            </ctk:SettingsExpander.Description>
                            <ctk:SettingsExpander.Items>
                                <ctk:SettingsCard x:Uid="S_CPUBoost" Header="CPU Boost" Description="Higher boost clocks" Tapped="ToggleRow_Tapped">
                                    <ToggleSwitch x:Name="CPUBoostToggle"
                                                  Style="{StaticResource ModernToggleStyle}"
                                                  IsEnabled="False"/>
                                </ctk:SettingsCard>
                                <ctk:SettingsCard ContentAlignment="Vertical" HorizontalContentAlignment="Stretch">
                                    <ctk:SettingsCard.Header>
                                        <TextBlock x:Uid="S_CPUEPP" Text="CPU EPP"/>
                                    </ctk:SettingsCard.Header>
                                    <ctk:SettingsCard.Description>
                                        <TextBlock x:Name="CPUEPPValueText" Text="{Binding ElementName=CPUEPPSlider, Path=Value}"/>
                                    </ctk:SettingsCard.Description>
                                    <StackPanel>
                                        <Slider x:Name="CPUEPPSlider"
                                                Style="{StaticResource ModernSliderStyle}"
                                                Minimum="0" Maximum="100"
                                                TickFrequency="10"
                                                SnapsTo="Ticks"
                                                TickPlacement="BottomRight"
                                                IsEnabled="False"/>
                                        <Grid>
                                            <TextBlock x:Uid="S_0PrioritizeCPU" Text="0 = Prioritize CPU" FontSize="12" Foreground="#B9C0CC" />
                                            <TextBlock x:Uid="S_100PrioritizeGPU" Text="100 = Prioritize GPU" FontSize="12" Foreground="#B9C0CC" HorizontalAlignment="Right" />
                                        </Grid>
                                    </StackPanel>
                                </ctk:SettingsCard>
                                <ctk:SettingsCard ContentAlignment="Vertical" HorizontalContentAlignment="Stretch">
                                    <ctk:SettingsCard.Header>
                                        <TextBlock x:Uid="S_CPUState" Text="CPU State"/>
                                    </ctk:SettingsCard.Header>
                                    <ctk:SettingsCard.Description>
                                        <TextBlock x:Uid="S_ProcessorPerformanceLimits" Text="Processor performance limits"/>
                                    </ctk:SettingsCard.Description>
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <ComboBox x:Uid="S_MinCombo" x:Name="MinCPUStateComboBox" Header="Min %"
                                                  Style="{StaticResource ModernComboBoxStyle}"
                                                  SelectionChanged="MinCPUStateComboBox_SelectionChanged"
                                                  IsEnabled="False"/>
                                        <ComboBox x:Uid="S_MaxCombo" x:Name="MaxCPUStateComboBox" Header="Max %" Grid.Column="1"
                                                  Style="{StaticResource ModernComboBoxStyle}"
                                                  SelectionChanged="MaxCPUStateComboBox_SelectionChanged"
                                                  IsEnabled="False"/>
                                    </Grid>
                                </ctk:SettingsCard>
                            </ctk:SettingsExpander.Items>
                        </ctk:SettingsExpander>

                    </StackPanel>
                </ScrollViewer>

                <!-- GAME TAB -->
                <ScrollViewer x:Name="GameScrollViewer" VerticalScrollBarVisibility="Auto" Visibility="Collapsed"
                              BringIntoViewOnFocusChange="True">
                    <StackPanel Padding="16,0,16,16" Spacing="4">

                        <!-- Current Game Card -->
                        <TextBlock x:Uid="S_CurrentGame" Text="Current Game" Style="{StaticResource SettingsSectionTitleStyle}" />
                        <!-- The game icon (helper/Steam) is the header icon; a gamepad glyph stands in until one loads. -->
                        <ctk:SettingsCard x:Name="CurrentGameCard">
                            <ctk:SettingsCard.HeaderIcon>
                                <muxc:ImageIcon x:Name="CurrentGameIcon" Visibility="Collapsed"/>
                            </ctk:SettingsCard.HeaderIcon>
                            <ctk:SettingsCard.Header>
                                <TextBlock x:Uid="RunningGameText" x:Name="RunningGameText" Text="No game detected" FontWeight="SemiBold" TextWrapping="Wrap" />
                            </ctk:SettingsCard.Header>
                            <ctk:SettingsCard.Description>
                                <TextBlock x:Name="CurrentGameProfileStatus" Text="" TextWrapping="Wrap" Visibility="Collapsed"/>
                            </ctk:SettingsCard.Description>
                        </ctk:SettingsCard>

                        <!-- Game Detection Card -->
                        <ctk:SettingsExpander x:Name="ProfileDetectionExpander">
                            <ctk:SettingsExpander.HeaderIcon><FontIcon Glyph="&#xE721;"/></ctk:SettingsExpander.HeaderIcon>
                            <ctk:SettingsExpander.Header>
                                <TextBlock x:Uid="S_GameDetection" Text="Game Detection" />
                            </ctk:SettingsExpander.Header>
                            <ctk:SettingsExpander.Description>
                                <TextBlock x:Uid="S_GamesWithProfilesAlwaysDetect" Text="Games with profiles always detect regardless of settings" />
                            </ctk:SettingsExpander.Description>
                            <ctk:SettingsExpander.Items>
                                <ctk:SettingsCard x:Uid="S_PreferExecutable" Header="Prefer executable" Description="Use .exe name, fall back to window title if unavailable" Tapped="ToggleRow_Tapped">
                                        <ctk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE721;"/></ctk:SettingsCard.HeaderIcon>
                                        <ToggleSwitch x:Name="ProfileMatchByExeToggle"
                                        Style="{StaticResource ModernToggleStyle}"/>
                                    </ctk:SettingsCard>
                                <ctk:SettingsCard x:Uid="S_GamesOnly" Header="Games only" Description="Detect apps with FPS (RTSS) or added to Xbox Game Bar" Tapped="ToggleRow_Tapped">
                                        <ctk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE721;"/></ctk:SettingsCard.HeaderIcon>
                                        <ToggleSwitch x:Name="ProfileGamesOnlyToggle"
                                        Style="{StaticResource ModernToggleStyle}"
                                        IsOn="True"/>
                                    </ctk:SettingsCard>
                            </ctk:SettingsExpander.Items>
                        </ctk:SettingsExpander>

                        <!-- Profile Settings Card (Collapsible) -->
                        <ctk:SettingsExpander x:Name="ProfileSettingsExpander">
                            <ctk:SettingsExpander.HeaderIcon><FontIcon Glyph="&#xE713;"/></ctk:SettingsExpander.HeaderIcon>
                            <ctk:SettingsExpander.Header>
                                <TextBlock x:Uid="S_ProfileSettings" Text="Profile Settings" />
                            </ctk:SettingsExpander.Header>
                            <ctk:SettingsExpander.Description>
                                <TextBlock x:Uid="S_ChooseWhichSettingsAreSaved" Text="Choose which settings are saved in profiles" TextWrapping="Wrap" />
                            </ctk:SettingsExpander.Description>
                            <ctk:SettingsExpander.Items>
                                <ctk:SettingsCard ContentAlignment="Left"><CheckBox x:Uid="ProfileSaveTDPCheckBox" x:Name="ProfileSaveTDPCheckBox" Content="TDP Power Limit" IsChecked="True" Foreground="#FFFFFF" Style="{StaticResource FocusableCheckBoxStyle}" Checked="ProfileSettingsCheckBox_Changed" Unchecked="ProfileSettingsCheckBox_Changed" /></ctk:SettingsCard>
                                <ctk:SettingsCard ContentAlignment="Left"><StackPanel><CheckBox x:Uid="ProfileSaveCPUBoostCheckBox" x:Name="ProfileSaveCPUBoostCheckBox" Content="CPU Boost" IsChecked="True" Foreground="#FFFFFF" Style="{StaticResource FocusableCheckBoxStyle}" Checked="ProfileSettingsCheckBox_Changed" Unchecked="ProfileSettingsCheckBox_Changed" /><TextBlock TextWrapping="Wrap" x:Uid="S_IncludesTDPBoostOnOff" Text="Includes TDP Boost (on/off, Fast +W, Peak +W)" Margin="28,-4,0,0" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /></StackPanel></ctk:SettingsCard>
                                <ctk:SettingsCard ContentAlignment="Left"><CheckBox x:Uid="ProfileSaveCPUEPPCheckBox" x:Name="ProfileSaveCPUEPPCheckBox" Content="CPU EPP" IsChecked="True" Foreground="#FFFFFF" Style="{StaticResource FocusableCheckBoxStyle}" Checked="ProfileSettingsCheckBox_Changed" Unchecked="ProfileSettingsCheckBox_Changed" /></ctk:SettingsCard>
                                <ctk:SettingsCard ContentAlignment="Left"><CheckBox x:Uid="ProfileSaveCPUStateCheckBox" x:Name="ProfileSaveCPUStateCheckBox" Content="CPU State" IsChecked="True" Foreground="#FFFFFF" Style="{StaticResource FocusableCheckBoxStyle}" Checked="ProfileSettingsCheckBox_Changed" Unchecked="ProfileSettingsCheckBox_Changed" /></ctk:SettingsCard>
                                <ctk:SettingsCard ContentAlignment="Left"><CheckBox x:Uid="ProfileSaveFPSLimitCheckBox" x:Name="ProfileSaveFPSLimitCheckBox" Content="FPS Limit" IsChecked="True" Foreground="#FFFFFF" Style="{StaticResource FocusableCheckBoxStyle}" Checked="ProfileSettingsCheckBox_Changed" Unchecked="ProfileSettingsCheckBox_Changed" /></ctk:SettingsCard>
                                <ctk:SettingsCard ContentAlignment="Left"><CheckBox x:Uid="ProfileSaveOSPowerModeCheckBox" x:Name="ProfileSaveOSPowerModeCheckBox" Content="OS Power Mode" IsChecked="True" Foreground="#FFFFFF" Style="{StaticResource FocusableCheckBoxStyle}" Checked="ProfileSettingsCheckBox_Changed" Unchecked="ProfileSettingsCheckBox_Changed" /></ctk:SettingsCard>
                                <ctk:SettingsCard ContentAlignment="Left"><CheckBox x:Uid="ProfileSaveOverlayLevelCheckBox" x:Name="ProfileSaveOverlayLevelCheckBox" Content="Overlay Level" IsChecked="False" Foreground="#FFFFFF" Style="{StaticResource FocusableCheckBoxStyle}" Checked="ProfileSettingsCheckBox_Changed" Unchecked="ProfileSettingsCheckBox_Changed" /></ctk:SettingsCard>
                            </ctk:SettingsExpander.Items>
                        </ctk:SettingsExpander>

                        <!-- Global Profile Section -->
                        <TextBlock x:Uid="S_GlobalProfile" Text="Global Profile" Style="{StaticResource SettingsSectionTitleStyle}" />

                        <!-- Global Profile Card -->
                        <ctk:SettingsCard ContentAlignment="Vertical" HorizontalContentAlignment="Stretch">
                            <StackPanel>
                                <!-- Settings table — Win11-style info table, matching the Legion tab's
                                     Controller Information table (boxed on PageBackgroundBrush, thin
                                     separators between rows, Auto+* columns, SemiBold right-aligned values).
                                     No redundant title here — the "Global Profile" section header above
                                     this card already identifies it. -->

                                <!-- Simple Mode (Power Source Toggle OFF). Padding bottom=8 compensates
                                     for the last visible row's separator being hidden dynamically by
                                     UpdateLastVisibleSeparator (see GamingWidget.ProfileDisplay.cs) so a
                                     partially-filled profile (only some categories saved) doesn't show a
                                     stray separator flush against the box's bottom edge. -->
                                <Border x:Name="GlobalProfileSimple" Background="#2F3338" CornerRadius="6" Padding="12,2,12,8">
                                    <StackPanel>
                                        <StackPanel x:Name="GlobalProfileTDPModeRow" Visibility="Collapsed">
                                            <Grid Margin="0,8,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock x:Uid="S_TDPMode" Grid.Column="0" Text="TDP Mode" FontSize="13" Foreground="#B9C0CC" />
                                                <TextBlock x:Uid="GlobalProfileTDPModeText" Grid.Column="1" x:Name="GlobalProfileTDPModeText" Text="Balanced" FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFF" HorizontalAlignment="Right" />
                                            </Grid>
                                            <Border x:Name="GlobalProfileTDPModeSeparator" Height="1" Background="#22FFFFFF" Margin="0,8,0,0"/>
                                        </StackPanel>

                                        <StackPanel x:Name="GlobalProfileTDPRow" Visibility="Collapsed">
                                            <Grid Margin="0,8,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock x:Uid="S_TDP" Grid.Column="0" Text="TDP" FontSize="13" Foreground="#B9C0CC" />
                                                <TextBlock Grid.Column="1" x:Name="GlobalProfileTDPText" Text="15W" FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFF" HorizontalAlignment="Right"/>
                                            </Grid>
                                            <Border x:Name="GlobalProfileTDPSeparator" Height="1" Background="#22FFFFFF" Margin="0,8,0,0"/>
                                        </StackPanel>

                                        <StackPanel x:Name="GlobalProfileCPUBoostRow" Visibility="Collapsed">
                                            <Grid Margin="0,8,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock x:Uid="S_CPUBoost_2" Grid.Column="0" Text="CPU Boost" FontSize="13" Foreground="#B9C0CC" />

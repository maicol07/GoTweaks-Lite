                                                    <TextBlock x:Uid="GameDCProfileFPSLimitText" Grid.Column="2" x:Name="GameDCProfileFPSLimitText" Text="Off" FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFF" HorizontalAlignment="Center" />
                                                </Grid>
                                                <Border x:Name="GameACDCProfileFPSLimitSeparator" Height="1" Background="#22FFFFFF" Margin="0,8,0,0"/>
                                            </StackPanel>

                                            <!-- Power Mode Row -->
                                            <StackPanel x:Name="GameACDCProfilePowerModeRow" Visibility="Collapsed">
                                                <Grid Margin="0,8,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="84"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock x:Uid="S_PowerMode" Grid.Column="0" Text="Power Mode" FontSize="13" Foreground="#B9C0CC" />

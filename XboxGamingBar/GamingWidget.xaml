                                                <ComboBoxItem x:Uid="S_RightStick_2" Content="Right Stick" Tag="0" />
                                                <ComboBoxItem x:Uid="S_LeftStick_2" Content="Left Stick" Tag="1" />
                                                <ComboBoxItem x:Uid="S_DPadUpDown" Content="D-Pad (Up/Down)" Tag="2" />
                                            </ComboBox>
                                        </Grid>

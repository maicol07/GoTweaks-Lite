                                                    <TextBlock x:Uid="GameDCProfileCPUBoostText" Grid.Column="2" x:Name="GameDCProfileCPUBoostText" Text="Off" FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFF" HorizontalAlignment="Center" />

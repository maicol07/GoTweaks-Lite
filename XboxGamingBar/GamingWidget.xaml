" LargeChange="10" ValueChanged="ViiperStickGyroSmoothingSlider_ValueChanged"/></ctk:SettingsCard><ctk:SettingsCard ContentAlignment="Vertical" HorizontalContentAlignment="Stretch"><ctk:SettingsCard.Header><TextBlock TextWrapping="Wrap" x:Uid="S_VerticalSensitivityOfMaster" Text="Vertical sensitivity (% of master)" /></ctk:SettingsCard.Header><ctk:SettingsCard.Description><TextBlock TextWrapping="Wrap" x:Name="ViiperStickGyroVerticalRatioValueText" Text="100%"/></ctk:SettingsCard.Description><Slider x:Name="ViiperStickGyroVerticalRatioSlider" Minimum="10" Maximum="200" StepFrequency="5" SmallChange="5" LargeChange="25" ValueChanged="ViiperStickGyroVerticalRatioSlider_ValueChanged"/></ctk:SettingsCard><ctk:SettingsCard><ctk:SettingsCard.Header><TextBlock TextWrapping="Wrap" x:Uid="S_SensitivityCurve" Text="Sensitivity curve" /></ctk:SettingsCard.Header><ComboBox x:Name="ViiperStickGyroCurvePresetComboBox" Style="{StaticResource ModernComboBoxStyle}" Width="180" FontSize="13" SelectionChanged="ViiperStickGyroCurvePresetComboBox_SelectionChanged"> <ComboBoxItem x:Uid="S_LinearFlat" Content="Linear (flat)" Tag="0" /> <ComboBoxItem x:Uid="S_SlowPrecise" Content="Slow + Precise" Tag="1" /> <ComboBoxItem x:Uid="S_SnapAim" Content="Snap-aim" Tag="2" /> </ComboBox></ctk:SettingsCard><ctk:SettingsCard ContentAlignment="Vertical" HorizontalContentAlignment="Stretch"><ctk:SettingsCard.Header><TextBlock TextWrapping="Wrap" x:Uid="S_TightenThresholdS0Off" Text="Tighten threshold (°/s, 0 = off)" /></ctk:SettingsCard.Header><ctk:SettingsCard.Description><TextBlock TextWrapping="Wrap" x:Name="ViiperStickGyroTightenThresholdValueText" Text="0°/s"/></ctk:SettingsCard.Description><Slider x:Name="ViiperStickGyroTightenThresholdSlider" Minimum="0" Maximum="500" StepFrequency="10" SmallChange="10" LargeChange="50" ValueChanged="ViiperStickGyroTightenThresholdSlider_ValueChanged"/></ctk:SettingsCard><ctk:SettingsCard ContentAlignment="Vertical" HorizontalContentAlignment="Stretch"><ctk:SettingsCard.Header><TextBlock TextWrapping="Wrap" x:Uid="S_TightenGainAtFullRamp" Text="Tighten gain (× at full ramp)" /></ctk:SettingsCard.Header><ctk:SettingsCard.Description><TextBlock TextWrapping="Wrap" x:Name="ViiperStickGyroTightenGainValueText" Text="1.00×"/></ctk:SettingsCard.Description><Slider x:Name="ViiperStickGyroTightenGainSlider" Minimum="100" Maximum="300" StepFrequency="10" SmallChange="10" LargeChange="50" ValueChanged="ViiperStickGyroTightenGainSlider_ValueChanged"/></ctk:SettingsCard><ctk:SettingsCard x:Uid="S_StickTouchDeactivation" Header="Stick-touch deactivation" Description="Suppress gyro while you move the physical stick. Useful in shooters where stick = big turns, gyro = fine aim." Tapped="ToggleRow_Tapped">

                                                    <TextBlock x:Uid="GameACProfileOverlayLevelText" Grid.Column="1" x:Name="GameACProfileOverlayLevelText" Text="Off" FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFF" HorizontalAlignment="Center" />
                                                    <TextBlock x:Uid="GameDCProfileOverlayLevelText" Grid.Column="2" x:Name="GameDCProfileOverlayLevelText" Text="Off" FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFF" HorizontalAlignment="Center" />
                                                </Grid>
                                                <Border x:Name="GameACDCProfileOverlayLevelSeparator" Height="1" Background="#22FFFFFF" Margin="0,8,0,0"/>
